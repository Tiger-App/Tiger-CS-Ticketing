<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable, ImplicitUsings inherited from Directory.Build.props -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <!-- A real relational engine for the tests that must prove a database
         constraint (filtered unique index, FK restrict) is enforced — the
         InMemory provider enforces neither. Test-only. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TigerCS.Domain\TigerCS.Domain.csproj" />
    <ProjectReference Include="..\TigerCS.Application\TigerCS.Application.csproj" />
    <ProjectReference Include="..\TigerCS.Infrastructure\TigerCS.Infrastructure.csproj" />
    <ProjectReference Include="..\TigerCS.Integrations\TigerCS.Integrations.csproj" />
    <ProjectReference Include="..\TigerCS.Reporting\TigerCS.Reporting.csproj" />
    <ProjectReference Include="..\TigerCS.Api\TigerCS.Api.csproj" />
    <!-- The seeder's pure decision logic is compiled into the tests; referencing the exe project would clash on its top-level Program. -->
    <Compile Include="..\TigerCS.ProductionSeeder\SeedSafety.cs" Link="Deployment\SeedSafety.cs" />
    <Compile Include="..\TigerCS.ProductionSeeder\StaffProvisioningCommand.cs" Link="Deployment\StaffProvisioningCommand.cs" />
    <!-- Aliased: TigerCS.Web's own top-level-statement Program type would otherwise collide
         (both are implicitly in the global namespace) with TigerCS.Api's Program, which the
         existing WebApplicationFactory<Program>-based integration tests reference unqualified.
         Referenced as TigerCsWeb::Program by ApiClientConfigurationTests, which spins up
         TigerCS.Web's own host via WebApplicationFactory to verify its DI wiring. -->
    <ProjectReference Include="..\TigerCS.Web\TigerCS.Web.csproj">
      <Aliases>TigerCsWeb</Aliases>
    </ProjectReference>
  </ItemGroup>

</Project>
