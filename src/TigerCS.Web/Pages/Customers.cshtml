@page "/Customers"
@model TigerCS.Web.Pages.CustomersModel
@using TigerCS.Application.Modules.Ticketing.Dto
@using TigerCS.Domain.Modules.Ticketing
@{
    ViewData["Title"] = "Customers";
    ViewData["ActiveNav"] = "customers";
    Layout = "_Layout";
    var nowUtc = DateTime.UtcNow;
}

<div class="page customers-workspace">
    <div class="page-header">
        <div>
            <h1 class="page-title">Customers</h1>
            <p class="page-subtitle">Every customer TigerCS knows, from the tickets raised for them — CRM-verified, PACT/Tasleeh-verified and phone-only callers alike.</p>
        </div>
        <div class="page-header__actions">
            <a class="btn" href="@Model.LookupHref">Look up by phone</a>
            @if (Model.CanCreateTicket)
            {
                <a class="btn btn-gold" href="/NewTicket">+ New Ticket</a>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.EditStatus))
    {
        <div class="alert alert-success" role="status"><span>@Model.EditStatus</span></div>
    }
    @if (!string.IsNullOrEmpty(Model.EditError))
    {
        <div class="alert alert-error" role="alert"><span>@Model.EditError</span></div>
    }

    <form class="filter-bar" id="customerFilters" method="get" action="/Customers">
        <div class="search-field filter-bar__search">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" /><path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            <input type="search" name="search" value="@Model.Search" placeholder="Search by name, phone, unit, project or ticket number…" aria-label="Search customers" />
        </div>

        <div class="field-group">
            <label class="field-label" for="verificationSource">Verification source</label>
            <select class="field-select" id="verificationSource" name="verificationSource" data-autosubmit>
                <option value="">All sources</option>
                @foreach (var (value, label) in CustomersModel.SourceOptions)
                {
                    <option value="@value" selected="@(Model.VerificationSource == value)">@label</option>
                }
            </select>
        </div>

        @if (Model.NameResolver.OwnDepartments.Count > 0)
        {
            <div class="field-group">
                <label class="field-label" for="departmentId">Department</label>
                <select class="field-select" id="departmentId" name="departmentId" data-autosubmit>
                    <option value="">All my departments</option>
                    @foreach (var d in Model.NameResolver.OwnDepartments)
                    {
                        <option value="@d.DepartmentId" selected="@(Model.DepartmentId == d.DepartmentId)">@d.Name</option>
                    }
                </select>
            </div>
        }

        @* Opened from the Dashboard's Customers by Location card: keep its location and filters through Apply, and say what the list is. *@
        @foreach (var (name, value) in Model.DashboardQuery())
        {
            <input type="hidden" name="@name" value="@value" />
        }

        <label class="field-check">
            <input type="checkbox" name="openOnly" value="true" checked="@Model.OpenOnly" data-autosubmit />
            With open tickets
        </label>

        <div class="filter-bar__submit">
            <button type="submit" class="btn btn-sm">Apply</button>
            <a class="btn btn-ghost btn-sm" href="/Customers">Clear</a>
        </div>
    </form>

    @if (Model.LocationLabel is { } locationLabel)
    {
        <p class="customers-scope" data-customers-scope="@CustomerLocationKeys.ToKey(Model.Location)">
            <span class="customers-scope__chip customers-scope__chip--@(Model.Location == CustomerLocation.WithinUae ? "uae" : Model.Location == CustomerLocation.OutsideUae ? "intl" : "unknown")">@locationLabel</span>
            @if (Model.DashboardPeriodLabel is { } periodLabel)
            {
                <span class="text-secondary">Customers with tickets created @periodLabel, from the Dashboard's Customers by Location.</span>
            }
            <a class="link-muted" href="/Customers">Show all customers</a>
        </p>
    }

    @if (Model.UnknownBreakdown is { Total: > 0 } breakdown)
    {
        <div class="panel" data-unknown-breakdown>
            <div class="panel__header"><span class="panel__title">Why @breakdown.Total customers are Unknown</span></div>
            <ul class="stack-list">
                @foreach (var reason in breakdown.Reasons)
                {
                    <li data-unknown-reason="@reason.Reason"><strong>@reason.Count</strong> — @reason.Text</li>
                }
            </ul>
            <p class="text-secondary">Numbers are shown exactly as stored; none is rewritten and none is assumed to be UAE.@(breakdown.Truncated ? " Showing the first " + breakdown.Total + "." : "")</p>
        </div>
    }

    <div class="panel">
        <div class="panel__header">
            <span class="panel__title">Customers</span>
            @* A count only when the list actually loaded: after a failed Api read TotalCount is just the default 0, and printing it would claim nobody matches. *@
            @if (Model.Outcome == ApiOutcome.Success)
            {
                <span class="text-secondary" data-customers-count="@Model.TotalCount">@Model.TotalCount @(Model.TotalCount == 1 ? "customer" : "customers")@(Model.HasFilters ? " match" : "")</span>
            }
        </div>

        @if (Model.Outcome == ApiOutcome.Unauthorized)
        {
            <div class="error-state">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
                <p>Your session is no longer valid. <a class="link-muted" href="/Logout">Sign in again</a>.</p>
            </div>
        }
        else if (Model.Outcome == ApiOutcome.Forbidden)
        {
            <div class="error-state">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
                <p>Your role does not have access to the customer directory.</p>
            </div>
        }
        else if (Model.Outcome != ApiOutcome.Success)
        {
            <div class="error-state">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
                <p>Tiger Ticketing System could not load the customer directory. Try again in a moment.</p>
            </div>
        }
        else if (Model.Rows.Count == 0 && Model.HasFilters)
        {
            <div class="empty-state">
                <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" /><path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                <p class="empty-state__title">No customers match these filters.</p>
                <p>A customer with no ticket yet is not in the directory — look them up in Tiger CRM, PACT or Tasleeh by phone.</p>
                <div class="empty-state__actions">
                    <a class="btn btn-sm" href="/Customers">Clear filters</a>
                    <a class="btn btn-sm btn-gold" href="@Model.LookupHref">Look up by phone</a>
                </div>
            </div>
        }
        else if (Model.Rows.Count == 0)
        {
            <div class="empty-state">
                <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8" /><path d="M4 20c1.8-3.2 4.5-5 8-5s6.2 1.8 8 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                <p class="empty-state__title">No customers yet.</p>
                <p>Customers appear here as tickets are raised for them.</p>
                @if (Model.CanCreateTicket)
                {
                    <a class="btn btn-sm btn-gold" href="/NewTicket">+ New Ticket</a>
                }
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table data-table--clickable">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Phone</th>
                            <th>Project / Unit</th>
                            <th>Verification Source</th>
                            <th class="col-num">Open Tickets</th>
                            <th class="col-num">Total Tickets</th>
                            <th>Last Ticket</th>
                            <th>Last Interaction</th>
                            @if (Model.CanEdit)
                            {
                                <th class="col-actions"><span class="visually-hidden">Actions</span></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var href = CustomersModel.ProfileHref(row.CustomerKey);
                            <tr class="is-link" data-href="@href">
                                <td>
                                    <a class="customer-link" href="@href">
                                        <span class="customer-link__avatar" aria-hidden="true">@TicketDisplay.Initials(CustomersModel.NameOrPlaceholder(row))</span>
                                        <span>
                                            <span class="cell-primary">@CustomersModel.NameOrPlaceholder(row)</span>
                                            <span class="cell-sub">@(row.IdentityKind == "Crm" ? $"CRM #{row.CustomerKey[4..]}" : row.IdentityKind == "External" ? $"{CustomersModel.SourceLabel(row.VerificationSource)} ID" : "Identified by phone")</span>
                                        </span>
                                    </a>
                                </td>
                                @* A source's placeholder (NOT_REGISTERED...) is missing data: it is shown as "Not provided", never printed. An edited value is marked, so staff can tell it differs from the tickets. *@
                                <td class="text-mono">
                                    @if (string.IsNullOrWhiteSpace(row.PhoneNumber))
                                    {
                                        <span class="text-secondary">@CustomerFieldText.NotProvided</span>
                                    }
                                    else
                                    {
                                        @row.PhoneNumber
                                        @if (row.EditedFields?.Contains("PhoneNumber") == true) { <span class="badge badge-neutral" title="Edited in Tiger Ticketing">Edited</span> }
                                    }
                                    @if (row.LocationReasonText is { } reasonText)
                                    {
                                        <span class="cell-sub" data-unknown-row-reason="@row.LocationReason">
                                            Stored: @(string.IsNullOrWhiteSpace(row.LocationPhone) ? "(none)" : row.LocationPhone)@(row.LocationOtherPhone is { } other ? " / " + other : "") — @reasonText
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (row.ProjectName is null && row.UnitNumber is null)
                                    {
                                        <span class="text-secondary">@CustomerFieldText.NotProvided</span>
                                    }
                                    else
                                    {
                                        <span class="cell-primary">@(row.UnitNumber ?? CustomerFieldText.NotProvided)</span>
                                        <span class="cell-sub">@(row.ProjectName ?? CustomerFieldText.NotProvided)
                                            @if (row.EditedFields?.Contains("ProjectName") == true || row.EditedFields?.Contains("UnitNumber") == true) { <span class="badge badge-neutral" title="Edited in Tiger Ticketing">Edited</span> }
                                        </span>
                                    }
                                </td>
                                <td><span class="badge badge-source-@CustomersModel.SourceCssKey(row.VerificationSource)">@CustomersModel.SourceLabel(row.VerificationSource)</span></td>
                                <td class="col-num"><span class="@(row.OpenTickets > 0 ? "count-pill count-pill--attention" : "count-pill")">@row.OpenTickets</span></td>
                                <td class="col-num"><span class="count-pill">@row.TotalTickets</span></td>
                                <td>
                                    <a class="ticket-id-link" href="/Tickets/@row.LastTicketId">@row.LastTicketNumber</a>
                                    <span class="cell-sub">@TicketDisplay.TicketStatusLabel(row.LastTicketStatus) · @row.LastTicketCreatedAtUtc.ToUae().ToString("MMM d, yyyy")</span>
                                </td>
                                <td class="text-secondary" title="@(row.LastInteractionAtUtc?.ToUae().ToString("MMM d, yyyy HH:mm"))">
                                    @(row.LastInteractionAtUtc is { } lastInteraction ? TicketDisplay.AgoLabel(lastInteraction, nowUtc) : "—")
                                </td>
                                @if (Model.CanEdit)
                                {
                                    <td class="col-actions">
                                        <button type="button" class="btn btn-sm" data-customer-edit aria-haspopup="dialog"
                                                data-key="@row.CustomerKey" data-name="@CustomersModel.NameOrPlaceholder(row)"
                                                data-phone="@row.PhoneNumber" data-project="@row.ProjectName" data-unit="@row.UnitNumber">Edit</button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="panel__footer">
            <span class="pager-range">@(Model.TotalCount == 0 ? "No records" : $"Showing {(Model.PageNumber - 1) * Model.PageSize + 1}–{Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)} of {Model.TotalCount}") <span class="pager-page">· Page @Model.PageNumber of @Model.TotalPages</span></span>
            <nav class="pagination" aria-label="Pagination">
                @if (Model.PageNumber > 1)
                {
                    <a href="@Model.PageUrl(Model.PageNumber - 1)">Prev</a>
                }
                else
                {
                    <span class="is-disabled">Prev</span>
                }
                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a href="@Model.PageUrl(Model.PageNumber + 1)">Next</a>
                }
                else
                {
                    <span class="is-disabled">Next</span>
                }
            </nav>
        </div>
    </div>

    @if (Model.CanEdit)
    {
        @* One compact modal (a native <dialog>: focus trap, Escape, dimmed backdrop) shared by every row; the Edit button fills it from the row. The post is
           the Edit handler, which forwards to the Api - the Api decides who may edit, normalizes the phone, checks project and unit, and audits. *@
        <dialog class="reassign-modal" id="customer-edit-dialog" data-customer-edit-dialog aria-labelledby="customer-edit-title" data-reopen="@Model.EditReopenJson">
            <form method="post" asp-page-handler="Edit" class="reassign-modal__form" novalidate>
                <input type="hidden" name="customerKey" data-edit-key />
                <input type="hidden" name="returnUrl" value="@Model.CurrentUrl" />
                <div class="reassign-modal__head">
                    <h2 class="reassign-modal__title" id="customer-edit-title">Edit customer</h2>
                    <button type="button" class="reassign-modal__close" data-edit-cancel aria-label="Close">&times;</button>
                </div>
                <div class="reassign-modal__body">
                    <p class="field-hint" data-edit-name></p>
                    <div class="field-group">
                        <label class="field-label" for="customer-edit-phone">Phone number</label>
                        <input class="field-input" id="customer-edit-phone" name="phoneNumber" type="tel" autocomplete="off" placeholder="+971 50 123 4567" data-edit-phone />
                        <span class="field-hint">With its country code, e.g. +971 50 123 4567. Leave blank to use the number on the customer's tickets.</span>
                    </div>
                    <div class="field-group">
                        <label class="field-label" for="customer-edit-project">Project</label>
                        <input class="field-input" id="customer-edit-project" name="projectName" list="customer-edit-projects" autocomplete="off" data-edit-project />
                        <datalist id="customer-edit-projects">
                            @foreach (var project in Model.ProjectOptions)
                            {
                                <option value="@project"></option>
                            }
                        </datalist>
                    </div>
                    <div class="field-group">
                        <label class="field-label" for="customer-edit-unit">Unit</label>
                        <input class="field-input" id="customer-edit-unit" name="unitNumber" autocomplete="off" data-edit-unit />
                        <span class="field-hint">Enter project and unit together, or clear both to use the tickets' own.</span>
                    </div>
                    <p class="field-hint">Saved in Tiger Ticketing only. Nothing is sent to Tiger CRM, PACT or Tasleeh, and no ticket changes.</p>
                </div>
                <div class="reassign-modal__foot">
                    <button type="button" class="btn-reassign-cancel" data-edit-cancel>Cancel</button>
                    <button type="submit" class="btn-reassign">Save</button>
                </div>
            </form>
        </dialog>
        <script src="~/js/customer-edit.js" asp-append-version="true"></script>
    }
</div>
