@page "/Dashboard"
@using System.Globalization
@model TigerCS.Web.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveNav"] = "dashboard";
    Layout = "_Layout";
    var nowUtc = DateTime.UtcNow;
    var options = Model.Overview?.FilterOptions;
    string DateValue(DateOnly? d) => d?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;

    // The card's semantic tone, keyed on its label — decoration only, like
    // the glyph below: the number, label and drill-down link come from the
    // model. Open work is information, the department queue is operational,
    // a breach is critical, a deadline today is a warning, approvals are
    // the one card that asks the viewer to act and so carry the brand gold.
    string KpiTone(string label) => label switch
    {
        "Open Tickets" => "info",
        "My Tickets" => "secondary",
        "In Department Queue" => "progress",
        "SLA Breached" => "critical",
        "Due Today" => "warning",
        "Pending Approval" => "brand",
        "Reviewed Tickets" => "success",
        "Not Reviewed" => "warning",
        "Closed by AI" => "secondary",
        "Closed by Agent" => "progress",
        _ => "info",
    };

    // The stylesheet's per-card colour key, matched on the label — decoration
    // only, like the tone and glyph; the number, label and link come from the model.
    string KpiKey(string label) => label switch
    {
        "Open Tickets" => "open",
        "My Tickets" => "mine",
        "In Department Queue" => "queue",
        "SLA Breached" => "sla",
        "Due Today" => "due",
        "Pending Approval" => "approval",
        "Reviewed Tickets" => "reviewed",
        "Not Reviewed" => "notreviewed",
        "Closed by AI" => "ai",
        "Closed by Agent" => "agent",
        _ => "other",
    };

    // A small leading glyph per KPI, keyed on the card's label — decoration
    // only; the number, label and drill-down link come from the model.
    string KpiIcon(string label) => label switch
    {
        "My Tickets" => "<circle cx=\"12\" cy=\"8\" r=\"4\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M4 20c1.8-3.2 4.5-5 8-5s6.2 1.8 8 5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>",
        "In Department Queue" => "<path d=\"M4 6h16M4 12h16M4 18h10\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>",
        "SLA Breached" => "<path d=\"M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z\" stroke=\"currentColor\" stroke-width=\"1.6\"/>",
        "Due Today" => "<circle cx=\"12\" cy=\"12\" r=\"9\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M12 7v5l3 2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>",
        "Pending Approval" => "<path d=\"M9 12l2 2 4-4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"3\" stroke=\"currentColor\" stroke-width=\"1.8\"/>",
        "Reviewed Tickets" => "<path d=\"M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9 6.8 19.6l1-5.8-4.3-4.1 5.9-.9L12 3.5Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\"/>",
        "Not Reviewed" => "<path d=\"M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9 6.8 19.6l1-5.8-4.3-4.1 5.9-.9L12 3.5Z\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\" stroke-dasharray=\"2.4 2.4\"/>",
        "Closed by AI" => "<rect x=\"5\" y=\"8\" width=\"14\" height=\"10\" rx=\"3\" stroke=\"currentColor\" stroke-width=\"1.7\"/><path d=\"M12 8V4.5M9.5 12.5h.01M14.5 12.5h.01M9.5 15.5h5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\"/>",
        "Closed by Agent" => "<circle cx=\"12\" cy=\"8\" r=\"4\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M4 20c1.8-3.2 4.5-5 8-5s6.2 1.8 8 5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><path d=\"M15.5 17.5l1.6 1.6 3-3\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>",
        _ => "<rect x=\"5\" y=\"4\" width=\"14\" height=\"16\" rx=\"1.5\" stroke=\"currentColor\" stroke-width=\"1.6\"/><path d=\"M9 9h6M9 13h6M9 17h3\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>",
    };

    // The four views of the Tickets workspace — the same links the nav used
    // to carry, now one row of shortcuts that land on the matching tab.
    // Each view keeps the tone it has everywhere else: the queue is general
    // information, pending interactions are the secondary operational pile,
    // your own work is in progress, closed work is resolved.
    (string Label, string Hint, string Href, string Tone, string Icon)[] shortcuts =
    [
        ("Queue", "Every ticket in your departments", TicketsView.Queue.Href(), "info", "<path d=\"M4 6h16M4 12h16M4 18h10\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>"),
        ("Pending Interactions", "Customers waiting for a human agent", TicketsView.Pending.Href(), "secondary", "<path d=\"M21 12a8 8 0 0 1-11.6 7.1L4 20l1-5.1A8 8 0 1 1 21 12Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>"),
        ("My Tickets", "Assigned to you", TicketsView.My.Href(), "progress", "<circle cx=\"12\" cy=\"8\" r=\"4\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M4 20c1.8-3.2 4.5-5 8-5s6.2 1.8 8 5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>"),
        ("Closed", "Recently closed work", TicketsView.Closed.Href(), "success", "<path d=\"M5 13l4 4L19 7\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>"),
    ];

    var activeFilterCount = new object?[] { Model.DepartmentId, Model.OwnerEmployeeId, Model.ChannelId, Model.RequestTypeId, Model.TicketStatus, Model.PriorityId, Model.DateFrom, Model.DateTo }
        .Count(v => v is not null && !(v is string str && string.IsNullOrWhiteSpace(str)));
}

<div class="page dashboard-workspace">
    @{ var hf = Model.Overview?.Filters; }
    <div class="page-header dash-head">
        <div class="dash-head__title">
            <h1 class="page-title">Dashboard</h1>
            @if (Model.Overview is not null)
            {
                <p class="page-subtitle">Volume for @Model.PeriodLabel · KPIs and backlog reflect the current open work in your scope.</p>
            }
        </div>
        <div class="page-header__actions dash-head__actions">
            @if (hf is not null)
            {
                @* The period pickers live in the header but belong to the filter form below (form="dashboardFilters"), so Apply submits them together with every other filter. *@
                <div class="dash-range" role="group" aria-label="Date range">
                    <input class="field-input" type="date" id="dateFrom" name="dateFrom" form="dashboardFilters" aria-label="Date from" value="@DateValue(Model.DateFrom ?? hf.DateFrom)" />
                    <span class="dash-range__sep" aria-hidden="true">–</span>
                    <input class="field-input" type="date" id="dateTo" name="dateTo" form="dashboardFilters" aria-label="Date to" value="@DateValue(Model.DateTo ?? hf.DateTo)" />
                    <button type="submit" form="dashboardFilters" class="btn btn-sm">Apply</button>
                </div>
            }
            <a class="btn" href="/Tickets">Open Tickets workspace</a>
            <a class="btn btn-gold" href="/NewTicket">+ New Ticket</a>
        </div>
    </div>

    <section class="dash-hero" aria-label="Quick actions">
        @* Quick action: the existing customer-first flow — the Customers directory searches name, phone, unit or ticket number; the cross-source phone lookup is one click further. Unchanged in behaviour. *@
        <div class="workspace-search">
            <form action="/Customers" method="get" class="workspace-search__form" role="search" title="See the customer's units, open tickets and history first — then open, reopen or create a ticket.">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" /><path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                <input type="search" name="phoneNumber" class="workspace-search__input"
                       placeholder="Find a customer by phone, name, unit or ticket number…" aria-label="Search customers" required />
                <button type="submit" class="btn btn-gold">Search Customer</button>
                <a class="btn btn-sm workspace-search__lookup" href="/Customers/Lookup">Look up in CRM / PACT / Tasleeh →</a>
            </form>
        </div>

        <nav class="dash-shortcuts" aria-label="Tickets workspace">
            @foreach (var (label, hint, href, tone, icon) in shortcuts)
            {
                <a class="dash-shortcut tone-@tone" href="@href">
                    <span class="dash-shortcut__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none">@Html.Raw(icon)</svg></span>
                    <span>
                        <span class="dash-shortcut__title">@label</span>
                        <span class="dash-shortcut__hint">@hint</span>
                    </span>
                </a>
            }
        </nav>
    </section>

    @if (Model.Overview is null)
    {
        <div class="panel">
            <div class="error-state">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
                <p>
                    @(Model.Outcome switch
                    {
                        ApiOutcome.Unauthorized => "Your session is no longer valid. Sign in again.",
                        ApiOutcome.Unreachable or ApiOutcome.BadGateway => "Tiger Ticketing System could not reach the ticketing service.",
                        _ => "The dashboard could not be loaded right now."
                    })
                </p>
            </div>
        </div>
    }
    else
    {
        var f = Model.Overview.Filters;

        @* ---- KPI panel: the six primary counters (current open work in scope) above the four secondary closure counters; every card drills into the ticket queue. ---- *@
        <div class="dash-kpi-panel">
        <section class="kpi-grid kpi-grid--six" aria-label="Operational counters">
            @foreach (var card in Model.Cards)
            {
                <a class="kpi-card kpi-card--icon tone-@KpiTone(card.Label) @(card.Emphasis is not null ? $"kpi-card--{card.Emphasis}" : "")" href="@card.Href" data-kpi="@KpiKey(card.Label)" title="@card.Hint">
                    <span class="kpi-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none">@Html.Raw(KpiIcon(card.Label))</svg></span>
                    <span class="kpi-card__body">
                        <strong>@card.Value</strong>
                        <span>@card.Label</span>
                    </span>
                </a>
            }
        </section>

        @* ---- Closure KPIs: Closed tickets by latest closure date in the date range, split by customer feedback and by who closed them; same card, same drill-down. ---- *@
        <div class="dash-kpi-secondary">
        <span class="dash-kpi-secondary__caption">Closed in period</span>
        <section class="kpi-grid kpi-grid--four" aria-label="Closed ticket counters">
            @foreach (var card in Model.ClosureCards)
            {
                <a class="kpi-card kpi-card--icon tone-@KpiTone(card.Label)" href="@card.Href" data-kpi="@KpiKey(card.Label)" title="@card.Hint">
                    <span class="kpi-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none">@Html.Raw(KpiIcon(card.Label))</svg></span>
                    <span class="kpi-card__body">
                        <strong>@card.Value</strong>
                        <span>@card.Label</span>
                        @if (card.Detail is not null)
                        {
                            <span class="kpi-card__detail" data-kpi-detail>@card.Detail</span>
                        }
                    </span>
                </a>
            }
        </section>
        </div>
        </div>

        @* ---- Filters: a real GET form over the master data the Api returned for this caller's scope, folded behind a disclosure. ---- *@
        <details class="filter-disclosure" open="@(activeFilterCount > 0 ? "open" : null)">
            <summary>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                Filters
                @if (activeFilterCount > 0)
                {
                    <span class="filter-disclosure__count">@activeFilterCount</span>
                }
            </summary>
            <form class="filter-bar dash-filters" id="dashboardFilters" method="get" action="/Dashboard" aria-label="Dashboard filters">
                <div class="field-group">
                    <label class="field-label" for="departmentId">Department</label>
                    <select class="field-select" id="departmentId" name="departmentId" data-autosubmit>
                        <option value="">All my departments</option>
                        @foreach (var d in options!.Departments)
                        {
                            <option value="@d.Id" selected="@(Model.DepartmentId?.ToString(CultureInfo.InvariantCulture) == d.Id)">@d.Label</option>
                        }
                    </select>
                </div>
                <div class="field-group">
                    <label class="field-label" for="ownerEmployeeId">Agent</label>
                    <select class="field-select" id="ownerEmployeeId" name="ownerEmployeeId">
                        <option value="">All agents</option>
                        @foreach (var a in options.Agents)
                        {
                            <option value="@a.Id" selected="@(Model.OwnerEmployeeId?.ToString() == a.Id)">@a.Label</option>
                        }
                    </select>
                </div>
                <div class="field-group">
                    <label class="field-label" for="channelId">Channel</label>
                    <select class="field-select" id="channelId" name="channelId">
                        <option value="">All channels</option>
                        @foreach (var c in options.Channels)
                        {
                            <option value="@c.Id" selected="@(Model.ChannelId?.ToString(CultureInfo.InvariantCulture) == c.Id)">@c.Label@(c.IsActive ? "" : " (inactive)")</option>
                        }
                    </select>
                </div>
                <div class="field-group">
                    <label class="field-label" for="requestTypeId">Request type</label>
                    <select class="field-select" id="requestTypeId" name="requestTypeId">
                        <option value="">All request types</option>
                        @foreach (var group in options.RequestTypes.GroupBy(r => r.GroupId))
                        {
                            <optgroup label="@Model.DepartmentLabel(group.Key)">
                                @foreach (var r in group)
                                {
                                    <option value="@r.Id" selected="@(Model.RequestTypeId?.ToString(CultureInfo.InvariantCulture) == r.Id)">@r.Label</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>
                <div class="field-group">
                    <label class="field-label" for="ticketStatus">Status</label>
                    <select class="field-select" id="ticketStatus" name="ticketStatus">
                        <option value="">All statuses</option>
                        @foreach (var s in options.Statuses)
                        {
                            <option value="@s.Id" selected="@(string.Equals(Model.TicketStatus, s.Id, StringComparison.OrdinalIgnoreCase))">@TicketDisplay.TicketStatusLabel(s.Id)</option>
                        }
                    </select>
                </div>
                <div class="field-group">
                    <label class="field-label" for="priorityId">Priority</label>
                    <select class="field-select" id="priorityId" name="priorityId">
                        <option value="">All priorities</option>
                        @foreach (var p in options.Priorities)
                        {
                            <option value="@p.Id" selected="@(Model.PriorityId?.ToString(CultureInfo.InvariantCulture) == p.Id)">@p.Label</option>
                        }
                    </select>
                </div>
                <div class="filter-bar__submit">
                    <button type="submit" class="btn btn-sm">Apply</button>
                    <a class="btn btn-ghost btn-sm" href="/Dashboard">Clear</a>
                </div>
            </form>
        </details>

        // Status and Volume by Channel are the compact visual summaries above
        // the attention table; the other four breakdowns form the grid below it.
        // Titles come from the model; nothing is re-computed.
        var sideTitles = new[] { "Status", "Volume by Channel" };
        var gridTitles = new[] { "Volume by Request Type", "Open Backlog Ageing", "Priority", "Volume by Department" };
        var sideCards = sideTitles.Select(t => Model.BreakdownCards.FirstOrDefault(c => c.Title == t)).OfType<DashboardBarCard>().ToList();
        var gridCards = gridTitles.Select(t => Model.BreakdownCards.FirstOrDefault(c => c.Title == t)).OfType<DashboardBarCard>()
            .Concat(Model.BreakdownCards.Where(c => !sideTitles.Contains(c.Title) && !gridTitles.Contains(c.Title))).ToList();

        <section class="dash-main" aria-label="Status and channel summaries">
            <div class="dash-side">
                @foreach (var card in sideCards)
                {
                    @await Html.PartialAsync("_DashboardSummaryCard", card)
                }
            </div>
        </section>

        @* ---- Request types, backlog ageing, priority and department volume: a balanced, content-height grid. ---- *@
        <section class="dash-grid" aria-label="Operational breakdown">
            @foreach (var card in gridCards)
            {
                @await Html.PartialAsync("_DashboardBarCard", card)
            }
        </section>

        @* ---- Tickets requiring attention: full width, last on the page, after all the analytics. ---- *@
        <section class="dash-attention-section" aria-label="Tickets requiring attention">
            @* The 5 newest active tickets in scope (CreatedAt DESC, sorted server-side). ---- *@
            <div class="panel panel--compact dash-attention">
                <div class="panel__header">
                    <div class="panel__lead">
                        <span class="panel__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                        <span class="panel__title">Tickets Requiring Attention</span>
                    </div>
                    <a class="link-muted" href="@DashboardLinks.ViewAll(f)">View all</a>
                </div>
                @if (Model.Overview.RecentTickets.Count == 0)
                {
                    <div class="empty-state">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        <p class="empty-state__title">All clear.</p>
                        <p>No open tickets need attention in the current scope.</p>
                    </div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table data-table--clickable data-table--compact">
                            <thead>
                                <tr>
                                    <th scope="col">Ticket</th>
                                    <th scope="col">Department</th>
                                    <th scope="col">Channel</th>
                                    <th scope="col">Last Action By</th>
                                    <th scope="col">Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ticket in Model.Overview.RecentTickets)
                                {
                                    var deptName = TicketDisplay.AssignedDepartmentLabel(ticket.CurrentDepartmentId, ticket.DepartmentName);
                                    var created = ticket.CreatedAtUtc.ToLocalTime();
                                    <tr class="is-link" data-href="/Tickets/@ticket.TicketId">
                                        <td><a class="ticket-id-link" href="/Tickets/@ticket.TicketId">@ticket.TicketNumber</a></td>
                                        <td>
                                            <span class="dept-cell">
                                                <span class="dept-cell__name">@deptName</span>
                                            </span>
                                        </td>
                                        <td>
                                            @if (ticket.ChannelName is { } channelName)
                                            {
                                                @* The channel of the ticket's originating interaction; icon and colour are the ones the Volume by Channel card uses. *@
                                                <span class="channel-cell @DashboardChannelStyle.ColorClass(ticket.ChannelId?.ToString(CultureInfo.InvariantCulture))">
                                                    <span class="channel-icon channel-icon--sm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none">@Html.Raw(DashboardChannelStyle.Icon(ticket.ChannelCode))</svg></span>
                                                    <span class="channel-cell__name">@channelName</span>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-secondary">—</span>
                                            }
                                        </td>
                                        <td class="dash-last-action">@(string.IsNullOrWhiteSpace(ticket.LastActionByName) ? "—" : ticket.LastActionByName)</td>
                                        <td class="text-secondary text-mono" title="@created.ToString("yyyy-MM-dd HH:mm")">@(created.Date == DateTime.Now.Date ? created.ToString("HH:mm") : created.ToString("MMM d, HH:mm"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>

    }
</div>
