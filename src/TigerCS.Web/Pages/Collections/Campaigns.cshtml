@page "/Collections/Campaigns"
@model TigerCS.Web.Pages.Collections.CampaignsModel
@using TigerCS.Web.Pages.Collections
@using TigerCS.Web.Services.Api
@{
    ViewData["Title"] = "Collections Campaigns";
    ViewData["ActiveNav"] = "collections";
    Layout = "_Layout";
    Func<TigerCS.Domain.Modules.Collections.CollectionsCampaignStage, string> stageName = TigerCS.Domain.Modules.Collections.Review.CampaignReminderTypes.StageName;
}
<link rel="stylesheet" href="~/css/collections-campaigns.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/collections-tower-multi.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/collections-snapshot.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/collections-review.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/info-tip.css" asp-append-version="true" />
<div class="page receivables-workspace">
    <div class="page-header">
        <div>
            <p class="receivables-eyebrow">Collections</p>
            <h1 class="page-title">Collections Campaigns</h1>
        </div>
        <div class="page-header__actions"><a class="btn" href="/Collections/Receivables">Due &amp; Overdue Customers</a><a class="btn" href="/Collections/CampaignList" data-history-link>Campaign List</a></div>
    </div>
    <partial name="_CampaignApproval" model="Model" />
@{
    Func<object?, Microsoft.AspNetCore.Html.IHtmlContent> dateGroup = @<div class="field-group" data-date-group hidden="@Model.IsManual">
        <label class="field-label" for="campaignDate" data-date-label>Preview date</label>
        <input class="field-input" id="campaignDate" name="businessDate" type="date" data-campaign-date disabled="@Model.IsManual" min="2000-01-01" max="2100-12-31" value="@Model.BusinessDate?.ToString("yyyy-MM-dd")" />
    </div>;
    const string modeTip = "Manual: choose any campaign type and send it to Genesys at any time. There is no send date and no schedule; the amount sent follows your Payment status, dates and Minimum Total, you pick the customers and the existing contact list, and nothing is sent until you confirm. Auto: follows the approved campaign policy; on a scheduled date the automatic dispatcher prepares and sends the eligible campaign by itself, but only while automatic execution is switched on (a separate setting, off by default). In both modes reconciliation, permissions, contact checks, legal restrictions, suppression, duplicate-send and contact-frequency protection apply.";
}
    @* Filter first: choosing filters never queries the campaign list. Customers load only when Preview Customers is clicked; changing a filter afterwards clears them again.
       One compact control bar: stage, Manual / Auto, the send date (Manual) or the policy schedule label (Auto), Project / Tower and Preview Customers. Everything else is under More filters. *@
    <form id="campaignFilters" class="campaign-filters panel" method="get" action="/Collections/Campaigns" data-receivables-filter data-results-form data-campaign-filters>
        <div class="campaign-filters__main">
            <div class="field-group">
                <label class="field-label" for="campaignStage" data-label-auto="Campaign stage" data-label-manual="Campaign type">@(Model.IsManual ? "Campaign type" : "Campaign stage")</label>
                <select class="field-select" id="campaignStage" name="stage" data-campaign-stage>
                    @foreach (var (value, stage) in new[] {
                        ("OverdueReminder", TigerCS.Domain.Modules.Collections.CollectionsCampaignStage.OverdueReminder), ("CurrentMonthReminder", TigerCS.Domain.Modules.Collections.CollectionsCampaignStage.CurrentMonthReminder),
                        ("FollowUpReminder", TigerCS.Domain.Modules.Collections.CollectionsCampaignStage.FollowUpReminder), ("LegalNotice", TigerCS.Domain.Modules.Collections.CollectionsCampaignStage.LegalNotice),
                        ("LegalReferral", TigerCS.Domain.Modules.Collections.CollectionsCampaignStage.LegalReferral) })
                    {
                        <option value="@value" selected="@(Model.Stage.Equals(value, StringComparison.OrdinalIgnoreCase))">@stageName(stage)</option>
                    }
                </select>
            </div>
            <div class="field-group campaign-mode">
                <span class="field-label" id="campaignModeLabel">Sending mode<partial name="_InfoTip" model="@(new InfoTipModel("tip-sending-mode", "Sending mode", modeTip))" /></span>
                <div class="segmented" role="radiogroup" aria-labelledby="campaignModeLabel" data-sending-mode>
                    <label class="segmented__option"><input type="radio" name="sendingMode" value="Manual" checked="@Model.IsManual" /><span>Manual</span></label>
                    <label class="segmented__option"><input type="radio" name="sendingMode" value="Auto" checked="@(!Model.IsManual)" /><span>Auto</span></label>
                </div>
            </div>
            @* Auto: the Preview date stays under More filters and this cell shows the policy schedule as a small label. Manual has no date at all. *@
            <div class="campaign-date-slot" data-date-slot>
                <span class="campaign-schedule" data-mode-hint="Auto" data-policy-schedule hidden="@Model.IsManual">@Model.PolicyScheduleLabel()</span>
            </div>
            <partial name="_TowerMultiPicker" model="@(new TowerMultiPickerModel("campaignTower", Model.Towers, Model.TowerIds, Model.TowersFailed))" />
            <div class="campaign-filters__actions">
                <button class="btn btn-primary" type="submit" name="render" value="full" data-preview-button>Preview Customers</button>
            </div>
        </div>
        <div class="campaign-filters__footer">
            <details class="campaign-advanced" open="@Model.AdvancedOpen" data-advanced-filters>
                <summary>More filters</summary>
                <div class="campaign-advanced__grid">
                    <div class="field-group">
                        <label class="field-label" for="campaignPayment">Payment status</label>
                        <select class="field-select" id="campaignPayment" name="paymentStatus" data-payment-status>
                            @foreach (var choice in CampaignsModel.PaymentStatusChoices) { <option value="@choice" selected="@(Model.PaymentStatus.Equals(choice, StringComparison.OrdinalIgnoreCase))">@(choice == "Both" ? "Due and Overdue (both)" : choice)</option> }
                        </select>
                    </div>
                    @* Period only fills the From / To dates (it has no name, so it is never sent): the dates stay the single source of the range. *@
                    <div class="field-group" data-mode-not="Manual" hidden="@Model.IsManual">
                        <label class="field-label" for="campaignPeriod">Period</label>
                        <select class="field-select" id="campaignPeriod" data-period data-today="@CollectionsDisplay.DubaiToday().ToString("yyyy-MM-dd")">
                            <option value="UpToToday" selected="@(Model.Period == "UpToToday")">Up to today</option>
                            <option value="ThisMonth" selected="@(Model.Period == "ThisMonth")">This month</option>
                            <option value="LastSixMonths" selected="@(Model.Period == "LastSixMonths")">Last 6 months</option>
                            <option value="Custom" selected="@(Model.Period == "Custom")">Custom range</option>
                        </select>
                    </div>
                    @dateGroup(null)
                    <div class="field-group">
                        <label class="field-label" for="campaignFrom">From date (instalment due)</label>
                        <input class="field-input" id="campaignFrom" name="dateFrom" type="date" min="2000-01-01" max="2100-12-31" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" data-date-from data-campaign-from />
                    </div>
                    <div class="field-group">
                        <label class="field-label" for="campaignTo">To date (instalment due)</label>
                        <input class="field-input" id="campaignTo" name="dateTo" type="date" min="2000-01-01" max="2100-12-31" value="@Model.FormDateTo?.ToString("yyyy-MM-dd")" data-date-to data-campaign-to />
                    </div>
                    <div class="field-group">
                        <label class="field-label" for="campaignMin">Minimum Total (AED)</label>
                        <input class="field-input" type="number" id="campaignMin" name="minTotal" min="0" step="any" inputmode="decimal" value="@Model.MinTotalText" data-min-total />
                    </div>
                    @* Floor: apartment floors of the chosen towers (derived from the unit number). All Floors (nothing ticked) = no filtering. The list reloads when the towers change (collections-tower-multi.js). *@
                    <partial name="_FloorMultiPicker" model="@(new FloorMultiPickerModel("campaignFloor", Model.FloorOptions, Model.FloorIds, "/Collections/Campaigns", Model.FloorsFailed))" />
                </div>
            </details>
            <span class="receivables-loading" role="status" hidden>Loading customers…</span>
            <span class="receivables-timeout" role="alert" hidden>The list is taking too long. Retry or choose one tower.</span>
        </div>
    </form>
    @* A slim status strip: the three state chips of the financial snapshot (reconciliation, data, CRM). A reconciliation blocker inside it is never collapsed. *@
    <section class="campaign-snapshot" data-snapshot-box aria-label="Financial snapshot status" aria-live="polite">
        @if (Model.RenderFull) { <partial name="_CampaignSnapshotStatus" model="Model" /> }
        else
        {
            <p class="campaign-snapshot__idle" data-snapshot-idle>
                <span class="campaign-pill campaign-pill--idle">Snapshot not loaded yet</span>
                <partial name="_InfoTip" model="@(new InfoTipModel("tip-snapshot-idle", "Financial snapshot status", "Its status appears here once customers are previewed, and stays visible while you change filters."))" />
            </p>
        }
    </section>
    @* The KPI cards and the compact notes of the last preview. collections-campaign-filters.js lifts them here out of every results fragment; they are cleared with the customers. *@
    <div class="campaign-kpi-box" data-kpi-box></div>
    @* One results section: the customer search, the actions (Approve & Send to Genesys, exports) and the table. *@
    <section class="panel campaign-results">
        <div class="campaign-search">
            @* Part of the filter form (form attribute) but placed with the results it narrows. *@
            <label class="field-label" for="campaignSearch">Search customers</label>
            <input class="field-input" form="campaignFilters" type="search" id="campaignSearch" name="search" maxlength="200" value="@Model.Search" placeholder="Customer name, mobile, tower or apartment" />
        </div>
        <div class="receivables-results" data-results data-results-url="/Collections/Campaigns" aria-live="polite">
            @if (Model.RenderFull) { <partial name="_CampaignResults" model="Model" /> }
            else
            {
                <p class="campaign-idle" role="status" data-results-idle>No customers loaded yet. Choose the filters, then click <strong>Preview Customers</strong>; nothing is queried or sent until you do.</p>
            }
        </div>
    </section>
</div>
<script src="~/js/info-tip.js" asp-append-version="true"></script>
<script src="~/js/receivables-load-monitor.js" asp-append-version="true"></script>
<script src="~/js/receivables.js" asp-append-version="true"></script>
<script src="~/js/collections-tower-multi.js" asp-append-version="true"></script>
<script src="~/js/collections-campaign-filters.js" asp-append-version="true"></script>
<script src="~/js/collections-campaign-approve.js" asp-append-version="true"></script>
<script src="~/js/collections-campaign-confirm.js" asp-append-version="true"></script>
