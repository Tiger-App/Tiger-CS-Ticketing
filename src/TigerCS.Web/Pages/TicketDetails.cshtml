@page "/Tickets/{id:long}"
@model TigerCS.Web.Pages.TicketDetailsModel
@using TigerCS.Domain.Modules.Ticketing
@{
    ViewData["ActiveNav"] = "tickets";
    Layout = "_Layout";
}

@if (Model.Ticket is null)
{
    ViewData["Title"] = "Ticket unavailable";
    <div class="page">
        <div class="error-state">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
            <p>
                @(Model.Outcome switch
                {
                    ApiOutcome.Forbidden => "You don't have permission to view this ticket.",
                    ApiOutcome.Unauthorized => "Your session is no longer valid. Sign in again.",
                    ApiOutcome.Unreachable or ApiOutcome.BadGateway => "Tiger Ticketing System could not reach the ticketing service.",
                    _ => "This ticket could not be loaded."
                })
            </p>
            <a class="btn btn-sm" href="@Model.ReturnContext.Href">Back to @Model.ReturnContext.View.Label()</a>
        </div>
    </div>
}
else
{
    var t = Model.Ticket;
    ViewData["Title"] = t.TicketNumber;
    var isClosed = t.TicketStatus == "Closed";
    var isResolved = t.TicketStatus == "Resolved";
    (string Label, string CssKey)? slaBadge = Model.Sla is not null ? TicketDisplay.SlaBadgeText(Model.Sla, DateTime.UtcNow) : null;

    // Display priority for the "Verification & Unit" panel (task: CRM Buyer snapshot >
    // external-lookup verification (PACT/Tasleeh) > manual Project/Unit Number > legacy
    // Unit/Contact reference) — a ticket carries at most one of these per the domain's
    // own mutual-exclusion invariants. An external-lookup ticket IS verified — against
    // its source — even though its VerificationStatus stays the CRM-scoped Unverified;
    // only a ticket with NEITHER a CRM Buyer match NOR an external source is a plain
    // manual entry ("Manual entry / Not externally verified").
    var hasCrmBuyer = t.CrmBuyerUnitId is not null;
    var hasExternalVerification = !hasCrmBuyer && !string.IsNullOrWhiteSpace(t.CustomerVerificationSource);
    var hasManualUnit = !hasCrmBuyer && !hasExternalVerification
        && (!string.IsNullOrWhiteSpace(t.ManualProjectName) || !string.IsNullOrWhiteSpace(t.ManualUnitNumber));
    var hasLegacyReference = !hasCrmBuyer && !hasExternalVerification && !hasManualUnit
        && (t.UnitReferenceId is not null || t.ContactReferenceId is not null);

    var guidance = Model.Guidance!;
    // The header action the guidance recommends is ringed, so the right button is easy to find among the allowed ones.
    string Rec(string key) => guidance.Primary is { IsTab: false } rp && rp.Key == key ? " is-recommended" : "";

    // The Actions menu is rendered only when it would hold at least one action — never an empty menu. Each entry inside keeps the
    // exact permission gate its endpoint enforces; this is only "is there anything to list".
    var showActionsMenu = (!isClosed && (Model.CanAssign || Model.CanClassify || Model.CanTransfer || Model.CanChangeStatus
                                          || Model.CanResolve || Model.CanEscalate || Model.CanRequestDowngrade))
        || (isResolved && Model.CanClose)
        || (t.IsReopenEligible && Model.CanReopen);
    var customer = Model.CustomerSummary!;
    var statusKey = TicketDisplay.TicketStatusCssKey(t.TicketStatus);

    <div class="page page--workspace">
        <nav class="breadcrumb breadcrumb--compact" aria-label="Breadcrumb">
            <a href="/Tickets">Tickets</a>
            <span class="sep">/</span>
            <a href="@Model.ReturnContext.Href">@Model.ReturnContext.View.Label()</a>
            <span class="sep">/</span>
            <span class="current">@t.TicketNumber</span>
        </nav>


        @if (!string.IsNullOrEmpty(Model.ActionSuccess))
        {
            <div class="alert alert-success" role="status">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>@Model.ActionSuccess</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ActionError))
        {
            <div class="alert alert-error" role="alert">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                <span>@Model.ActionError</span>
            </div>
        }

        @if (Model.CanTakeOwnership)
        {
            @* In a department queue with no assignee, human-handling: the Call Center agent may review it read-only and take it. Shown from the
               server's own CanTakeOwnership answer (the policy the Api applies), so this control and the endpoint cannot disagree. *@
            <div class="alert alert-info" role="status" id="take-ownership-notice">
                <span>This ticket is waiting in the <strong>@(Model.DepartmentName ?? "its department")</strong> queue with no assignee. It is read-only for you until you take ownership. Taking it moves it to the Call Center and assigns it to you; its status, SLA, classification and history are kept.</span>
                <form method="post" asp-page-handler="TakeOwnership" id="action-take-ownership" data-action="take-ownership">
                    <input type="hidden" asp-for="TakeOwnership.RowVersionBase64" />
                    <button type="submit" class="btn btn-gold btn-sm">Take Ownership</button>
                </form>
            </div>
        }
        else if (Model.IsReadOnlyAccess)
        {
            <div class="alert alert-info" role="status" id="read-only-notice">
                <span>You created this ticket and can follow its progress, but it belongs to another department, so it is read-only for you.</span>
            </div>
        }

        @* ---- Ticket workspace header: one compact block. Line 1 identifies the ticket and its state and holds the one Actions menu; the title
               follows; then who the customer is and who owns it. Everything else lives in the properties sidebar. ---- *@
        <header class="tw-head" aria-label="Ticket summary">
            <div class="tw-head__top">
                <div class="tw-head__ident">
                    <span class="tw-head__id">@t.TicketNumber</span>
                    <span class="tw-state tw-state--@statusKey"><span class="tw-state__dot" aria-hidden="true"></span>@TicketDisplay.TicketStatusLabel(t.TicketStatus)</span>
                    <span class="tw-prio tw-prio--@TicketDisplay.PriorityCssKey(t.PriorityId)">@TicketDisplay.PriorityLabel(t.PriorityId)</span>
                    @if (slaBadge is not null)
                    {
                        <span class="tw-sla tw-sla--@slaBadge.Value.CssKey" title="@(Model.Sla?.Explanation?.NotStartedReason)">SLA: @slaBadge.Value.Label</span>
                    }
                </div>

                @if (showActionsMenu)
                {
                <div class="tw-head__actions">
                    <details class="disclosure actions-menu" id="actions-menu" open="@(Model.OpenSection is "assign" or "classify" or "transfer" or "status" or "resolve" or "escalate" or "downgrade" or "reopen" ? "open" : null)">
                        <summary class="btn btn-sm">Actions</summary>
                        <div class="disclosure__panel actions-menu__panel" role="group" aria-label="Ticket actions">
                    @if (!isClosed)
                    {
                        @* Every control in this block is gated on the SAME rule its
                           endpoint enforces (TicketActions, reading the Api's own
                           TicketRoleSets/SlaRoleSets plus the ticket's owner and
                           department). !isClosed is lifecycle, not permission, and
                           stays as the outer condition. *@
                        @if (Model.CanAssign)
                        {
                        <details class="disclosure" id="action-assign" data-action="assign" open="@(Model.OpenSection == "assign" ? "open" : null)">
                            <summary class="btn btn-sm@(Rec("assign"))">Assign</summary>
                            <div class="disclosure__panel">
                                <form method="post" asp-page-handler="Assign" class="action-form">
                                    <input type="hidden" asp-for="Assign.RowVersionBase64" />
                                    @if (Model.CanAssignAcrossDepartments)
                                    {
                                        @* CS Manager: the whole directory, grouped by department, the
                                           ticket's own department first. Picking someone in another
                                           department transfers the ticket there and assigns it in one
                                           step (reason required) — the Api enforces that the assignee
                                           belongs to the resulting department. *@
                                        <div class="field-group">
                                            <label class="field-label" asp-for="Assign.Target">Assign to</label>
                                            <select class="field-select" asp-for="Assign.Target" data-assign-current-department="@t.CurrentDepartmentId">
                                                <option value="">— choose a person —</option>
                                                @foreach (var group in Model.AssignableByDepartment)
                                                {
                                                    var isCurrent = group.DepartmentId == Model.Ticket.CurrentDepartmentId;
                                                    <optgroup label="@group.Name@(isCurrent ? " (current department)" : "")">
                                                        @if (group.Members.Count == 0)
                                                        {
                                                            <option value="" disabled>No active members</option>
                                                        }
                                                        @foreach (var member in group.Members)
                                                        {
                                                            var otherDepartments = member.Departments.Where(d => d.DepartmentId != group.DepartmentId).Select(d => d.Name).ToList();
                                                            <option value="@member.EmployeeId|@group.DepartmentId">@member.DisplayName — @string.Join(", ", member.Roles)@(otherDepartments.Count > 0 ? $" (also in {string.Join(", ", otherDepartments)})" : "")</option>
                                                        }
                                                    </optgroup>
                                                }
                                            </select>
                                            @if (Model.AssignableUsersOutcome == ApiOutcome.Forbidden)
                                            {
                                                <span class="field-hint field-hint--error">You are not permitted to load the cross-department directory.</span>
                                            }
                                            else if (Model.AssignableUsersOutcome != ApiOutcome.Success)
                                            {
                                                <span class="field-hint field-hint--error">The assignee directory could not be loaded (@Model.AssignableUsersOutcome). Reload the page or try again later.</span>
                                            }
                                            else if (Model.AssignableUsers.Count == 0)
                                            {
                                                <span class="field-hint">No active employees are members of any department yet.</span>
                                            }
                                            else
                                            {
                                                <span class="field-hint">Choosing someone in another department transfers the ticket to that department and assigns it to them. A person in several departments is listed under each.</span>
                                            }
                                        </div>
                                        <div class="field-group">
                                            <label class="field-label" asp-for="Assign.Reason">Reason (required when the person is in another department)</label>
                                            <textarea class="form-control" asp-for="Assign.Reason" rows="2" placeholder="Why the ticket moves to that department"></textarea>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="field-group">
                                            <label class="field-label" asp-for="Assign.Target">Assign to</label>
                                            <select class="field-select" asp-for="Assign.Target">
                                                @foreach (var member in Model.AssignableEmployees)
                                                {
                                                    <option value="@member.EmployeeId|@t.CurrentDepartmentId">@member.DisplayName — @string.Join(", ", member.Roles)</option>
                                                }
                                            </select>
                                            @if (Model.AssignableEmployeesOutcome == ApiOutcome.Forbidden || Model.AssignableEmployeesOutcome == ApiOutcome.Unauthorized)
                                            {
                                                <span class="field-hint field-hint--error">You are not permitted to load this department's members.</span>
                                            }
                                            else if (Model.AssignableEmployeesOutcome != ApiOutcome.Success)
                                            {
                                                <span class="field-hint field-hint--error">The member list could not be loaded (@Model.AssignableEmployeesOutcome). Reload the page or try again later.</span>
                                            }
                                            else if (Model.AssignableEmployees.Count == 0)
                                            {
                                                <span class="field-hint">No active members found in this department.</span>
                                            }
                                        </div>
                                    }
                                    <div class="field-group">
                                        <label class="field-label" asp-for="Assign.ReasonCode">Why is it changing hands? (required when the ticket already has an owner)</label>
                                        <select class="field-select" asp-for="Assign.ReasonCode">
                                            <option value="">— not needed for a first assignment —</option>
                                            <option value="@((byte)TicketTransferReason.UnableToResolve)">Unable to resolve</option>
                                            <option value="@((byte)TicketTransferReason.NeedsEscalation)">Needs escalation</option>
                                            <option value="@((byte)TicketTransferReason.WrongDepartment)">Wrong department</option>
                                            <option value="@((byte)TicketTransferReason.CustomerRequest)">Customer request</option>
                                            <option value="@((byte)TicketTransferReason.Other)">Other</option>
                                        </select>
                                        <span class="field-hint">Reassigning an owned ticket needs a reason; assigning from the department queue does not.</span>
                                    </div>
                                    <div class="action-form__footer"><button type="submit" class="btn btn-gold btn-sm">Assign</button></div>
                                </form>
                            </div>
                        </details>
                        }

                        @if (Model.CanClassify)
                        {
                            @* Classify an Unclassified ticket: category, request type and priority for the ticket's own department.
                               This only classifies — it never requests a human handoff. When the department has nothing valid to choose
                               from, the form is replaced by the reason and the existing administrative path: Classify is never offered
                               as something to do while it cannot be completed. *@
                            <details class="disclosure" id="action-classify" data-action="classify" open="@(Model.OpenSection == "classify" ? "open" : null)">
                                <summary class="btn btn-sm@(Model.ClassifyNotice is null ? Rec("classify") : "")">@(t.IsDefaultClassification || t.CanCorrectClassification ? "Reclassify" : "Classify")@(Model.ClassifyNotice is null ? "" : " (not available)")</summary>
                                <div class="disclosure__panel">
                                    @if (Model.ClassifyNotice is { } classifyNotice)
                                    {
                                        <div class="classify-notice@(classifyNotice.IsConfiguration ? "" : " classify-notice--error")" role="status">
                                            <p class="classify-notice__title">@classifyNotice.Headline</p>
                                            <p class="classify-notice__detail">@classifyNotice.Detail</p>
                                            @if (classifyNotice.AdminHref is { } classifyAdminHref)
                                            {
                                                <a class="btn btn-sm" href="@classifyAdminHref">@classifyNotice.AdminLabel</a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                    <form method="post" asp-page-handler="Classify" class="action-form" data-classify-form>
                                        <input type="hidden" asp-for="Classify.RowVersionBase64" />
                                        <div class="field-group">
                                            <label class="field-label" asp-for="Classify.CategoryId">Category</label>
                                            <select class="field-select" asp-for="Classify.CategoryId" data-classify-category>
                                                @foreach (var c in Model.ClassifyOptions.Categories)
                                                {
                                                    <option value="@c.CategoryId">@c.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <input type="hidden" asp-for="Classify.RequestTypeAlreadySet" />
                                        @if (Model.Classify.RequestTypeAlreadySet)
                                        {
                                            <div class="field-group">
                                                <span class="field-label">Request type</span>
                                                <span>@(t.RequestTypeName ?? "Already set")</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="field-group" data-classify-request-types-group>
                                                <label class="field-label" asp-for="Classify.RequestTypeId">Request type</label>
                                                @* Each option names the category it belongs under; the script shows only the chosen category's.
                                                   Without script every option is listed and the server refuses a mismatched pair. *@
                                                <select class="field-select" asp-for="Classify.RequestTypeId" data-classify-request-type>
                                                    <option value="0" data-category-ids="">No request type for this category</option>
                                                    @foreach (var c in Model.ClassifyOptions.Categories)
                                                    {
                                                        foreach (var r in c.RequestTypes)
                                                        {
                                                            <option value="@r.RequestTypeId" data-category-ids="@c.CategoryId">@r.Name</option>
                                                        }
                                                    }
                                                </select>
                                                <span class="field-hint" data-classify-request-type-hint>Choose the request type that belongs under the selected category.</span>
                                            </div>
                                        }
                                        <div class="field-group">
                                            <label class="field-label" asp-for="Classify.PriorityId">Priority</label>
                                            <select class="field-select" asp-for="Classify.PriorityId">
                                                @foreach (var p in Model.ClassifyPriorities)
                                                {
                                                    <option value="@p">@TicketDisplay.PriorityLabel(p)</option>
                                                }
                                            </select>
                                            <span class="field-hint">Only the current priority or a more urgent one — lowering it needs an approved downgrade.</span>
                                        </div>
                                        @if (Model.ClassifyOptions.UnreachableRequestTypes.Count > 0 && !Model.Classify.RequestTypeAlreadySet)
                                        {
                                            <span class="field-hint">@Model.ClassifyOptions.UnreachableRequestTypes.Count request type@(Model.ClassifyOptions.UnreachableRequestTypes.Count == 1 ? "" : "s") in this department cannot be chosen because no category carries the same name.</span>
                                        }
                                        <div class="action-form__footer"><button type="submit" class="btn btn-gold btn-sm">Classify</button></div>
                                    </form>
                                    }
                                </div>
                            </details>
                        }

                        @if (Model.CanTransfer)
                        {
                            <details class="disclosure" id="action-transfer" data-action="transfer" open="@(Model.OpenSection == "transfer" ? "open" : null)">
                                <summary class="btn btn-sm@(Rec("transfer"))">Transfer</summary>
                                <div class="disclosure__panel">
                                    <form method="post" asp-page-handler="Transfer" class="action-form">
                                        <input type="hidden" asp-for="Transfer.RowVersionBase64" />
                                        <div class="field-group">
                                            <label class="field-label" asp-for="Transfer.TargetDepartmentId">Transfer to department</label>
                                            <select class="field-select" asp-for="Transfer.TargetDepartmentId">
                                                @foreach (var d in Model.TransferTargets)
                                                {
                                                    <option value="@d.DepartmentId">@d.Name</option>
                                                }
                                            </select>
                                            @if (Model.TransferTargetsUnavailable)
                                            {
                                                <span class="field-hint">The department list could not be loaded. Please try again.</span>
                                            }
                                            else if (Model.TransferTargets.Count == 0)
                                            {
                                                <span class="field-hint">No other active department is available to transfer to.</span>
                                            }
                                        </div>
                                        <div class="field-group">
                                            <label class="field-label" asp-for="Transfer.ReasonCode">Why is it being transferred?</label>
                                            <select class="field-select" asp-for="Transfer.ReasonCode">
                                                <option value="">— choose a reason —</option>
                                                <option value="@((byte)TicketTransferReason.UnableToResolve)">Unable to resolve</option>
                                                <option value="@((byte)TicketTransferReason.NeedsEscalation)">Needs escalation</option>
                                                <option value="@((byte)TicketTransferReason.WrongDepartment)">Wrong department</option>
                                                <option value="@((byte)TicketTransferReason.CustomerRequest)">Customer request</option>
                                                <option value="@((byte)TicketTransferReason.Other)">Other</option>
                                            </select>
                                        </div>
                                        <div class="field-group">
                                            <label class="field-label" asp-for="Transfer.Reason">Reason</label>
                                            <textarea class="form-control" asp-for="Transfer.Reason" rows="2"></textarea>
                                        </div>
                                        <div class="action-form__footer"><button type="submit" class="btn btn-gold btn-sm" disabled="@(Model.TransferTargets.Count == 0 ? "disabled" : null)">Transfer</button></div>
                                    </form>
                                </div>
                            </details>
                        }

                        @if (Model.CanChangeStatus)
                        {
                        <details class="disclosure" id="action-status" data-action="status" open="@(Model.OpenSection == "status" ? "open" : null)">
                            <summary class="btn btn-sm@(Rec("status"))">Change Status</summary>
                            <div class="disclosure__panel">
                                <form method="post" asp-page-handler="ChangeStatus" class="action-form">
                                    <input type="hidden" asp-for="Status.RowVersionBase64" />
                                    <div class="field-group">
                                        <label class="field-label" asp-for="Status.NewStatus">New status</label>
                                        @* The legal next statuses for THIS ticket, from the domain's own
                                           transition table via Model.StatusTargets — never a literal list.
                                           The section is not rendered at all when that list is empty. *@
                                        <select class="field-select" asp-for="Status.NewStatus">
                                            @foreach (var s in Model.StatusTargets)
                                            {
                                                <option value="@s">@TicketDisplay.TicketStatusLabel(s.ToString())</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field-group">
                                        <label class="field-label" asp-for="Status.PendingReason">Pending reason</label>
                                        <textarea class="form-control" asp-for="Status.PendingReason" rows="2"></textarea>
                                        <span class="field-hint">Required when moving to Pending Customer — e.g. "Missing documents", "Awaiting the customer's payment".</span>
                                    </div>
                                    <div class="action-form__footer"><button type="submit" class="btn btn-gold btn-sm">Update status</button></div>
                                </form>
                            </div>
                        </details>
                        }

                        @if (Model.CanResolve)
                        {
                        <details class="disclosure" id="action-resolve" data-action="resolve" open="@(Model.OpenSection == "resolve" ? "open" : null)">
                            <summary class="btn btn-sm@(Rec("resolve"))">Resolve</summary>
                            <div class="disclosure__panel">
                                <form method="post" asp-page-handler="Resolve" class="action-form">
                                    <input type="hidden" asp-for="Resolve.RowVersionBase64" />
                                    <div class="field-group">
                                        <label class="field-label" asp-for="Resolve.ResolutionOutcome">Outcome</label>
                                        <select class="field-select" asp-for="Resolve.ResolutionOutcome">
                                            @foreach (var o in new[] { "Resolved", "Cancelled", "Rejected", "Duplicate" })
                                            {
                                                <option value="@o">@o</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="field-group">
                                        <label class="field-label" asp-for="Resolve.DuplicateOfTicketId">Duplicate of ticket ID</label>
                                        <input class="form-control" asp-for="Resolve.DuplicateOfTicketId" />
                                        <span class="field-hint">Only used when outcome is Duplicate.</span>
                                    </div>
                                    <div class="field-group">
                                        <label class="field-label" asp-for="Resolve.ResolutionNote">Resolution note</label>
                                        <textarea class="form-control" asp-for="Resolve.ResolutionNote" rows="3"></textarea>
                                    </div>
                                    <div class="action-form__footer"><button type="submit" class="btn btn-gold btn-sm">Resolve</button></div>
                                </form>
                            </div>
                        </details>
                        }

                        @if (Model.CanEscalate)
                        {
                        <details class="disclosure" id="action-escalate" data-action="escalate" open="@(Model.OpenSection == "escalate" ? "open" : null)">
                            <summary class="btn btn-sm@(Rec("escalate"))">Escalate</summary>
                            <div class="disclosure__panel">
                                <form method="post" asp-page-handler="Escalate" class="action-form">
                                    <input type="hidden" asp-for="Escalate.RowVersionBase64" />
                                    <div class="field-group">
                                        <label class="field-label" asp-for="Escalate.Level">Escalate to level</label>
                                        <select class="field-select" asp-for="Escalate.Level">
                                            @* Level 4 is a SEPARATE server rule (ManualLevel4 —
                                               CS Manager/GM only, never widened by ownership or
                                               department), so it is offered separately too. *@
                                            @{ var topLevel = Model.CanEscalateToLevel4 ? 4 : 3; }
                                            @for (byte lvl = 1; lvl <= topLevel; lvl++)
                                            {
                                                <option value="@lvl">Level @lvl</option>
                                            }
                                        </select>
                                        <span class="field-hint">Current level: @TicketDisplay.EscalationLevelLabel(t.EscalationLevel). Levels only rise. Level 4 is restricted to CS Manager/GM.</span>
                                    </div>
                                    <div class="field-group">
                                        <label class="field-label" asp-for="Escalate.Note">Note (optional)</label>
                                        <textarea class="form-control" asp-for="Escalate.Note" rows="2"></textarea>
                                    </div>
                                    <div class="action-form__footer"><button type="submit" class="btn btn-critical btn-sm">Escalate</button></div>
                                </form>
                            </div>
                        </details>
                        }

                        @* Priority downgrade (ISSUE-023): requesting changes NOTHING on the
                           ticket - a Department Head must approve before the priority or the
                           SLA period moves. Only lower priorities are offered. *@
                        @if (Model.CanRequestDowngrade)
                        {
                        <details class="disclosure" id="action-downgrade" data-action="downgrade" open="@(Model.OpenSection == "downgrade" ? "open" : null)">
                            <summary class="btn btn-sm">Request priority downgrade</summary>
                            <div class="disclosure__panel">
                                <form method="post" asp-page-handler="RequestDowngrade" class="action-form">
                                    <div class="field-group">
                                        <label class="field-label" asp-for="DowngradeRequest.NewPriorityId">Lower the priority to</label>
                                        <select class="field-select" asp-for="DowngradeRequest.NewPriorityId">
                                            @foreach (var target in Model.DowngradeTargets)
                                            {
                                                <option value="@target.PriorityId">@target.Label</option>
                                            }
                                        </select>
                                        <span class="field-hint">Takes effect only after a Department Head approves it. Any SLA breach already recorded stays on record.</span>
                                    </div>
                                    <div class="field-group">
                                        <label class="field-label" asp-for="DowngradeRequest.Reason">Reason (required)</label>
                                        <textarea class="form-control" asp-for="DowngradeRequest.Reason" rows="2"></textarea>
                                    </div>
                                    <div class="action-form__footer"><button type="submit" class="btn btn-gold btn-sm">Submit request</button></div>
                                </form>
                            </div>
                        </details>
                        }
                    }

                    @* Resolved is the lifecycle half; CanClose is the permission
                       half (the CS layer, per ISSUE-022's Resolve/Close split). *@
                    @if (isResolved && Model.CanClose)
                    {
                        <form method="post" asp-page-handler="Close" id="action-close" data-action="close">
                            <input type="hidden" asp-for="Close.RowVersionBase64" />
                            <button type="submit" class="btn btn-sm@(Rec("close"))">Close ticket</button>
                        </form>
                    }

                    @* Reopen (FR-RES-04, approved rule): rendered only where
                       the lifecycle allows it — the server-computed
                       IsReopenEligible flag (Closed, closed as Resolved,
                       inside the reopen window), which is why a Resolved
                       ticket no longer offers it at all — and only for the
                       Agent role; the Api still enforces both, plus the
                       caller's access to this ticket, which the UI cannot see. *@
                    @if (t.IsReopenEligible && Model.CanReopen)
                    {
                        <details class="disclosure" id="action-reopen" data-action="reopen" open="@(Model.OpenSection == "reopen" ? "open" : null)">
                            <summary class="btn btn-sm@(Rec("reopen"))">Reopen</summary>
                            <div class="disclosure__panel">
                                @if (Model.ReopenTargetsUnavailable)
                                {
                                    <p class="field-hint">The department directory could not be loaded, so this ticket cannot be reopened right now. Refresh and try again.</p>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Reopen" class="action-form">
                                        <input type="hidden" asp-for="Reopen.RowVersionBase64" />
                                        <div class="field-group">
                                            <label class="field-label" asp-for="Reopen.TargetDepartmentId">Department</label>
                                            <select class="form-control" asp-for="Reopen.TargetDepartmentId" required
                                                    asp-items="@(new SelectList(Model.ReopenTargets, nameof(DepartmentDto.DepartmentId), nameof(DepartmentDto.Name)))"></select>
                                            <span class="field-hint">Who takes this on. Keep the current department or hand it to another — either way the previous assignee is cleared and the ticket is re-assigned automatically, or waits in that department's queue.</span>
                                        </div>
                                        <div class="field-group">
                                            <label class="field-label" asp-for="Reopen.Reason">Reason</label>
                                            <textarea class="form-control" asp-for="Reopen.Reason" rows="2" required placeholder="Why is this ticket being reopened?"></textarea>
                                            <span class="field-hint">Returns the ticket to In Progress and starts a new Resolution SLA cycle; the first-response result and the current resolution are kept as history. The reason is shown in Activity.</span>
                                        </div>
                                        <div class="action-form__footer"><button type="submit" class="btn btn-gold btn-sm">Reopen ticket</button></div>
                                    </form>
                                }
                            </div>
                        </details>
                    }
                        </div>
                    </details>
                </div>
                }
            </div>

            <h1 class="tw-head__title">@t.RequestSummary</h1>

            <div class="tw-head__people">
                <div class="tw-who">
                    <span class="tw-avatar" aria-hidden="true">@(customer.HasName ? TicketDisplay.Initials(customer.Name) : "?")</span>
                    @if (customer.ProfileHref is { } whoProfile)
                    {
                        <a class="tw-who__name" href="@whoProfile">@customer.Name</a>
                    }
                    else
                    {
                        <span class="tw-who__name@(customer.HasName ? "" : " is-muted")">@customer.Name</span>
                    }
                    <span class="tw-who__fact tw-who__phone">@(customer.Phone ?? "No phone recorded")</span>
                    @if (customer.ProjectUnit is not null)
                    {
                        <span class="tw-who__fact">@customer.ProjectUnit@if (!customer.UnitIsConfirmed) { <span class="tw-muted"> (typed in)</span> }</span>
                    }
                    <span class="tw-verif tw-verif--@customer.StateCss">@customer.StateLabel</span>
                </div>
                <div class="tw-owner">
                    <span><strong>Assigned To:</strong> @TicketDisplay.AssignedToLabel(t.CurrentOwnerEmployeeId, Model.OwnerName, t.CurrentDepartmentId, Model.DepartmentName, !isClosed && !isResolved)</span>
                    <span><strong>Assigned Department:</strong> @TicketDisplay.AssignedDepartmentLabel(t.CurrentDepartmentId, Model.DepartmentName)</span>
                </div>
            </div>

            @if (Model.PendingDowngrade is { } pendingDowngrade)
            {
                <div class="status-banner status-banner--pending" id="pending-downgrade" data-action="pending-downgrade">
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" /><path d="M12 8v4l3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                    <div>
                        Priority downgrade pending approval: @TicketDisplay.PriorityLabel(pendingDowngrade.CurrentPriorityId) &rarr; @TicketDisplay.PriorityLabel(pendingDowngrade.RequestedPriorityId).
                        The priority and SLA are unchanged until a Department Head approves. Reason: @pendingDowngrade.Reason
                        (expires @pendingDowngrade.ExpiresAtUtc.ToString("yyyy-MM-dd HH:mm") UTC).
                        @if (Model.CanDecideDowngrade)
                        {
                            <form method="post" asp-page-handler="ApproveDowngrade" class="action-form">
                                <input type="hidden" asp-for="DowngradeDecision.RequestId" value="@pendingDowngrade.PriorityDowngradeRequestId" />
                                <input type="hidden" asp-for="DowngradeDecision.RowVersionBase64" value="@Convert.ToBase64String(pendingDowngrade.RowVersion)" />
                                <button type="submit" class="btn btn-gold btn-sm">Approve downgrade</button>
                            </form>
                            <details class="disclosure" open="@(Model.OpenSection == "downgrade" ? "open" : null)">
                                <summary class="btn btn-sm">Reject</summary>
                                <div class="disclosure__panel">
                                    <form method="post" asp-page-handler="RejectDowngrade" class="action-form">
                                        <input type="hidden" asp-for="DowngradeDecision.RequestId" value="@pendingDowngrade.PriorityDowngradeRequestId" />
                                        <input type="hidden" asp-for="DowngradeDecision.RowVersionBase64" value="@Convert.ToBase64String(pendingDowngrade.RowVersion)" />
                                        <div class="field-group">
                                            <label class="field-label" asp-for="DowngradeDecision.DecisionNote">Reason for rejecting (required)</label>
                                            <textarea class="form-control" asp-for="DowngradeDecision.DecisionNote" rows="2"></textarea>
                                        </div>
                                        <div class="action-form__footer"><button type="submit" class="btn btn-critical btn-sm">Reject downgrade</button></div>
                                    </form>
                                </div>
                            </details>
                        }
                    </div>
                </div>
            }
        </header>


        @* ---- Next step: ONE quiet line. The recommended action for THIS viewer (the only gold control on the page), a "Why" popover for the
               reason / blockers / what is unavailable, and the record-first-response shortcut when the Api allows it. ---- *@
        @{
            var nextCss = guidance.Level switch
            {
                AttentionLevel.Urgent => "urgent",
                AttentionLevel.Attention => "attention",
                AttentionLevel.Done => "done",
                _ => "info"
            };
            var hasWhy = !string.IsNullOrWhiteSpace(guidance.Reason) || guidance.Alerts.Count > 0 || guidance.Unavailable.Count > 0;
        }
        <section class="tw-next tw-next--@nextCss" aria-labelledby="attention-title">
            <span class="tw-next__label" id="attention-title">Next step</span>
            <span class="tw-next__headline">@guidance.Headline</span>
            <span class="tw-next__tools">
                @if (Model.CanRecordFirstResponse)
                {
                    @* First Response SLA stops only on a HUMAN response. Staff who answer the customer outside the Genesys transcript
                       (phone, e-mail, walk-in) record it here; AI/automated replies never do. *@
                    <form method="post" asp-page-handler="RecordFirstResponse" class="tw-next__inline-form">
                        <input type="hidden" asp-for="Escalate.RowVersionBase64" />
                        <button type="submit" class="tw-link-btn" title="Already answered the customer outside the system?">Record first response</button>
                    </form>
                }
                @if (hasWhy)
                {
                    <details class="disclosure tw-next__why">
                        <summary class="tw-link-btn">Why</summary>
                        <div class="disclosure__panel tw-next__pop">
                            <p class="tw-next__reason">@guidance.Reason</p>
                            @if (guidance.Alerts.Count > 0)
                            {
                                <ul class="tw-next__list">
                                    @foreach (var alert in guidance.Alerts)
                                    {
                                        <li class="tw-next__item tw-next__item--@alert.Level.ToString().ToLowerInvariant()">@alert.Text</li>
                                    }
                                </ul>
                            }
                            @if (guidance.Unavailable.Count > 0)
                            {
                                <div class="tw-next__sub">Not available to you right now</div>
                                <ul class="tw-next__list tw-next__list--quiet">
                                    @foreach (var blocked in guidance.Unavailable)
                                    {
                                        <li><strong>@blocked.Label</strong> &mdash; @blocked.Reason</li>
                                    }
                                </ul>
                            }
                        </div>
                    </details>
                }
                @if (guidance.Primary is { } primary)
                {
                    @if (primary.IsTab)
                    {
                        <label class="btn btn-gold btn-sm tab-jump tw-next__cta" for="@primary.Key" tabindex="0">@primary.Label</label>
                    }
                    else
                    {
                        <a class="btn btn-gold btn-sm tw-next__cta" href="#action-@primary.Key" data-guidance-target="@primary.Key">@primary.Label</a>
                    }
                }
            </span>
        </section>

        <div class="tw-body">
        <div class="tw-main">
        <div class="tabs-card tabs-card--page ticket-tabs">
            <input type="radio" name="pageTab" id="tab-details" class="tab-input" checked />
            <label class="tab-label" for="tab-details">Conversation</label>
            <input type="radio" name="pageTab" id="tab-activity" class="tab-input" />
            <label class="tab-label" for="tab-activity">Activity <span class="tab-count">@(Model.ActivityFeed.Count + Model.Escalations.Count)</span></label>
            <input type="radio" name="pageTab" id="tab-customer" class="tab-input" />
            <label class="tab-label" for="tab-customer">Customer@(Model.CustomerHistory is not null ? $" ({Model.CustomerHistory.TotalTickets})" : "")</label>
            <input type="radio" name="pageTab" id="tab-approvals" class="tab-input" />
            <label class="tab-label" for="tab-approvals">Approvals@(Model.Approvals is { } approvalsTab && approvalsTab.Approvals.Count > 0 ? $" ({approvalsTab.Approvals.Count})" : "")</label>

            <div class="tabs-body">
                @* ---- Overview: D. the request and its conversation, E. the latest activity, F. everything else behind one fold ---- *@
                <div class="tab-panel" id="panel-details">
                    <div class="tw-stack">
                        @await Html.PartialAsync("_TicketConversationHistory", Model)

                            @* ---- E. Activity: the latest three, newest first; the full timeline is one click away. ---- *@
                            <section class="tw-feed" aria-label="Latest activity">
                                <div class="facts-section__title">Latest Activity</div>
                                @if (Model.ActivityFeed.Count == 0)
                                {
                                    <div class="empty-state empty-state--compact"><p>No activity recorded yet.</p></div>
                                }
                                else
                                {
                                    <ol class="timeline">
                                        @foreach (var entry in Model.ActivityFeed.TakeLast(3).Reverse())
                                        {
                                            var iconCss = entry.Kind switch { "escalation" => "icon-critical", "transfer" => "icon-warning", "note" => "icon-info", "reopen" => "icon-warning", "approval" => "icon-info", _ => "icon-quiet" };
                                            <li class="timeline-item">
                                                <span class="timeline-icon @iconCss"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" fill="currentColor" /></svg></span>
                                                <div class="timeline-row">
                                                    <span class="timeline-text"><strong>@entry.Actor</strong> &mdash; @entry.Description</span>
                                                    <span class="timeline-time">@TicketDisplay.UaeDateTime(entry.TimestampUtc)</span>
                                                </div>
                                            </li>
                                        }
                                    </ol>
                                    <p class="panel-note"><span class="text-secondary">UAE time.</span> <label class="link-muted tab-jump" for="tab-activity">Open the full activity timeline</label></p>
                                }
                            </section>
                    </div>
                </div>

                @* ---- Activity: the timeline, notes, escalations ---- *@
                <div class="tab-panel" id="panel-activity">
                    <div class="detail-layout">
                        <div class="facts-panel facts-panel--flat">
                            <div class="facts-section__title">Timeline <span class="timeline-zone">All times in @TicketDisplay.ActivityTimeZoneLabel</span></div>
                            @if (Model.ActivityTimelineUnavailable)
                            {
                                <p class="field-hint" data-activity-timeline-unavailable>Only the basic history is shown: the full activity timeline is unavailable right now. Reload the page to retry.</p>
                            }
                            @if (Model.ActivityFeed.Count == 0)
                            {
                                <div class="empty-state"><p>No activity recorded yet.</p></div>
                            }
                            else
                            {
                                <ol class="timeline" data-activity-timeline>
                                    @foreach (var entry in Model.ActivityFeed)
                                    {
                                        var iconCss = entry.Kind switch { "escalation" => "icon-critical", "anomaly" => "icon-critical", "closure" => "icon-warning", "note" => "icon-info", "reopen" => "icon-warning", "approval" => "icon-info", "handoff" => "icon-info", _ => "icon-quiet" };
                                        var evt = entry.Event;
                                        <li class="timeline-item" data-activity-kind="@entry.Kind">
                                            <span class="timeline-icon @iconCss"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" fill="currentColor" /></svg></span>
                                            <div class="timeline-row">
                                                @if (evt is not null)
                                                {
                                                    <span class="timeline-text"><strong>@evt.EventName</strong> &mdash; <span class="timeline-actor" data-actor-type="@evt.ActorType">@evt.ActorName</span> <small class="timeline-actor-type">(@evt.ActorType)</small></span>
                                                }
                                                else
                                                {
                                                    <span class="timeline-text"><strong>@entry.Actor</strong> &mdash; @entry.Description</span>
                                                }
                                                <span class="timeline-time">@TicketDisplay.DubaiTimestamp(entry.TimestampUtc)</span>
                                            </div>
                                            @if (evt is not null)
                                            {
                                                <div class="timeline-detail">@evt.Description</div>
                                                @if (!string.IsNullOrWhiteSpace(evt.Reason))
                                                {
                                                    <div class="timeline-detail">Reason: @evt.Reason</div>
                                                }
                                                @if (evt.PreviousValue is not null || evt.NewValue is not null)
                                                {
                                                    <div class="timeline-detail">@(evt.PreviousValue ?? "Not recorded") &rarr; @(evt.NewValue ?? "Not recorded")</div>
                                                }
                                                @if (evt.RecordedAtUtc is { } recordedAt)
                                                {
                                                    <div class="timeline-detail">Recorded by TigerCS at @TicketDisplay.DubaiTimestamp(recordedAt) &mdash; later than the event itself (delayed delivery).</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(evt.TimeNote))
                                                {
                                                    <div class="timeline-detail">@evt.TimeNote</div>
                                                }
                                                @if (evt.Closure is { } closure)
                                                {
                                                    <dl class="timeline-closure" data-closure>
                                                        <div><dt>Closed by</dt><dd>@closure.ClosedByType &mdash; @closure.ClosedByName</dd></div>
                                                        <div><dt>Closed at</dt><dd>@TicketDisplay.DubaiTimestamp(closure.ClosedAtUtc) (Asia/Dubai)</dd></div>
                                                        <div><dt>Reason</dt><dd>@closure.Reason <small>(@closure.ReasonCode &middot; source: @closure.EvidenceSource)</small></dd></div>
                                                        <div><dt>Customer interaction already ended?</dt><dd>@closure.CustomerInteractionEnded &mdash; @closure.CustomerInteractionEndedDetail</dd></div>
                                                        <div><dt>Human agent connected / responding?</dt><dd>@closure.HumanAgentConnected &mdash; @closure.HumanAgentDetail</dd></div>
                                                        @if (closure.HumanActivityAfterClosure)
                                                        {
                                                            <div><dt>Human activity after closure</dt><dd>@closure.Assessment &mdash; @closure.AssessmentDetail</dd></div>
                                                        }
                                                    </dl>
                                                }
                                                @if (evt.TicketInteractionId is not null)
                                                {
                                                    <div class="timeline-detail"><label class="link-muted tab-jump" for="tab-details">Open Conversation History (Overview)</label></div>
                                                }
                                            }
                                            @if (!string.IsNullOrEmpty(entry.Detail))
                                            {
                                                <div class="timeline-detail">@entry.Detail</div>
                                            }
                                            @if (evt is null && !string.IsNullOrEmpty(entry.Note))
                                            {
                                                <div class="timeline-note @(entry.IsHuman ? "timeline-note--human" : "timeline-note--system")">@entry.Note</div>
                                            }
                                        </li>
                                    }
                                </ol>
                            }

                            @if (Model.ActivityEvidenceGaps.Count > 0)
                            {
                                <details class="more-details" data-activity-evidence-gaps>
                                    <summary>Evidence the timeline could not find (@Model.ActivityEvidenceGaps.Count)</summary>
                                    <ul>
                                        @foreach (var gap in Model.ActivityEvidenceGaps)
                                        {
                                            <li>@gap</li>
                                        }
                                    </ul>
                                </details>
                            }

                            @if (!isClosed && !Model.IsReadOnlyAccess && TicketActions.CanAddNote(Model.Viewer?.Roles))
                            {
                                <div class="composer">
                                    <form method="post" asp-page-handler="AddNote">
                                        <label class="field-label" asp-for="Note.NoteText">Add a note</label>
                                        <textarea class="form-control" asp-for="Note.NoteText" rows="3" placeholder="Write a note…"></textarea>
                                        <div class="composer__footer">
                                            <button type="submit" class="btn btn-gold btn-sm">Save note</button>
                                        </div>
                                    </form>
                                </div>
                            }
                        </div>
                        <aside class="facts-panel">
                            <div class="facts-section__title">Escalations</div>
                            @if (Model.Escalations.Count == 0)
                            {
                                <div class="empty-state"><p>No escalations recorded.</p></div>
                            }
                            else
                            {
                                <div class="entry-list">
                                    @foreach (var e in Model.Escalations)
                                    {
                                        <div class="entry-row">
                                            <span class="entry-row__field">Escalated to @TicketDisplay.EscalationLevelLabel($"Level{e.Level}") (@e.TriggerType)</span>
                                            <span class="text-secondary">@TicketDisplay.UaeDateTime(e.RaisedAtUtc)</span>
                                        </div>
                                    }
                                </div>
                            }
                        </aside>
                    </div>
                </div>

                @* ---- Customer: previous tickets (the customer summary band above is always visible) ---- *@
                <div class="tab-panel" id="panel-customer">
                    <div class="facts-panel facts-panel--flat">
                        <div class="facts-section__title">Previous Tickets@(Model.CustomerHistory is not null ? $" ({Model.CustomerHistory.TotalTickets})" : "")</div>
                    @if (Model.CustomerHistory is null)
                    {
                        <div class="empty-state"><p>Customer history is unavailable right now.</p></div>
                    }
                    else
                    {
                        var history = Model.CustomerHistory;
                        @if (history.VerificationType == "Unverified")
                        {
                            <p class="badge badge-verification-unverified">Unverified Customer History</p>
                        }
                        <p class="text-secondary">
                            @if (!string.IsNullOrEmpty(history.CustomerDisplayName))
                            {
                                <span>Customer: <strong>@history.CustomerDisplayName</strong> · </span>
                            }
                            Total: @history.TotalTickets · Open: @history.OpenTickets · Closed: @history.ClosedTickets
                        </p>

                        @if (history.Tickets.Count == 0)
                        {
                            <div class="empty-state"><p>No previous tickets found for this customer.</p></div>
                        }
                        else
                        {
                            <div class="table-scroll">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>Ticket</th>
                                            <th>Category</th>
                                            <th>Department</th>
                                            <th>Status</th>
                                            <th>Priority</th>
                                            <th>Created</th>
                                            <th>Resolved</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in history.Tickets)
                                        {
                                            <tr>
                                                <td><a class="ticket-id-link" href="/Tickets/@row.TicketId">@row.TicketNumber</a></td>
                                                <td>@Model.CategoryLabel(row.CategoryId)</td>
                                                <td>@TicketDisplay.AssignedDepartmentLabel(row.CurrentDepartmentId, Model.NameResolver.TryGetDepartmentName(row.CurrentDepartmentId))</td>
                                                <td><span class="badge badge-status-@TicketDisplay.TicketStatusCssKey(row.TicketStatus)"><span class="badge-dot"></span>@TicketDisplay.TicketStatusLabel(row.TicketStatus)</span></td>
                                                <td><span class="badge badge-priority-@TicketDisplay.PriorityCssKey(row.PriorityId)">@TicketDisplay.PriorityLabel(row.PriorityId)</span></td>
                                                <td class="text-secondary text-mono">@TicketDisplay.UaeDate(row.CreatedAtUtc)</td>
                                                <td class="text-secondary text-mono">@(row.ResolvedAtUtc is { } rowResolved ? TicketDisplay.UaeDate(rowResolved) : "—")</td>
                                                <td><a class="btn btn-sm" href="/Tickets/@row.TicketId">Open</a></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                        @if (Model.CustomerProfileHref is { } allTicketsHref)
                        {
                            <p class="panel-note"><a class="link-muted" href="@allTicketsHref">See every ticket, unit and interaction on the Customer Profile →</a></p>
                        }
                    </div>
                </div>

                @* ---- Approvals & Dependencies ---- *@
                <div class="tab-panel" id="panel-approvals">
                    <div class="facts-panel facts-panel--flat">
                @* Approvals / Dependencies (Workflow/Automation phase 3).
                   Rendered only when there is something to show; action
                   buttons appear only for callers the API says may act —
                   no disabled buttons for non-approvers. Approval state is
                   separate from Ticket Status by design. *@
                @{
                    var approvalsView = Model.Approvals;
                    static string ApprovalLabel(string type) => type switch
                    {
                        "AccountingApproval" => "Accounting Approval",
                        "CustomerServiceApproval" => "Customer Service Approval",
                        "ReopenApproval" => "Reopen Approval",
                        _ => type
                    };
                    static bool IsReopenApproval(string type) => string.Equals(type, "ReopenApproval", StringComparison.Ordinal);
                    var showApprovals = approvalsView is not null
                        && (approvalsView.Approvals.Count > 0
                            || approvalsView.RequestableApprovals.Count > 0
                            || approvalsView.MaintenanceState is not null
                            || approvalsView.PrerequisitesCompletedAtUtc is not null);
                }
                @if (showApprovals)
                {
                    <div class="facts-section">
                        <div class="facts-section__title">Approvals &amp; Dependencies</div>

                        @foreach (var approval in approvalsView!.Approvals.Where(a => a.IsCurrent))
                        {
                            <dl>
                                <div class="facts-row"><dt>@ApprovalLabel(approval.ApprovalType)</dt><dd>@approval.Status</dd></div>
                                <div class="facts-row"><dt>Requested</dt><dd>@TicketDisplay.UaeDateTime(approval.RequestedAtUtc)</dd></div>
                                @if (approval.DecisionAtUtc is { } decidedAt)
                                {
                                    <div class="facts-row"><dt>Decided</dt><dd>@TicketDisplay.UaeDateTime(decidedAt)</dd></div>
                                }
                                @if (!string.IsNullOrEmpty(approval.RequestComment))
                                {
                                    <div class="facts-row"><dt>@(IsReopenApproval(approval.ApprovalType) ? "Reopen reason" : "Reason")</dt><dd>@approval.RequestComment</dd></div>
                                }
                                @if (!string.IsNullOrEmpty(approval.DecisionComment))
                                {
                                    <div class="facts-row"><dt>Comment</dt><dd>@approval.DecisionComment</dd></div>
                                }
                                <div class="facts-row"><dt>Decided by</dt><dd>@approval.TargetSummary</dd></div>
                            </dl>
                            @* An approved Reopen Approval authorizes the ask and nothing
                               else — the ticket is still Closed, and the reopen itself is
                               the normal Reopen action above, available only to the roles
                               that hold it and still validating every rule at that moment. *@
                            @if (IsReopenApproval(approval.ApprovalType) && approval.Status == "Approved")
                            {
                                <p class="field-hint">
                                    Reopen request approved — the ticket stays Closed until someone with Reopen permission
                                    performs the Reopen action, choosing the department that takes it on.
                                    @(Model.CanReopen ? "" : " You do not hold that permission.")
                                </p>
                            }
                            @if (approval.CallerCanDecide)
                            {
                                <form method="post" asp-page-handler="DecideApproval" class="action-form">
                                    <input type="hidden" name="ApprovalDecision.ApprovalId" value="@approval.TicketApprovalId" />
                                    <div class="field-group">
                                        <textarea class="form-control" name="ApprovalDecision.Comment" rows="2" placeholder="Comment — required to reject"></textarea>
                                    </div>
                                    <div class="action-form__footer">
                                        <button type="submit" class="btn btn-gold btn-sm" name="ApprovalDecision.Decision" value="Approve">Approve</button>
                                        <button type="submit" class="btn btn-critical btn-sm" name="ApprovalDecision.Decision" value="Reject">Reject</button>
                                    </div>
                                </form>
                            }
                        }

                        @foreach (var requestable in approvalsView.RequestableApprovals)
                        {
                            <dl>
                                <div class="facts-row"><dt>@ApprovalLabel(requestable.ApprovalType)</dt><dd>Not requested</dd></div>
                                <div class="facts-row"><dt>Decided by</dt><dd>@requestable.TargetSummary</dd></div>
                            </dl>
                            @if (requestable.CallerCanRequest)
                            {
                                var isReopenRequest = IsReopenApproval(requestable.ApprovalType);
                                <form method="post" asp-page-handler="RequestApproval" class="action-form">
                                    <input type="hidden" name="ApprovalRequest.ApprovalType" value="@requestable.ApprovalType" />
                                    <div class="field-group">
                                        @if (isReopenRequest)
                                        {
                                            <label class="field-label" for="reopen-approval-reason">Reopen reason</label>
                                            <textarea class="form-control" id="reopen-approval-reason" name="ApprovalRequest.Comment" rows="2" required
                                                      placeholder="Why does this ticket need to be reopened?"></textarea>
                                            <span class="field-hint">This asks @requestable.TargetSummary to approve a reopen. It does not reopen the ticket.</span>
                                        }
                                        else
                                        {
                                            <textarea class="form-control" name="ApprovalRequest.Comment" rows="2" placeholder="Request comment (optional)"></textarea>
                                        }
                                    </div>
                                    <div class="action-form__footer">
                                        <button type="submit" class="btn btn-gold btn-sm">Request @ApprovalLabel(requestable.ApprovalType)</button>
                                    </div>
                                </form>
                            }
                        }

                        <dl>
                            @if (approvalsView.MaintenanceState is { } maintenanceState)
                            {
                                <div class="facts-row"><dt>Maintenance</dt><dd>@(maintenanceState switch
                                {
                                    "Required" => "Required — Pending",
                                    "NotRequired" => "Not Required",
                                    "Completed" => "Completed",
                                    _ => maintenanceState
                                })</dd></div>
                            }
                            @if (approvalsView.PrerequisitesCompletedAtUtc is { } prereqAt)
                            {
                                <div class="facts-row"><dt>Prerequisites</dt><dd>Completed @TicketDisplay.UaeDateTime(prereqAt)</dd></div>
                            }
                        </dl>

                        @if (approvalsView.CallerCanRecordEvents)
                        {
                            <form method="post" asp-page-handler="RecordEvent" class="action-form">
                                <div class="field-group">
                                    <select class="field-select" name="WorkflowEvent.EventType">
                                        @if (approvalsView.PrerequisitesCompletedAtUtc is null)
                                        {
                                            <option value="PrerequisitesCompleted">Prerequisites completed</option>
                                        }
                                        @if (approvalsView.MaintenanceState is null)
                                        {
                                            <option value="MaintenanceRequired">Maintenance required</option>
                                            <option value="MaintenanceNotRequired">Maintenance not required</option>
                                        }
                                        else if (approvalsView.MaintenanceState == "Required")
                                        {
                                            <option value="MaintenanceCompleted">Maintenance completed</option>
                                            <option value="MaintenanceNotRequired">Maintenance not required</option>
                                        }
                                        else if (approvalsView.MaintenanceState == "NotRequired")
                                        {
                                            <option value="MaintenanceRequired">Maintenance required</option>
                                        }
                                    </select>
                                </div>
                                <div class="field-group">
                                    <input class="form-control" name="WorkflowEvent.Note" placeholder="Note (optional)" />
                                </div>
                                <div class="action-form__footer"><button type="submit" class="btn btn-sm">Record</button></div>
                            </form>
                        }
                    </div>
                }
                        @if (!showApprovals)
                        {
                            <div class="empty-state">
                                <svg viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                <p class="empty-state__title">No approvals or dependencies apply.</p>
                                <p>@(Model.Approvals is null ? "Approval information is unavailable right now." : "This ticket's request type requires no approval, maintenance or prerequisite step.")</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        </div>
        <aside class="tw-side" aria-label="Ticket properties">
        @{
            var handlingInteraction = Model.Interactions.LastOrDefault(i => i.HandlingState is not null);
        }
        <section class="tw-sec" aria-label="Request details">
            <div class="facts-section__title" role="heading" aria-level="2">Request Details</div>
            <dl class="tw-props">
                @* An unclassified ticket says so plainly — a real state, not missing data. Categories are shown by name, never by id. *@
                @* The approved default (a department's own General) is a real, stored classification - shown as such, and replaceable through Reclassify. *@
                @if (t.IsDefaultClassification)
                {
                    <div class="facts-row"><dt>Category</dt><dd>@(Model.CategoryName ?? TigerCS.Application.Modules.Ticketing.Services.DefaultClassificationService.CategoryName)</dd></div>
                    <div class="facts-row"><dt>Request type</dt><dd>@(t.RequestTypeName ?? TigerCS.Application.Modules.Ticketing.Services.DefaultClassificationService.RequestTypeName)</dd></div>
                }
                else
                {
                    <div class="facts-row"><dt>Category</dt><dd>@(t.CategoryId is null ? "Not yet classified" : Model.CategoryName ?? "Classified")</dd></div>
                    <div class="facts-row"><dt>Request type</dt><dd>@(t.RequestTypeName ?? (t.CategoryId is null ? "Not yet classified" : "Not specified"))</dd></div>
                }
                @if (t.OriginatingChannelId is not null)
                {
                    @* The channel the ticket ENTERED on, resolved from channel configuration by id (still named once deactivated). *@
                    <div class="facts-row"><dt>Came in through</dt><dd>@(t.OriginatingChannelName ?? "Unknown channel")</dd></div>
                }
                @if (handlingInteraction is not null)
                {
                    <div class="facts-row">
                        <dt>Handled by</dt>
                        <dd>@TicketDisplay.HandlingStateLabel(handlingInteraction.HandlingState, handlingInteraction.AgentName)@if (handlingInteraction.Handoff is { } handlingHandoff) { <text> &middot; Handoff: @TicketDisplay.HandoffStatusLabel(handlingHandoff.Status)</text> }</dd>
                    </div>
                }
                <div class="facts-row"><dt>Opened</dt><dd>@TicketDisplay.AgoLabel(t.CreatedAtUtc, DateTime.UtcNow)</dd></div>
                @if (t.EscalationLevel != "None")
                {
                    <div class="facts-row"><dt>Escalation</dt><dd class="is-critical">@TicketDisplay.EscalationLevelLabel(t.EscalationLevel)</dd></div>
                }
                @if (t.ReopenCount > 0)
                {
                    <div class="facts-row"><dt>Reopened</dt><dd>@(t.ReopenCount == 1 ? "Once" : $"{t.ReopenCount} times")</dd></div>
                }
                @if (t.ResolutionOutcome is not null)
                {
                    <div class="facts-row"><dt>Resolution</dt><dd>@TicketDisplay.ResolutionOutcomeLabel(t.ResolutionOutcome)</dd></div>
                }
            </dl>
        </section>
        <section class="tw-sec" aria-label="SLA">
            <div class="facts-section__title" role="heading" aria-level="2">SLA Information</div>
            @if (Model.Sla is null)
            {
                <p class="tw-muted">SLA data unavailable.</p>
            }
            else
            {
                var sla = Model.Sla;
                var why = sla.Explanation;
                var slaView = TicketSlaView.Build(sla, t.TicketStatus, DateTime.UtcNow);
                @if (slaView.NotStartedReason is { } notStarted)
                {
                    @* No clock is running — say exactly why. *@
                    <p class="tw-note sla-explain__reason">@notStarted</p>
                }
                <dl class="tw-props">
                    <div class="facts-row"><dt>@slaView.FirstResponse.Name</dt><dd class="@(slaView.FirstResponse.CssKey is "breached" ? "is-critical" : "")">@slaView.FirstResponse.State</dd></div>
                    <div class="facts-row"><dt>@slaView.Resolution.Name</dt><dd class="@(slaView.Resolution.CssKey is "breached" ? "is-critical" : "")">@slaView.Resolution.State</dd></div>
                    @if (sla.TotalPausedMinutesThisPeriod > 0)
                    {
                        <div class="facts-row"><dt>Paused so far</dt><dd>@TicketDisplay.FormatMinutes(sla.TotalPausedMinutesThisPeriod)</dd></div>
                    }
                </dl>
                @if (why is not null)
                {
                    <details class="tw-fold sla-explain">
                        <summary>How this SLA is calculated</summary>
                        <dl class="tw-props">
                            <div class="facts-row"><dt>Applied priority</dt><dd>@(why.AppliedPriorityLabel ?? "Not set")</dd></div>
                            <div class="facts-row"><dt>Policy</dt><dd>@(why.FirstResponseTargetMinutes is null ? "None" : why.PolicySource)</dd></div>
                            @if (why.FirstResponseTargetMinutes is int fr && why.ResolutionTargetMinutes is int res)
                            {
                                <div class="facts-row"><dt>Targets</dt><dd>First response @TicketDisplay.FormatMinutes(fr) &middot; Resolution @TicketDisplay.FormatMinutes(res)</dd></div>
                            }
                            @if (why.ClockBasis is not null)
                            {
                                <div class="facts-row"><dt>Clock</dt><dd>@why.ClockBasis@(why.Calendar is null ? "" : $" ({why.Calendar.BusinessDayStartLocal}–{why.Calendar.BusinessDayEndLocal} {why.Calendar.TimeZoneId})")</dd></div>
                            }
                            <div class="facts-row"><dt>Clock started</dt><dd>@(why.ClockStartedAtUtc is { } clockStarted ? TicketDisplay.UaeTime(clockStarted) : "Not started")</dd></div>
                            @if (sla.IsCurrentlyPaused)
                            {
                                <div class="facts-row"><dt>Resolution clock</dt><dd>Paused — @sla.CurrentPauseReason (first response is not paused)</dd></div>
                            }
                            @if (why.RequestTypeSlaNote is { } requestTypeSlaNote)
                            {
                                <div class="facts-row"><dt>Request-type SLA</dt><dd>@requestTypeSlaNote</dd></div>
                            }
                        </dl>
                        <ul class="sla-explain__notes">
                            @foreach (var note in why.Notes)
                            {
                                <li>@note</li>
                            }
                            @if (why.Calendar is { } cal)
                            {
                                <li>Business calendar “@cal.Name”: @cal.BusinessDayStartLocal–@cal.BusinessDayEndLocal (@cal.TimeZoneId), working days @string.Join(", ", cal.WorkingDays); @cal.HolidayCount holiday@(cal.HolidayCount == 1 ? "" : "s") configured.</li>
                            }
                            <li><strong>First response:</strong> @why.FirstResponseRule</li>
                            <li><strong>Pausing:</strong> @why.PauseRule</li>
                        </ul>
                    </details>
                }
            }
        </section>
        @if (customer.Hint is not null || customer.NameNote is not null || Model.CustomerHistory is not null || customer.ProfileHref is not null)
        {
        <section class="tw-sec tw-cust" aria-label="Customer">
            <div class="facts-section__title" role="heading" aria-level="2">Customer</div>
            @if (customer.NameNote is { } customerNameNote)
            {
                <p class="tw-note">@customerNameNote</p>
            }
            @if (customer.Hint is { } customerHint)
            {
                <p class="tw-note">@customerHint</p>
            }
            @if (Model.CustomerHistory is { } sideHistory)
            {
                <dl class="tw-props">
                    <div class="facts-row"><dt>Tickets</dt><dd>@sideHistory.OpenTickets open &middot; @sideHistory.TotalTickets total</dd></div>
                </dl>
            }
            <div class="tw-linkrow">
                @if (customer.ProfileHref is { } sideProfile)
                {
                    <a class="tw-link" href="@sideProfile">Customer profile</a>
                    <label class="tw-link tab-jump" for="tab-customer">Previous tickets@(Model.CustomerHistory is not null ? $" ({Model.CustomerHistory.TotalTickets})" : "")</label>
                }
                else if (customer.Hint is null)
                {
                    <span class="tw-muted">No customer identity on this ticket, so there is no profile to open.</span>
                }
            </div>
        </section>
        }
        @* ---- Customer satisfaction: shown on the page only when a review exists (or could not be loaded); otherwise one line under Additional details. ---- *@
        @if (Model.ReviewsUnavailable || Model.Reviews.Count > 0)
        {
        <section class="tw-sec" id="customer-satisfaction" aria-label="Customer satisfaction">
<div class="facts-section__title" role="heading" aria-level="2">Customer Satisfaction</div>
@if (Model.ReviewsUnavailable)
{
    <p class="field-hint">Customer reviews are unavailable right now.</p>
}
else if (Model.Reviews.Count == 0)
{
    <p class="field-hint">No review has been requested for this ticket yet.</p>
}
else
{
    foreach (var review in Model.Reviews)
    {
        <dl class="review-cycle">
            @if (Model.Reviews.Count > 1 || review.ReopenCycle > 0)
            {
                <div class="facts-row"><dt>Review cycle</dt><dd>@TicketDisplay.ReviewCycleLabel(review.ReopenCycle)</dd></div>
            }
            <div class="facts-row">
                <dt>Review status</dt>
                <dd>
                    <span class="badge @(review.Rating is null ? "badge-neutral" : "badge-active")">@review.Status</span>
                    @if (review.IsTest)
                    {
                        <span class="badge badge-warning" title="Submitted through a Test-mode link; excluded from production statistics.">Test review</span>
                    }
                </dd>
            </div>
            @if (review.Rating is int rating)
            {
                <div class="facts-row">
                    <dt>Rating</dt>
                    <dd><span class="review-stars" aria-label="@rating out of 5 stars">@TicketDisplay.StarsFor(rating)</span> @rating/5</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(review.Comment))
                {
                    <div class="facts-row"><dt>Feedback</dt><dd>@review.Comment</dd></div>
                }
                @if (review.SubmittedAtUtc is { } submittedAt)
                {
                    <div class="facts-row"><dt>Submitted</dt><dd>@TicketDisplay.UaeTime(submittedAt)</dd></div>
                }
            }
            else if (review.RequestedAtUtc is { } requestedAt)
            {
                <div class="facts-row"><dt>Requested</dt><dd>@TicketDisplay.UaeTime(requestedAt)</dd></div>
            }
        </dl>
    }
}
        </section>

        }
        @* ---- F. Additional details: everything an agent rarely needs, folded away. ---- *@
        <details class="more-details" id="additional-details">
            <summary>Additional details <span class="more-details__hint">SLA &middot; verification &middot; handling &middot; reviews &middot; attachments</span></summary>
            <div class="more-details__body">
<div class="facts-section">
    <div class="facts-section__title">Verification &amp; Unit</div>
    <dl>
        <div class="facts-row">
            <dt>Verification</dt>
            <dd>@(hasExternalVerification
                    ? $"Verified via {TicketDisplay.LookupSourceLabel(t.CustomerVerificationSource!)}"
                    : hasManualUnit
                        ? "Manual entry / Not externally verified"
                        : TicketDisplay.VerificationStatusLabel(t.VerificationStatus))</dd>
        </div>
        @if (hasCrmBuyer)
        {
            @* The customer is a linked record, never static text. *@
            var factsCrmName = TigerCS.Application.Modules.Notifications.Services.CustomerNameValidator.Sanitize(t.CrmBuyerCustomerName);
                            <div class="facts-row"><dt>Customer</dt><dd>@if (Model.CustomerProfileHref is { } factsProfileHref && factsCrmName is not null) { <a class="ticket-id-link" href="@factsProfileHref">@factsCrmName</a> } else { @(factsCrmName ?? "—") }</dd></div>
            <div class="facts-row"><dt>Project</dt><dd>@(t.CrmBuyerProjectName ?? "—")</dd></div>
            <div class="facts-row"><dt>Unit Number</dt><dd>@(t.CrmBuyerUnitNumber ?? "—")</dd></div>
            <div class="facts-row"><dt>CRM Unit ID</dt><dd class="id-fallback">#@t.CrmBuyerUnitId</dd></div>
            <div class="facts-row"><dt>Lead ID</dt><dd class="id-fallback">@(t.CrmBuyerLeadId is int leadId ? $"#{leadId}" : "—")</dd></div>
            <div class="facts-row"><dt></dt><dd><a class="btn btn-sm" href="@(Model.CustomerProfileHref ?? $"/Tickets/{t.TicketId}/Customer")">View Customer Profile</a></dd></div>
        }
        else if (hasExternalVerification)
        {
            <div class="facts-row"><dt>Project</dt><dd>@(t.ManualProjectName ?? "—")</dd></div>
            <div class="facts-row"><dt>Unit Number</dt><dd>@(t.ManualUnitNumber ?? "—")</dd></div>
            <div class="facts-row"><dt>@TicketDisplay.LookupSourceLabel(t.CustomerVerificationSource!) Customer ID</dt><dd class="id-fallback">@(t.ExternalCustomerId ?? "—")</dd></div>
            <div class="facts-row"><dt>@TicketDisplay.LookupSourceLabel(t.CustomerVerificationSource!) Unit ID</dt><dd class="id-fallback">@(t.ExternalUnitId ?? "—")</dd></div>
        }
        else if (hasManualUnit)
        {
            <div class="facts-row"><dt>Project</dt><dd>@(t.ManualProjectName ?? "—")</dd></div>
            <div class="facts-row"><dt>Unit Number</dt><dd>@(t.ManualUnitNumber ?? "—")</dd></div>
        }
        else if (hasLegacyReference)
        {
            <div class="facts-row"><dt>Unit reference</dt><dd class="id-fallback">@(t.UnitReferenceId is int u ? $"#{u}" : "—")</dd></div>
            <div class="facts-row"><dt>Contact reference</dt><dd class="id-fallback">@(t.ContactReferenceId is int c ? $"#{c}" : "—")</dd></div>
        }
    </dl>
</div>

                <div class="facts-section">
                    <div class="facts-section__title">Handling &amp; Escalation</div>
                    <dl>
                        <div class="facts-row"><dt>First handled by</dt><dd>@(Model.FirstHandledByName ?? "Not recorded")</dd></div>
                        <div class="facts-row"><dt>Times transferred</dt><dd>@t.TransferCount</dd></div>
                        <div class="facts-row"><dt>Escalated</dt><dd>@(t.EscalationCount == 0 ? "No" : t.EscalationCount == 1 ? "Once" : $"{t.EscalationCount} times")@(t.EscalationLevel != "None" ? $" · now {TicketDisplay.EscalationLevelLabel(t.EscalationLevel)}" : "")</dd></div>
                        @if (t.ReopenCount > 0)
                        {
                            <div class="facts-row"><dt>Reopened</dt><dd>@(t.ReopenCount == 1 ? "Once" : $"{t.ReopenCount} times")</dd></div>
                        }
                        @if (t.ResolvedByEmployeeId is not null)
                        {
                            <div class="facts-row"><dt>Resolved by</dt><dd>@Model.ResolvedByName@(t.ResolvedAtUtc is { } resolvedAt ? $" · {TicketDisplay.UaeTime(resolvedAt)}" : "")</dd></div>
                        }
                        @if (t.ResolutionOutcome is not null)
                        {
                            <div class="facts-row"><dt>Outcome</dt><dd>@TicketDisplay.ResolutionOutcomeLabel(t.ResolutionOutcome)</dd></div>
                        }
                        @if (t.WorkflowName is not null)
                        {
                            <div class="facts-row"><dt>Workflow</dt><dd>@t.WorkflowName <span class="badge badge-neutral">V@(t.WorkflowVersionNumber)</span></dd></div>
                        }
                    </dl>
                </div>

                <div class="facts-section">
                    <div class="facts-section__title">Reviews, Approvals &amp; Attachments</div>
                    <dl>
                        @if (!Model.ReviewsUnavailable && Model.Reviews.Count == 0)
                        {
                            <div class="facts-row"><dt>Customer review</dt><dd>None requested yet</dd></div>
                        }
                        <div class="facts-row"><dt>Approvals</dt><dd>@(Model.Approvals is { Approvals.Count: > 0 } approvalsSummary ? $"{approvalsSummary.Approvals.Count} on record — see the Approvals tab" : Model.Approvals is null ? "Unavailable right now" : "None apply")</dd></div>
                        <div class="facts-row"><dt>Attachments</dt><dd>Not supported yet — documents stay on the channel they arrived on; record where they are in a note.</dd></div>
                    </dl>
                    <p class="panel-note"><label class="link-muted tab-jump" for="tab-activity">Open the complete audit history</label></p>
                </div>
            </div>
        </details>
        </aside>
        </div>
    </div>
}
