@model TigerCS.Web.Pages.TicketQueueRow
@{
    var t = Model.Ticket;
}
<tr>
    <td>
        <span class="badge badge-status-@TicketDisplay.TicketStatusCssKey(t.TicketStatus)">
            <span class="badge-dot"></span>@TicketDisplay.TicketStatusLabel(t.TicketStatus)
        </span>
    </td>
    <td><a class="ticket-id-link" href="/Tickets/@t.TicketId">@t.TicketNumber</a></td>
    <td class="col-subject">@t.RequestSummary</td>
    <td>@TicketDisplay.AssignedDepartmentLabel(t.CurrentDepartmentId, Model.DepartmentName)</td>
    <td>
        @* Closed: empty by rule. No owner: the AI virtual agent or the awaiting-agent label (see TicketDisplay). Owned: the employee's full name, never an id. *@
        @if (t.TicketStatus == "Closed")
        {
        }
        else if (TicketDisplay.IsDepartmentQueue(t.CurrentOwnerEmployeeId))
        {
            <span class="text-secondary">@TicketDisplay.AssignedToLabel(t.CurrentOwnerEmployeeId, null, t.CurrentDepartmentId, Model.DepartmentName, isActive: t.TicketStatus != "Resolved", isAiVirtualAgent: t.IsAiVirtualAgent)</span>
        }
        else
        {
            @TicketDisplay.AssignedToLabel(t.CurrentOwnerEmployeeId, t.CurrentOwnerName ?? Model.OwnerName, t.CurrentDepartmentId, Model.DepartmentName)
        }
    </td>
    <td class="text-secondary text-mono">@t.CreatedAtUtc.ToLocalTime().ToString("MMM d, HH:mm")</td>
</tr>
