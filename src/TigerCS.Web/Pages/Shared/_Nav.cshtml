@using TigerCS.Domain.Modules.IdentityAndAccess.Permissions
@inject ViewerAccessService ViewerAccess
@{
    // The primary workspace navigation. The former ticket-list
    // shortcuts are no longer top-level items — they are the views (tabs)
    // of the single Tickets workspace (see TicketsView), so every
    // ticket-related page (the list, Ticket Details, Customer Profile,
    // New Ticket) lights the same "Tickets" item.
    var active = ViewData["ActiveNav"] as string ?? "tickets";
    var currentUser = CurrentUser.FromPrincipal(User);
    // What the Api would answer for each module: never when the permission is denied to this employee; otherwise through the
    // module's role rule or an explicit grant. Hiding is presentation - every endpoint enforces the same overrides.
    var access = await ViewerAccess.GetAsync();
    var roles = currentUser?.Roles ?? [];
    var items = new List<(string Key, string Label, string Href)>();
    void Add(string key, string label, string href, string permission, bool roleRuleSatisfied = true)
    {
        if (access.CanReach(permission, roleRuleSatisfied)) { items.Add((key, label, href)); }
    }
    Add("dashboard", "Dashboard", "/Dashboard", Permissions.DashboardView);
    Add("customers", "Customers", "/Customers", Permissions.CustomersView);
    Add("tickets", "Tickets", "/Tickets", Permissions.TicketsView);
    Add("collections", "Collections", "/Collections/Receivables", Permissions.CollectionsView);
    // Management reports and Administration are role-gated at the Api: the role, or an explicit grant.
    Add("reports", "Team Performance", "/Reports/TeamPerformance", Permissions.ReportsView, ReportsPolicy.AppliesTo(currentUser));
    var adminRole = AdministrationPolicy.AppliesTo(currentUser);
    if (access.CanReach(Permissions.AdminUsersView, adminRole) || access.CanReach(Permissions.AdminConfigurationView, adminRole))
    {
        items.Add(("admin", "Administration", "/Admin"));
    }
    else if (access.CanReach(Permissions.CollectionsEdit, TowerAssignmentsPolicy.AppliesTo(currentUser)))
    {
        // A Collections manager who is not a System Administrator reaches only Administration -> Collections Tower Assignments.
        items.Add(("admin", "Administration", TowerAssignmentsPolicy.Route));
    }
}
<nav class="app-nav" aria-label="Primary">
    <ul class="app-nav__list">
        @foreach (var item in items)
        {
            <li>
                <a class="app-nav__link @(item.Key == active ? "is-active" : "")" href="@item.Href" aria-current="@(item.Key == active ? "page" : null)">@item.Label</a>
            </li>
        }
    </ul>
</nav>
