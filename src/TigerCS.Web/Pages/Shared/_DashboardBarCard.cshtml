@model TigerCS.Web.Pages.DashboardBarCard
@{
    // One operational breakdown card (Dashboard Phase 1): label left, bar
    // centre, count + percentage right; the header's total drills into the
    // matching tickets and the long tail folds behind "View all".
    //
    // The card's tone is keyed on its title — decoration only, exactly like
    // the Dashboard's KPI glyphs: it colours the bars and a 2px rule, never
    // the card's surface. Where the tone has a meaning, it is the same one
    // the rest of the app uses (ageing is a warning, priority is severity,
    // status is operational); the rest simply keep the six apart.
    var tone = Model.Title switch
    {
        "Volume by Channel" => "info",
        "Volume by Request Type" => "secondary",
        "Status" => "progress",
        "Volume by Department" => "brand",
        "Open Backlog Ageing" => "warning",
        "Priority" => "critical",
        _ => "info",
    };
    // A small glyph per card header, keyed on the card's title — decoration only,
    // like the tone above; the title, total and link come from the model.
    var headerIcon = Model.Title switch
    {
        "Status" => "<path d=\"M4 12h4l2-5 4 10 2-5h4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>",
        "Volume by Channel" => "<path d=\"M21 12a8 8 0 0 1-11.6 7.1L4 20l1-5.1A8 8 0 1 1 21 12Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>",
        "Volume by Request Type" => "<path d=\"M3 12V4h8l9 9-8 8-9-9Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><circle cx=\"7.5\" cy=\"8.5\" r=\"1\" fill=\"currentColor\"/>",
        "Open Backlog Ageing" => "<circle cx=\"12\" cy=\"12\" r=\"8.5\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M12 7.5V12l3 2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>",
        "Priority" => "<path d=\"M5 21V4M5 5h11l-2 4 2 4H5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>",
        "Volume by Department" => "<path d=\"M4 21V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v16M15 10h4a1 1 0 0 1 1 1v10M3 21h18M8 8h3M8 12h3M8 16h3\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>",
        _ => "<rect x=\"5\" y=\"4\" width=\"14\" height=\"16\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"1.8\"/>",
    };
    // Layout slot in the dashboard's breakdown grid (see .dash-card--types etc. in site.css).
    var slot = Model.Title switch
    {
        "Volume by Request Type" => "types",
        "Open Backlog Ageing" => "ageing",
        "Priority" => "priority",
        "Volume by Department" => "dept",
        _ => "other",
    };
}
<div class="panel dash-card tone-@tone dash-card--@slot">
    <div class="panel__header">
        <div class="panel__lead">
            <span class="panel__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none">@Html.Raw(headerIcon)</svg></span>
        <div>
            <span class="panel__title">@Model.Title</span>
            @if (!Model.Subtitle.StartsWith("Tickets created", StringComparison.Ordinal))
            {
                @* The volume period is stated once, in the page header; only a card with a different basis (backlog ageing) says so itself. *@
                <div class="dash-card__subtitle">@Model.Subtitle</div>
            }
        </div>
        </div>
        <a class="link-muted" href="@Model.TotalHref" title="Open the matching tickets">@Model.Total total</a>
    </div>
    @if (Model.Rows.Count == 0 || (Model.Total == 0 && Model.Rows.All(r => r.Count == 0)))
    {
        <div class="empty-state empty-state--compact">
            <p>@Model.EmptyText</p>
        </div>
    }
    else
    {
        <ul class="bar-list">
            @foreach (var row in Model.TopRows)
            {
                @await Html.PartialAsync("_DashboardBarRow", row)
            }
        </ul>
        @if (Model.MoreRows.Count > 0)
        {
            <details class="bar-list__more">
                <summary>View all (@Model.Rows.Count)</summary>
                <ul class="bar-list">
                    @foreach (var row in Model.MoreRows)
                    {
                        @await Html.PartialAsync("_DashboardBarRow", row)
                    }
                </ul>
            </details>
        }
    }
</div>
