@model TigerCS.Web.Pages.TicketsModel
@{
    // The Queue, My Tickets and Closed views: one filter bar, one table, one
    // pager over the same ticket-queue endpoint. My Tickets fixes the owner
    // to the viewer and Closed fixes the status, so those two controls are
    // not offered there.
    var viewKey = Model.View.Key();
    var isClosedView = Model.View == TicketsView.Closed;
    var isMyView = Model.View == TicketsView.My;
    var showAssigneeFilter = !isMyView && Model.AssigneeDepartmentId is not null;

    // A plain query string, NOT Url.Page: "page" is the reserved Razor Pages route value, so Url.Page(..., new { page = p }) drops the page number.
    string PageUrl(int p) => TicketsPaging.Url(new Dictionary<string, string?>
    {
        ["view"] = viewKey,
        ["departmentId"] = Model.DepartmentId?.ToString(),
        ["priorityId"] = Model.PriorityId?.ToString(),
        ["ticketStatus"] = isClosedView ? null : Model.TicketStatus,
        ["verificationStatus"] = Model.VerificationStatus,
        ["ownerEmployeeId"] = isMyView ? null : Model.OwnerEmployeeId?.ToString(),
        ["search"] = Model.Search,
        ["sortBy"] = Model.SortBy,
        ["sortDir"] = Model.SortDir,
        ["page"] = p.ToString(),
        ["pageSize"] = Model.PageSize.ToString(),
        ["channelId"] = Model.ChannelId?.ToString(),
        ["requestTypeId"] = Model.RequestTypeId?.ToString(),
        ["activeOnly"] = Model.ActiveOnly ? "true" : null,
        ["inDepartmentQueue"] = Model.InDepartmentQueue ? "true" : null,
        ["availableToTake"] = Model.AvailableToTake ? "true" : null,
        ["slaBreached"] = Model.SlaBreached ? "true" : null,
        ["dueToday"] = Model.DueToday ? "true" : null,
        ["backlogAge"] = Model.BacklogAge,
        ["pendingApproval"] = Model.PendingApproval ? "true" : null,
        ["unclassified"] = Model.Unclassified ? "true" : null,
        ["createdByMe"] = Model.CreatedByMe ? "true" : null,
        ["escalated"] = Model.Escalated ? "true" : null,
        ["closureCategory"] = Model.ClosureCategory,
        ["closedFrom"] = Model.ClosedFrom?.ToString("yyyy-MM-dd"),
        ["closedTo"] = Model.ClosedTo?.ToString("yyyy-MM-dd"),
        ["createdFrom"] = Model.CreatedFrom?.ToString("yyyy-MM-dd"),
        ["createdTo"] = Model.CreatedTo?.ToString("yyyy-MM-dd")
    });
}

@{
    // Compact toolbar: search + a Filters drawer + a Date popover + Reset. It
    // is still ONE GET form with the same field names, so every parameter,
    // permission check and backend predicate is unchanged. The badge counts
    // only the controls the drawer actually shows for this view.
    var filterCount = 0;
    if (Model.DepartmentId is not null && Model.NameResolver.OwnDepartments.Count > 0) filterCount++;
    if (!isClosedView && !string.IsNullOrEmpty(Model.TicketStatus)) filterCount++;
    if (Model.PriorityId is not null) filterCount++;
    if (!isClosedView && !string.IsNullOrEmpty(Model.SlaFilterValue)) filterCount++;
    if (Model.OffersAvailableToTakeFilter && Model.AvailableToTake) filterCount++;
    if (showAssigneeFilter && !string.IsNullOrEmpty(Model.AssigneeFilterValue)) filterCount++;
    if (Model.Channels.Count > 0 && Model.ChannelId is not null) filterCount++;
    if (!string.IsNullOrEmpty(Model.VerificationStatus)) filterCount++;
    if (Model.Unclassified) filterCount++;
    if (Model.Escalated && TicketActions.CanReviewEscalations(Model.Viewer?.Roles)) filterCount++;
    if (Model.CreatedByMe) filterCount++;
    var dateCount = (Model.CreatedFrom is not null ? 1 : 0) + (Model.CreatedTo is not null ? 1 : 0);
    var anyActive = filterCount > 0 || dateCount > 0 || !string.IsNullOrWhiteSpace(Model.Search);
    var chevron = "<svg class=\"tkt-pop__chev\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M6 9l6 6 6-6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>";
}

<form class="filter-bar" id="ticketFilters" method="get" role="search" aria-label="Filter tickets">
    <input type="hidden" name="view" value="@viewKey" />
    <div class="search-field filter-bar__search">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" /><path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <input type="search" name="search" value="@Model.Search" placeholder="Search ticket number, customer, phone, unit or summary…" aria-label="Search tickets" />
    </div>

    <button type="button" class="btn btn-sm tkt-pop__toggle" id="ticketFiltersToggle" data-drawer-open="ticketFilterDrawer"
            aria-haspopup="dialog" aria-expanded="false" aria-controls="ticketFilterDrawer">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        Filters
        @if (filterCount > 0) { <span class="tkt-pop__badge" aria-label="@filterCount active">@filterCount</span> }
    </button>

    @* Right-hand filter drawer. Generic .drawer component (site.js wires any
       [data-drawer]); to add a filter, add one .field-group to .drawer__fields
       and, if it should count as active, one line to filterCount above. *@
    <div class="drawer-backdrop" data-drawer-backdrop="ticketFilterDrawer" hidden></div>
    <aside class="drawer" id="ticketFilterDrawer" data-drawer role="dialog" aria-modal="true" aria-labelledby="ticketFilterDrawerTitle" aria-hidden="true" hidden>
        <header class="drawer__header">
            <h2 class="drawer__title" id="ticketFilterDrawerTitle">Filters</h2>
            <button type="button" class="drawer__close" data-drawer-close aria-label="Close filters">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            </button>
        </header>
        <div class="drawer__body">
            <div class="drawer__fields">

        @if (Model.NameResolver.OwnDepartments.Count > 0)
        {
            <div class="field-group">
                <label class="field-label" for="departmentId">Department</label>
                <select class="field-select" id="departmentId" name="departmentId">
                    <option value="">All my departments</option>
                    @foreach (var d in Model.NameResolver.OwnDepartments)
                    {
                        <option value="@d.DepartmentId" selected="@(Model.DepartmentId == d.DepartmentId)">@d.Name</option>
                    }
                </select>
            </div>
        }

        @if (!isClosedView)
        {
            <div class="field-group">
                <label class="field-label" for="ticketStatus">Status</label>
                <select class="field-select" id="ticketStatus" name="ticketStatus">
                    <option value="">All statuses</option>
                    @* The lifecycle's active statuses, from the domain — the retired
                       PendingThirdParty is not an operational filter any more. A historical
                       ticket still in it keeps showing its real status in its own row. *@
                    @foreach (var s in TicketStatusTransitions.ActiveStatuses.Select(v => v.ToString()))
                    {
                        <option value="@s" selected="@(Model.TicketStatus == s)">@TicketDisplay.TicketStatusLabel(s)</option>
                    }
                </select>
            </div>
        }

        <div class="field-group">
            <label class="field-label" for="priorityId">Priority</label>
            <select class="field-select" id="priorityId" name="priorityId">
                <option value="">All priorities</option>
                @for (byte p = 1; p <= 4; p++)
                {
                    <option value="@p" selected="@(Model.PriorityId == p)">@TicketDisplay.PriorityLabel(p)</option>
                }
            </select>
        </div>

        @if (!isClosedView)
        {
            @* SLA status rides the queue endpoint's own slaBreached/dueToday
               predicates (the ones the dashboard counts with); both apply to
               active tickets only, so the control is not offered on Closed. *@
            <div class="field-group">
                <label class="field-label" for="sla">SLA status</label>
                <select class="field-select" id="sla" name="sla">
                    <option value="">Any SLA</option>
                    <option value="breached" selected="@(Model.SlaFilterValue == "breached")">Breached</option>
                    <option value="dueToday" selected="@(Model.SlaFilterValue == "dueToday")">Due today</option>
                </select>
            </div>
        }

        @if (Model.OffersAvailableToTakeFilter)
        {
            <div class="field-group">
                <label class="field-label" for="availableToTake">Ownership</label>
                <select class="field-select" id="availableToTake" name="availableToTake">
                    <option value="">All tickets I can see</option>
                    <option value="true" selected="@Model.AvailableToTake">Available to take (no assignee)</option>
                </select>
            </div>
        }

        @if (showAssigneeFilter)
        {
            <div class="field-group">
                <label class="field-label" for="assignee">Assignee</label>
                <select class="field-select" id="assignee" name="assignee">
                    <option value="">Anyone</option>
                    @if (!isClosedView)
                    {
                        <option value="queue" selected="@(Model.AssigneeFilterValue == "queue")">Department queue (unassigned)</option>
                    }
                    @foreach (var member in Model.AssigneeOptions)
                    {
                        <option value="@member.EmployeeId" selected="@(Model.OwnerEmployeeId == member.EmployeeId)">@member.DisplayName</option>
                    }
                </select>
            </div>
        }

        @if (Model.Channels.Count > 0)
        {
            @* The channel the ticket ENTERED on (its originating interaction): Phone, WhatsApp, Live Chat, Instagram, Facebook, ... *@
            <div class="field-group">
                <label class="field-label" for="channelId">Channel</label>
                <select class="field-select" id="channelId" name="channelId">
                    <option value="">All channels</option>
                    @foreach (var channel in Model.Channels.OrderByDescending(c => c.IsActive).ThenBy(c => c.DisplayOrder).ThenBy(c => c.Name))
                    {
                        <option value="@channel.ChannelId" selected="@(Model.ChannelId == channel.ChannelId)">@channel.Name@(channel.IsActive ? "" : " (inactive)")</option>
                    }
                </select>
            </div>
        }

        <div class="field-group">
            <label class="field-label" for="verificationStatus">Verification</label>
            <select class="field-select" id="verificationStatus" name="verificationStatus">
                <option value="">All</option>
                @foreach (var v in new[] { "Unverified", "PendingCrmVerification", "Verified" })
                {
                    <option value="@v" selected="@(Model.VerificationStatus == v)">@TicketDisplay.VerificationStatusLabel(v)</option>
                }
            </select>
        </div>

        <div class="field-group">
            <label class="field-label" for="unclassified">Classification</label>
            <select class="field-select" id="unclassified" name="unclassified">
                <option value="">All</option>
                <option value="true" selected="@Model.Unclassified">Unclassified</option>
            </select>
        </div>

        @if (TicketActions.CanReviewEscalations(Model.Viewer?.Roles))
        {
            <div class="field-group">
                <label class="field-label" for="escalated">Escalation</label>
                <select class="field-select" id="escalated" name="escalated">
                    <option value="">All</option>
                    <option value="true" selected="@Model.Escalated">Escalated — unable to resolve</option>
                </select>
            </div>
        }

        <div class="field-group">
            <label class="field-label" for="createdByMe">Created by</label>
            <select class="field-select" id="createdByMe" name="createdByMe">
                <option value="">Anyone</option>
                <option value="true" selected="@Model.CreatedByMe">Created by me</option>
            </select>
        </div>
            </div>
        </div>
        <footer class="drawer__footer">
            <button type="button" class="btn btn-sm btn-ghost" data-drawer-reset>Reset</button>
            <button type="submit" class="btn btn-sm btn-gold">Apply Filters</button>
        </footer>
    </aside>

    <details class="tkt-pop" data-popover>
        <summary class="btn btn-sm tkt-pop__toggle">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.8" /><path d="M4 10h16M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
            Date
            @if (dateCount > 0) { <span class="tkt-pop__badge" aria-label="@dateCount active">@dateCount</span> }
            @Html.Raw(chevron)
        </summary>
        <div class="tkt-pop__panel" role="group" aria-label="Created date range">
            <div class="tkt-pop__grid tkt-pop__grid--dates">
                <div class="field-group">
                    <label class="field-label" for="createdFrom">Created from</label>
                    <input class="field-input" type="date" id="createdFrom" name="createdFrom" value="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="field-group">
                    <label class="field-label" for="createdTo">Created to</label>
                    <input class="field-input" type="date" id="createdTo" name="createdTo" value="@Model.CreatedTo?.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            <div class="tkt-pop__footer">
                <button type="submit" class="btn btn-sm btn-gold">Apply dates</button>
            </div>
        </div>
    </details>

    <a class="btn btn-ghost btn-sm tkt-reset @(anyActive || Model.HasDrilldown ? "" : "is-idle")" href="@Model.View.Href()" title="Reset all filters">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4v6h6M20 20v-6h-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /><path d="M20 9A8 8 0 0 0 6 6L4 10M4 15a8 8 0 0 0 14 3l2-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        Reset
    </a>
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    @* Dashboard drill-down criteria survive a re-filter on this page; the
       "Clear" action drops everything, drill-down included. The SLA and
       Assignee controls above already carry slaBreached/dueToday and
       ownerEmployeeId/inDepartmentQueue whenever they are shown. *@
    @if (!isMyView && !showAssigneeFilter && Model.OwnerEmployeeId is { } ownerEmployeeId) { <input type="hidden" name="ownerEmployeeId" value="@ownerEmployeeId" /> }
    @if (!showAssigneeFilter && Model.InDepartmentQueue) { <input type="hidden" name="inDepartmentQueue" value="true" /> }
    @if (isClosedView && Model.SlaBreached) { <input type="hidden" name="slaBreached" value="true" /> }
    @if (isClosedView && Model.DueToday) { <input type="hidden" name="dueToday" value="true" /> }
    @if (Model.DepartmentId is { } drilldownDepartmentId && Model.NameResolver.OwnDepartments.Count == 0) { <input type="hidden" name="departmentId" value="@drilldownDepartmentId" /> }
    @if (Model.Channels.Count == 0 && Model.ChannelId is { } channelId) { <input type="hidden" name="channelId" value="@channelId" /> }
    @if (Model.RequestTypeId is { } requestTypeId) { <input type="hidden" name="requestTypeId" value="@requestTypeId" /> }
    @if (Model.ActiveOnly) { <input type="hidden" name="activeOnly" value="true" /> }
    @if (Model.BacklogAge is { } backlogAge) { <input type="hidden" name="backlogAge" value="@backlogAge" /> }
    @if (Model.PendingApproval) { <input type="hidden" name="pendingApproval" value="true" /> }
    @if (Model.ClosureCategory is { } closureCategory) { <input type="hidden" name="closureCategory" value="@closureCategory" /> }
    @if (Model.ClosedFrom is { } closedFrom) { <input type="hidden" name="closedFrom" value="@closedFrom.ToString("yyyy-MM-dd")" /> }
    @if (Model.ClosedTo is { } closedTo) { <input type="hidden" name="closedTo" value="@closedTo.ToString("yyyy-MM-dd")" /> }
</form>

@if (Model.HasDrilldown)
{
    <div class="drilldown-bar" role="status">
        <span class="drilldown-bar__label">Filtered from Dashboard:</span>
        @foreach (var label in Model.DrilldownLabels)
        {
            <span class="badge badge-drilldown">@label</span>
        }
        <a class="link-muted" href="/Dashboard">Back to Dashboard</a>
    </div>
}

<div class="panel">
    <div class="panel__header">
        <span class="panel__title">@Model.View.Label()</span>
        <span class="text-secondary">@Model.TotalCount total</span>
    </div>

    @if (Model.Outcome == ApiOutcome.Unauthorized)
    {
        <div class="error-state">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
            <p>Your session is no longer valid. <a class="link-muted" href="/Logout">Sign in again</a>.</p>
        </div>
    }
    else if (Model.Outcome == ApiOutcome.Forbidden)
    {
        <div class="error-state">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
            <p>You don't have permission to view these tickets.</p>
        </div>
    }
    else if (Model.Outcome == ApiOutcome.Unreachable || Model.Outcome == ApiOutcome.BadGateway)
    {
        <div class="error-state">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
            <p>Tiger Ticketing System could not reach the ticketing service. Try again in a moment.</p>
        </div>
    }
    else if (Model.Outcome != ApiOutcome.Success)
    {
        <div class="error-state">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
            <p>Something went wrong loading the tickets.</p>
        </div>
    }
    else if (Model.Rows.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none"><rect x="5" y="4" width="14" height="16" rx="1.5" stroke="currentColor" stroke-width="1.4" /><path d="M9 9h6M9 13h6M9 17h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
            <p>No tickets match the current filters.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Ticket</th>
                        <th class="col-subject">Summary</th>
                        <th>Assigned Department</th>
                        <th>Assigned To</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        @await Html.PartialAsync("_TicketRow", row)
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="panel__footer">
        <span class="pager-range">@(Model.TotalCount == 0 ? "No records" : $"Showing {(Model.PageNumber - 1) * Model.PageSize + 1}–{Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)} of {Model.TotalCount}") <span class="pager-page">· Page @Model.PageNumber of @Model.TotalPages</span></span>
        <nav class="pagination" aria-label="Pagination">
            @if (Model.PageNumber > 1)
            {
                <a href="@PageUrl(Model.PageNumber - 1)">Prev</a>
            }
            else
            {
                <span class="is-disabled">Prev</span>
            }
            @if (Model.PageNumber < Model.TotalPages)
            {
                <a href="@PageUrl(Model.PageNumber + 1)">Next</a>
            }
            else
            {
                <span class="is-disabled">Next</span>
            }
        </nav>
    </div>
</div>
