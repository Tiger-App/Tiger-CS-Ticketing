@model TigerCS.Web.Pages.DashboardBarCard
@{
    // A compact visual summary of one breakdown (Status, Volume by Channel):
    // a single stacked bar split by share, then a legend of linked rows with
    // count and percentage. Same model, same drill-down links and same
    // width classes as the full bar card — the segment widths are stylesheet
    // classes, never inline styles (the Content-Security-Policy forbids them).
    var tone = Model.Title switch
    {
        "Volume by Channel" => "info",
        "Status" => "progress",
        _ => "info",
    };
    // A small glyph per card header, keyed on the card's title — decoration only,
    // like the tone above; the title, total and link come from the model.
    var headerIcon = Model.Title switch
    {
        "Status" => "<path d=\"M4 12h4l2-5 4 10 2-5h4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>",
        "Volume by Channel" => "<path d=\"M21 12a8 8 0 0 1-11.6 7.1L4 20l1-5.1A8 8 0 1 1 21 12Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/>",
        "Volume by Request Type" => "<path d=\"M3 12V4h8l9 9-8 8-9-9Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><circle cx=\"7.5\" cy=\"8.5\" r=\"1\" fill=\"currentColor\"/>",
        "Open Backlog Ageing" => "<circle cx=\"12\" cy=\"12\" r=\"8.5\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M12 7.5V12l3 2\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>",
        "Priority" => "<path d=\"M5 21V4M5 5h11l-2 4 2 4H5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>",
        "Volume by Department" => "<path d=\"M4 21V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v16M15 10h4a1 1 0 0 1 1 1v10M3 21h18M8 8h3M8 12h3M8 16h3\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>",
        _ => "<rect x=\"5\" y=\"4\" width=\"14\" height=\"16\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"1.8\"/>",
    };
    var slot = Model.Title == "Status" ? "status" : "channel";
    var isChannel = slot == "channel";
}
<div class="panel dash-card tone-@tone dash-card--summary dash-card--@slot">
    <div class="panel__header">
        <div class="panel__lead">
            <span class="panel__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none">@Html.Raw(headerIcon)</svg></span>
            <span class="panel__title">@Model.Title</span>
        </div>
        <a class="link-muted" href="@Model.TotalHref" title="Open the matching tickets">@Model.Total total</a>
    </div>
    @if (Model.Rows.Count == 0 || (!isChannel && Model.Total == 0 && Model.Rows.All(r => r.Count == 0)))
    {
        <div class="empty-state empty-state--compact">
            <p>@Model.EmptyText</p>
        </div>
    }
    else
    {
        @if (isChannel)
        {
            @* Volume by Channel: every channel, each with its own icon and colour. The colour class sits on a display:contents wrapper so the
               segment keeps the exact "bar-fill bar-fill--wNN" markup; the same class colours the legend icon, so bar, legend and icon always agree. *@
            <div class="summary-bar" aria-hidden="true">
                @foreach (var row in Model.Rows)
                {
                    <span class="summary-seg @DashboardChannelStyle.ColorClass(row.Key)"><span class="bar-fill @row.BarWidthClass"></span></span>
                }
            </div>
            <ul class="channel-legend">
                @foreach (var row in Model.Rows)
                {
                    <li class="channel-legend__item @DashboardChannelStyle.ColorClass(row.Key)">
                        @if (row.Href is not null)
                        {
                            <a class="channel-legend__row" href="@row.Href" title="Open these tickets">
                                <span class="channel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none">@Html.Raw(DashboardChannelStyle.Icon(row.Code))</svg></span>
                                <span class="channel-legend__text">
                                    <span class="channel-legend__label">@row.Label</span>
                                    <span class="channel-legend__figures"><strong>@row.Count</strong> <span>@row.PercentageText</span></span>
                                </span>
                            </a>
                        }
                        else
                        {
                            <span class="channel-legend__row channel-legend__row--static">
                                <span class="channel-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none">@Html.Raw(DashboardChannelStyle.Icon(row.Code))</svg></span>
                                <span class="channel-legend__text">
                                    <span class="channel-legend__label">@row.Label</span>
                                    <span class="channel-legend__figures"><strong>@row.Count</strong> <span>@row.PercentageText</span></span>
                                </span>
                            </span>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="summary-bar" aria-hidden="true">
                @foreach (var row in Model.Rows)
                {
                    <span class="bar-fill @row.BarWidthClass"></span>
                }
            </div>
            <ul class="summary-legend">
                @foreach (var (row, index) in Model.Rows.Select((r, i) => (r, i)))
                {
                    <li class="summary-legend__item summary-legend__item--@(Math.Min(index, 5))">
                        @if (row.Href is not null)
                        {
                            <a class="summary-legend__row" href="@row.Href" title="Open these tickets">
                                <span class="summary-legend__dot" aria-hidden="true"></span>
                                <span class="summary-legend__label">@row.Label</span>
                                <span class="summary-legend__count">@row.Count</span>
                                <span class="summary-legend__pct">@row.PercentageText</span>
                            </a>
                        }
                        else
                        {
                            <span class="summary-legend__row summary-legend__row--static">
                                <span class="summary-legend__dot" aria-hidden="true"></span>
                                <span class="summary-legend__label text-secondary">@row.Label</span>
                                <span class="summary-legend__count">@row.Count</span>
                                <span class="summary-legend__pct">@row.PercentageText</span>
                            </span>
                        }
                    </li>
                }
            </ul>
        }
    }
</div>
