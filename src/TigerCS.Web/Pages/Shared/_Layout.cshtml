<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Tiger Ticketing</title>
    <link rel="icon" href="~/img/logo-sm.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{ var compactShell = ViewData["CompactShell"] is true; }
    @await Html.PartialAsync("_Header")
    @if (!compactShell)
    {
        @await Html.PartialAsync("_Nav")
    }
    @if ((ViewData["ActiveNav"] as string) == "admin")
    {
        @await Html.PartialAsync("_AdminSubNav")
    }

    <main>
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
