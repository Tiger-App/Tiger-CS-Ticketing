@{
    var currentUser = CurrentUser.FromPrincipal(User);
    // CompactShell: pages that want the one-row header (brand · navigation · search · account), e.g. Ticket Details.
    var compact = ViewData["CompactShell"] is true;
}
<header class="app-header@(compact ? " app-header--shell" : "")">
    <a class="app-header__brand" href="/Dashboard" aria-label="Tiger Ticketing home">
        @await Html.PartialAsync("_BrandMark")
        <span class="brand-name">Tiger <span>Ticketing</span></span>
    </a>

    @if (compact)
    {
        @await Html.PartialAsync("_Nav")
    }

    <div class="app-header__search">
        <form class="search-field" role="search" action="/Tickets" method="get">
            <label for="header-search" class="search-field__icon" title="Search tickets"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" /><path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></label>
            <input id="header-search" type="search" name="search" placeholder="Search tickets: number, customer, phone, unit…" aria-label="Search tickets" />
        </form>
    </div>

    <div class="app-header__spacer"></div>

    @if (currentUser is not null)
    {
        <div class="app-header__actions">
            <span class="header-divider" aria-hidden="true"></span>

            <details class="disclosure">
                <summary class="avatar" aria-label="Account menu">@currentUser.Initials</summary>
                <div class="disclosure__panel">
                    <div class="disclosure__panel__header">@currentUser.DisplayName</div>
                    <div class="menu-item"><small>@string.Join(", ", currentUser.Roles)</small></div>
                    <div class="menu-divider"></div>
                    <a class="menu-item" href="/Account/ChangePassword">Change my password</a>
                    <div class="menu-divider"></div>
                    <form method="post" asp-page="/Logout">
                        <button type="submit" class="menu-item"><strong>Sign out</strong></button>
                    </form>
                </div>
            </details>
        </div>
    }
</header>
