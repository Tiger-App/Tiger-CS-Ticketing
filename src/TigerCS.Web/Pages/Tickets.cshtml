@page "/Tickets"
@model TigerCS.Web.Pages.TicketsModel
@{
    // One workspace, five views. The primary navigation has a single
    // "Tickets" item; Queue / All / Pending Interactions / My Tickets / Closed are
    // the tabs below, each a bookmarkable ?view= of this same page.
    ViewData["Title"] = Model.View == TicketsView.Queue ? "Tickets" : $"{Model.View.Label()} · Tickets";
    ViewData["ActiveNav"] = "tickets";
    Layout = "_Layout";

    // Tabs keep the filters the agent has set: each tab link carries the current
    // filter query, minus paging and the few controls a target view fixes itself
    // (My Tickets fixes the owner, Closed fixes the status). Sorting and page size
    // ride along; the page number does not, since the result set changes.
    var carriedKeys = new[]
    {
        "search", "departmentId", "priorityId", "ticketStatus", "verificationStatus", "sla", "assignee",
        "ownerEmployeeId", "inDepartmentQueue", "availableToTake", "channelId", "unclassified", "escalated",
        "createdByMe", "createdFrom", "createdTo", "sortBy", "sortDir", "pageSize",
        "mineOnly", "unassignedOnly", "includeResolved",
    };
    string TabHref(TicketsView target)
    {
        var pairs = new List<KeyValuePair<string, string?>>();
        foreach (var key in carriedKeys)
        {
            if (target == TicketsView.My && key is "ownerEmployeeId" or "assignee" or "inDepartmentQueue") continue;
            if (target == TicketsView.Closed && key is "ticketStatus" or "sla") continue;
            var value = Model.Request.Query[key].ToString();
            if (!string.IsNullOrEmpty(value)) pairs.Add(new(key, value));
        }
        if (pairs.Count == 0) return target.Href();
        var qs = string.Join("&", pairs.Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value!)}"));
        return target == TicketsView.Queue ? $"/Tickets?{qs}" : $"/Tickets?{TicketsViews.QueryKey}={target.Key()}&{qs}";
    }
}

<div class="page tickets-workspace">
    <div class="page-header">
        <div>
            <h1 class="page-title">Tickets</h1>
            <p class="page-subtitle text-secondary">
                @(Model.View switch
                {
                    TicketsView.Pending => "Customer interactions waiting for a human agent — on every channel. Genesys still delivers the reply; this list is what is waiting and who is on it.",
                    TicketsView.All => "Every ticket you can see, including Closed.",
                    TicketsView.My => "Tickets assigned to you, in every status.",
                    TicketsView.Closed => "Tickets that have been closed.",
                    _ => "Every open ticket you can see, across your departments (Closed tickets are on the All and Closed tabs)."
                })
            </p>
        </div>
        @if (Model.CanCreateTicket)
        {
            <a class="btn btn-gold" href="/NewTicket">+ New Ticket</a>
        }
    </div>

    @* The same tone vocabulary as the Dashboard's KPI row: open work is
       information, work in hand is operational, waiting on the customer is
       a warning, closed is resolved. Only Open carries the emphasis
       modifier — the one counter an agent is expected to act on. *@
    <section class="kpi-grid" aria-label="Ticket status counters">
        <div class="kpi-card tone-info kpi-card--attention">
            <strong>@(Model.OpenCount?.ToString() ?? "—")</strong>
            <span>Open</span>
        </div>
        <div class="kpi-card tone-progress">
            <strong>@(Model.InProgressCount?.ToString() ?? "—")</strong>
            <span>In Progress</span>
        </div>
        <div class="kpi-card tone-warning">
            <strong>@(Model.PendingCustomerCount?.ToString() ?? "—")</strong>
            <span>Pending Customer</span>
        </div>
        <div class="kpi-card tone-success">
            <strong>@(Model.ClosedCount?.ToString() ?? "—")</strong>
            <span>Closed</span>
        </div>
    </section>

    <nav class="view-tabs" aria-label="Ticket views">
        <ul class="view-tabs__list">
            @foreach (var view in TicketsViews.All)
            {
                var isActive = view == Model.View;
                var count = Model.TabCount(view);
                <li>
                    <a class="view-tabs__link @(isActive ? "is-active" : "")" href="@TabHref(view)" aria-current="@(isActive ? "page" : null)">
                        @view.Label()
                        @if (count is not null)
                        {
                            <span class="view-tabs__count" aria-label="@count @view.Label()">@count</span>
                        }
                    </a>
                </li>
            }
        </ul>
    </nav>

    @if (Model.View == TicketsView.Pending)
    {
        @await Html.PartialAsync("_PendingInteractionsView", Model)
    }
    else
    {
        @await Html.PartialAsync("_TicketListView", Model)
    }
</div>
