@page "/Customers/{customerKey}"
@model TigerCS.Web.Pages.CustomerProfileModel
@{
    ViewData["ActiveNav"] = "customers";
    ViewData["Title"] = Model.Profile is null ? "Customer Profile" : $"{Model.DisplayName} · Customer";
    Layout = "_Layout";
    var nowUtc = DateTime.UtcNow;
}

<div class="page customer-workspace">
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="@Model.CustomersHref">Customers</a>
        <span class="sep">/</span>
        <span class="current" data-contact-name>@Model.DisplayName</span>
    </nav>

    @if (Model.Profile is null)
    {
        <div class="panel">
            <div class="error-state">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.3 3.9 2.5 18a1.6 1.6 0 0 0 1.4 2.4h16.2a1.6 1.6 0 0 0 1.4-2.4L13.7 3.9a1.6 1.6 0 0 0-2.8 0Z" stroke="currentColor" stroke-width="1.6" /></svg>
                <p>
                    @(Model.Outcome switch
                    {
                        ApiOutcome.Forbidden => "You don't have permission to view this customer.",
                        ApiOutcome.Unauthorized => "Your session is no longer valid. Sign in again.",
                        ApiOutcome.Unreachable or ApiOutcome.BadGateway => "Tiger Ticketing System could not reach the ticketing service.",
                        _ => "This customer profile could not be loaded."
                    })
                </p>
                <a class="btn btn-sm" href="@Model.CustomersHref">Back to Customers</a>
            </div>
        </div>
    }
    else
    {
        var profile = Model.Profile;
        var crm = Model.CrmProfile;
        var primaryUnit = Model.PrimaryUnit;
        var liveUnits = crm is { Status: "Found" } ? crm.Units : null;

        <header class="customer-header">
            <div class="customer-header__identity">
                <span class="customer-header__avatar" aria-hidden="true">@TicketDisplay.Initials(Model.DisplayName)</span>
                <div class="customer-header__body">
                    <div class="customer-header__title">
                        <h1 class="customer-header__name" data-contact-name>@Model.DisplayName</h1>
                        @if (Model.CanEditContact)
                        {
                            <a class="icon-btn" href="/Customers/@Uri.EscapeDataString(Model.CustomerKey)?editContact=1" data-contact-edit-open aria-label="Edit customer name" title="Edit customer name"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 20h4L19 9a2.1 2.1 0 0 0-3-3L5 17v3Zm9-13 3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
                        }
                    </div>
                    @if (Model.CanEditContact)
                    {
                        <form method="post" asp-page-handler="EditContact" asp-route-customerKey="@Model.CustomerKey" class="contact-edit" data-contact-edit-form hidden="@(Model.EditingContact ? null : "hidden")" novalidate>
                            <div class="contact-edit__fields">
                                <label class="contact-edit__field">
                                    <span class="field-label">Customer name</span>
                                    <input class="form-control" name="name" value="@Model.Profile.DisplayName" maxlength="200" required autocomplete="off" data-contact-input-name />
                                </label>
                                <label class="contact-edit__field">
                                    <span class="field-label">Email <span class="text-secondary">(optional)</span></span>
                                    <input class="form-control" type="email" name="email" value="@Model.PrimaryEmail" maxlength="256" autocomplete="off" data-contact-input-email />
                                </label>
                            </div>
                            <div class="contact-edit__actions">
                                <button type="submit" class="btn btn-gold btn-sm" data-contact-save>Save</button>
                                <a class="btn btn-sm" href="/Customers/@Uri.EscapeDataString(Model.CustomerKey)" data-contact-edit-cancel>Cancel</a>
                                <span class="field-error" role="alert" data-contact-error>@(Model.ContactNoticeIsError ? Model.ContactNotice : null)</span>
                            </div>
                        </form>
                    }
                    @if (!Model.ContactNoticeIsError && Model.ContactNotice is { } contactNotice)
                    {
                        <p class="field-hint" role="status">@contactNotice</p>
                    }
                    <div class="customer-header__meta">
                        <span class="badge badge-source-@CustomerProfileModel.SourceCssKey(profile.VerificationSource)">
                            @(profile.IdentityKind == "Phone" ? "Unverified · phone only" : $"Verified via {CustomerProfileModel.SourceLabel(profile.VerificationSource)}")
                        </span>
                        @if (Model.PrimaryPhone is { } phone)
                        {
                            <span class="customer-header__fact"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 3h4l2 5-2.5 1.5a11 11 0 0 0 5 5L16 12l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg><span class="text-mono">@phone</span></span>
                        }
                        @if (primaryUnit is not null)
                        {
                            <span class="customer-header__fact"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 21V8l8-5 8 5v13M9 21v-6h6v6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>@(primaryUnit.UnitNumber ?? "—")@(primaryUnit.ProjectName is null ? "" : $" · {primaryUnit.ProjectName}")@(profile.Units.Count > 1 ? $" · +{profile.Units.Count - 1} more" : "")</span>
                        }
                        @if (profile.CrmBuyerCustomerId is { } crmId)
                        {
                            <span class="customer-header__fact id-fallback">CRM #@crmId</span>
                        }
                        else if (profile.ExternalCustomerId is { } externalId)
                        {
                            <span class="customer-header__fact id-fallback">@CustomerProfileModel.SourceLabel(profile.VerificationSource) ID @externalId</span>
                        }
                    </div>
                </div>
            </div>
            <div class="customer-header__actions">
                @if (Model.FromTicketId is { } fromTicketId)
                {
                    <a class="btn btn-ghost" href="/Tickets/@fromTicketId">← Back to @(Model.FromTicketNumber ?? "ticket")</a>
                }
                <a class="btn" href="@Model.CustomersHref">All customers</a>
                @if (Model.CanEditCustomer)
                {
                    <a class="btn" href="/Customers/@Uri.EscapeDataString(Model.CustomerKey)?edit=1@(Model.FromTicketId is { } editFrom ? $"&fromTicket={editFrom}" : "")#edit-customer" data-edit-customer-open>
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" width="14" height="14"><path d="M4 20h4L19 9a2.1 2.1 0 0 0-3-3L5 17v3Zm9-13 3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        Edit Customer
                    </a>
                }
                @if (Model.CanCreateTicket)
                {
                    <a class="btn btn-gold" href="@Model.NewTicketHref">+ New Ticket</a>
                }
            </div>
        </header>

        @if (Model.EditNotice is { } editNotice)
        {
            <div class="alert @(Model.EditNoticeIsError ? "alert-error" : "alert-success")" role="@(Model.EditNoticeIsError ? "alert" : "status")" data-edit-notice><span>@editNotice</span></div>
        }

        @* The form is only rendered when asked for (the Edit Customer button opens ?edit=1): a closed copy would be a second, redundant
           button. Without JavaScript the link is the whole mechanism. *@
        @if (Model.CanEditCustomer && Model.EditingCustomer)
        {
            var details = profile.Details;
            var edit = profile.Edit;
            <details class="panel edit-customer" id="edit-customer" open="@(Model.EditingCustomer ? "open" : null)" data-edit-customer>
                <summary class="edit-customer__summary">Edit Customer</summary>
                <form method="post" asp-page-handler="EditCustomer" asp-route-customerKey="@Model.CustomerKey" class="edit-customer__form" novalidate>
                    <input type="hidden" name="operationId" value="@Model.NewOperationId" />
                    <input type="hidden" name="relatedTicketId" value="@Model.RelatedTicketId" />
                    <p class="field-hint">
                        Saved in Tiger Ticketing only. Nothing is sent to Tiger CRM, PACT or Tasleeh@(profile.IdentityKind == "Phone" ? "" : ", whose record of this customer is unchanged"), and no ticket changes - tickets keep the details they were raised with.
                        @(profile.IdentityKind == "Phone" ? "This customer is unverified (identified by phone only)." : $"This customer is verified via {CustomerProfileModel.SourceLabel(profile.VerificationSource)}; the verification is not affected.")
                        Every change is recorded in the change history.
                    </p>
                    <div class="two-col">
                        <div>
                            <div class="field-group">
                                <label class="field-label" for="edit-fullName">Full name</label>
                                <input class="field-input" id="edit-fullName" name="fullName" value="@(details?.FullName ?? profile.DisplayName)" maxlength="200" autocomplete="off" data-edit-full-name />
                            </div>
                            <div class="field-group">
                                <label class="field-label" for="edit-phoneNumber">Mobile number</label>
                                <input class="field-input" id="edit-phoneNumber" name="phoneNumber" type="tel" value="@(edit?.PhoneNumber ?? Model.PrimaryPhone)" autocomplete="off" placeholder="+971 50 123 4567" data-edit-mobile />
                                <span class="field-hint">With its country code, e.g. +971 50 123 4567; a UAE number may be written locally (050 123 4567).</span>
                            </div>
                            <div class="field-group">
                                <label class="field-label" for="edit-landlineNumber">Landline number</label>
                                <input class="field-input" id="edit-landlineNumber" name="landlineNumber" type="tel" value="@details?.LandlineNumber" autocomplete="off" placeholder="+971 4 123 4567" data-edit-landline />
                                <span class="field-hint">UAE landlines start 02, 03, 04, 06, 07 or 09 (+971 2, 3, 4, 6, 7, 9).</span>
                            </div>
                            <div class="field-group">
                                <label class="field-label" for="edit-additionalPhones">Additional phone numbers</label>
                                <textarea class="field-input" id="edit-additionalPhones" name="additionalPhones" rows="3" data-edit-additional>@string.Join("\n", details?.AdditionalPhones ?? [])</textarea>
                                <span class="field-hint">One per line. Remove a line to remove that number.</span>
                            </div>
                            <div class="field-group">
                                <label class="field-label" for="edit-email">Email address</label>
                                <input class="field-input" id="edit-email" name="email" type="email" value="@(details?.Email ?? Model.PrimaryEmail)" maxlength="256" autocomplete="off" data-edit-email />
                            </div>
                        </div>
                        <div>
                            <div class="field-group">
                                <label class="field-label" for="edit-nationality">Nationality</label>
                                <input class="field-input" id="edit-nationality" name="nationality" value="@details?.Nationality" maxlength="100" autocomplete="off" data-edit-nationality />
                            </div>
                            <div class="field-group">
                                <label class="field-label" for="edit-country">Country of residence</label>
                                <input class="field-input" id="edit-country" name="country" value="@details?.Country" maxlength="100" autocomplete="off" data-edit-country />
                                <span class="field-hint">Where the customer lives. This is separate from the country of their phone number.</span>
                            </div>
                            <div class="field-group">
                                <label class="field-label" for="edit-emirate">Emirate</label>
                                <select class="field-input" id="edit-emirate" name="emirate" data-edit-emirate>
                                    <option value="">Not stated</option>
                                    @foreach (var emirate in TigerCS.Application.Modules.Ticketing.Services.CustomerProfileEditAppService.Emirates)
                                    {
                                        <option value="@emirate" selected="@(string.Equals(details?.Emirate, emirate, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@emirate</option>
                                    }
                                </select>
                                <span class="field-hint">Only what the customer states - never worked out from a phone number.</span>
                            </div>
                            <div class="field-group">
                                <label class="field-label" for="edit-location">Location</label>
                                <input class="field-input" id="edit-location" name="location" value="@details?.Location" maxlength="200" autocomplete="off" placeholder="Area, building or city" data-edit-location />
                            </div>
                            <div class="field-group">
                                <label class="field-label" for="edit-preferredLanguage">Preferred language</label>
                                <input class="field-input" id="edit-preferredLanguage" name="preferredLanguage" value="@details?.PreferredLanguage" list="edit-languages" maxlength="100" autocomplete="off" data-edit-language />
                                <datalist id="edit-languages"><option value="Arabic"></option><option value="English"></option><option value="Hindi"></option><option value="Urdu"></option><option value="Russian"></option><option value="Chinese"></option></datalist>
                            </div>
                            <div class="field-group">
                                <label class="field-label" for="edit-reason">Reason for the change <span class="text-secondary">(optional)</span></label>
                                <input class="field-input" id="edit-reason" name="reason" maxlength="500" autocomplete="off" data-edit-reason />
                            </div>
                        </div>
                    </div>
                    <div class="contact-edit__actions">
                        <button type="submit" class="btn btn-gold btn-sm" data-edit-customer-save>Save changes</button>
                        <a class="btn btn-sm" href="/Customers/@Uri.EscapeDataString(Model.CustomerKey)@(Model.FromTicketId is { } cancelFrom ? $"?fromTicket={cancelFrom}" : "")">Cancel</a>
                    </div>
                </form>
            </details>
        }

        <section class="kpi-grid" aria-label="Customer counters">
            <div class="kpi-card @(profile.OpenTickets > 0 ? "kpi-card--attention" : "")">
                <strong>@profile.OpenTickets</strong>
                <span>Open Tickets</span>
            </div>
            <div class="kpi-card">
                <strong>@profile.TotalTickets</strong>
                <span>Total Tickets</span>
            </div>
            <div class="kpi-card">
                <strong>@(liveUnits?.Count ?? profile.Units.Count)</strong>
                <span>Units</span>
            </div>
            <div class="kpi-card">
                <strong>@TicketDisplay.AgoLabel(profile.LastSeenAtUtc, nowUtc)</strong>
                <span>Last Ticket</span>
            </div>
            <div class="kpi-card">
                <strong>@(profile.Interactions.Count > 0 ? TicketDisplay.AgoLabel(profile.Interactions[0].StartedAtUtc, nowUtc) : "—")</strong>
                <span>Last Interaction</span>
            </div>
        </section>

        <div class="tabs-card tabs-card--page">
            <input type="radio" name="customerProfileTab" id="tab-overview" class="tab-input" checked="@(!Model.PaymentTabActive && !Model.DocumentsTabActive && !Model.UnitsTabActive && !Model.HistoryTabActive)" />
            <label class="tab-label" for="tab-overview">Overview</label>
            <input type="radio" name="customerProfileTab" id="tab-contact" class="tab-input" />
            <label class="tab-label" for="tab-contact">Contact Info</label>
            <input type="radio" name="customerProfileTab" id="tab-units" class="tab-input" checked="@Model.UnitsTabActive" />
            <label class="tab-label" for="tab-units">Units <span class="tab-count">@(liveUnits?.Count ?? profile.Units.Count)</span></label>
            <input type="radio" name="customerProfileTab" id="tab-history" class="tab-input" />
            <label class="tab-label" for="tab-history">Tickets <span class="tab-count">@profile.TotalTickets</span></label>
            <input type="radio" name="customerProfileTab" id="tab-interactions" class="tab-input" />
            <label class="tab-label" for="tab-interactions">Interactions <span class="tab-count">@profile.Interactions.Count</span></label>
            <input type="radio" name="customerProfileTab" id="tab-payment" class="tab-input" checked="@Model.PaymentTabActive" />
            <label class="tab-label" for="tab-payment">Payment</label>
            <input type="radio" name="customerProfileTab" id="tab-documents" class="tab-input" checked="@Model.DocumentsTabActive" />
            <label class="tab-label" for="tab-documents">Documents</label>
            @if (Model.CanViewHistory)
            {
                <input type="radio" name="customerProfileTab" id="tab-changes" class="tab-input" checked="@Model.HistoryTabActive" />
                <label class="tab-label" for="tab-changes">Change History @if (Model.History is not null) { <span class="tab-count">@Model.History.TotalCount</span> }</label>
            }

            <div class="tabs-body">
                @* ---- Overview ---- *@
                <div class="tab-panel" id="panel-overview">
                    <div class="two-col">
                        <div class="facts-panel facts-panel--flat">
                            <div class="facts-section__title">Customer</div>
                            <dl>
                                <div class="facts-row"><dt>Customer Name</dt><dd data-contact-name>@Model.DisplayName</dd></div>
                                <div class="facts-row"><dt>Phone</dt><dd class="text-mono">@(Model.PrimaryPhone ?? "—")</dd></div>
                                <div class="facts-row"><dt>Verification</dt><dd>@(profile.IdentityKind == "Phone" ? "Unverified" : $"Verified via {CustomerProfileModel.SourceLabel(profile.VerificationSource)}")</dd></div>
                                @if (profile.CrmBuyerCustomerId is { } overviewCrmId)
                                {
                                    <div class="facts-row"><dt>CRM Customer ID</dt><dd class="id-fallback">#@overviewCrmId</dd></div>
                                }
                                @if (profile.ExternalCustomerId is { } overviewExternalId)
                                {
                                    <div class="facts-row"><dt>@CustomerProfileModel.SourceLabel(profile.VerificationSource) Customer ID</dt><dd class="id-fallback">@overviewExternalId</dd></div>
                                }
                                <div class="facts-row"><dt>Primary unit</dt><dd>@(primaryUnit is null ? "—" : $"{primaryUnit.UnitNumber ?? "—"}{(primaryUnit.ProjectName is null ? "" : $" · {primaryUnit.ProjectName}")}")</dd></div>
                                <div class="facts-row"><dt>Customer since</dt><dd>@profile.FirstSeenAtUtc.ToUae().ToString("MMM d, yyyy")</dd></div>
                            </dl>
                        </div>
                        <div class="facts-panel facts-panel--flat">
                            <div class="facts-section__title">Recent tickets</div>
                            @if (profile.Tickets.Count == 0)
                            {
                                <div class="empty-state empty-state--compact"><p>No tickets yet.</p></div>
                            }
                            else
                            {
                                <ul class="mini-list">
                                    @foreach (var recent in profile.Tickets.Take(5))
                                    {
                                        <li class="mini-list__row">
                                            <a class="ticket-id-link" href="/Tickets/@recent.TicketId">@recent.TicketNumber</a>
                                            <span class="mini-list__text cell-truncate">@recent.RequestSummary</span>
                                            <span class="badge badge-status-@TicketDisplay.TicketStatusCssKey(recent.TicketStatus)"><span class="badge-dot"></span>@TicketDisplay.TicketStatusLabel(recent.TicketStatus)</span>
                                        </li>
                                    }
                                </ul>
                                @if (profile.Tickets.Count > 5)
                                {
                                    <label class="link-muted tab-jump" for="tab-history">View all @profile.TotalTickets tickets</label>
                                }
                            }
                        </div>
                    </div>
                </div>

                @* ---- Contact Info ---- *@
                <div class="tab-panel" id="panel-contact">
                    @if (profile.IdentityKind == "Crm" && crm is not { Status: "Found" })
                    {
                        <div class="alert alert-info" role="status"><span>@(crm is null ? "Live CRM data is unavailable right now — showing what TigerCS has on record." : TicketDisplay.CustomerProfileStatusMessage(crm.Status))</span></div>
                    }
                    <div class="two-col">
                        <div class="facts-panel facts-panel--flat">
                            <div class="facts-section__title">Identity</div>
                            <dl>
                                @* The best real name available: CRM's live record, else the name
                                   persisted at ticket time (the CRM Buyer snapshot, the verifying
                                   source's own customerName, or what a conversation captured).
                                   Arabic comes from CRM alone — PACT and Tasleeh have no Arabic
                                   name field, so it stays blank rather than repeating the English
                                   name in an Arabic row. *@
                                <div class="facts-row"><dt>Full Name English</dt><dd data-contact-name>@(profile.DisplayName ?? crm?.FullNameEnglish ?? "—")</dd></div>
                                <div class="facts-row"><dt>Full Name Arabic</dt><dd>@(crm?.FullNameArabic ?? "—")</dd></div>
                                <div class="facts-row"><dt>Verification source</dt><dd>@(profile.IdentityKind == "Phone" ? "None — identified by phone" : CustomerProfileModel.SourceLabel(profile.VerificationSource))</dd></div>
                                @if (profile.CrmBuyerCustomerId is { } contactCrmId)
                                {
                                    <div class="facts-row"><dt>CRM Customer ID</dt><dd class="id-fallback">#@contactCrmId</dd></div>
                                }
                                @if (profile.ExternalCustomerId is { } contactExternalId)
                                {
                                    <div class="facts-row"><dt>@CustomerProfileModel.SourceLabel(profile.VerificationSource) Customer ID</dt><dd class="id-fallback">@contactExternalId</dd></div>
                                }
                            </dl>
                        </div>
                        <div class="facts-panel facts-panel--flat">
                            <div class="facts-section__title">Reach</div>
                            <dl>
                                @* One row per real contact point. "Also called from" is only for a
                                   genuinely different number: the model compares canonically, so
                                   "+971509724162" and "971509724162" are never listed as two. *@
                                <div class="facts-row"><dt>Mobile Number</dt><dd class="text-mono">@(Model.PrimaryPhone ?? "—")</dd></div>
                                @foreach (var otherPhone in Model.OtherPhones)
                                {
                                    <div class="facts-row"><dt>Also called from</dt><dd class="text-mono">@otherPhone</dd></div>
                                }
                                <div class="facts-row"><dt>Email</dt><dd data-contact-email>@(Model.PrimaryEmail ?? "—")</dd></div>
                                @foreach (var otherEmail in Model.OtherEmails)
                                {
                                    <div class="facts-row"><dt>Other email</dt><dd>@otherEmail</dd></div>
                                }
                            </dl>
                            <p class="field-hint">Phone numbers and emails are the ones captured on this customer's intakes and conversations@(crm is { Status: "Found" } ? ", with the CRM record first" : "").</p>
                        </div>
                    </div>
                    @if (profile.Details is { } more)
                    {
                        <div class="facts-panel facts-panel--flat" data-profile-details>
                            <div class="facts-section__title">Profile details <span class="badge badge-neutral">Saved in Tiger Ticketing</span></div>
                            <dl>
                                <div class="facts-row"><dt>Landline Number</dt><dd class="text-mono" data-detail="landline">@(more.LandlineNumber ?? "—")</dd></div>
                                @foreach (var additional in more.AdditionalPhones)
                                {
                                    <div class="facts-row"><dt>Additional phone</dt><dd class="text-mono">@additional</dd></div>
                                }
                                <div class="facts-row"><dt>Nationality</dt><dd data-detail="nationality">@(more.Nationality ?? "—")</dd></div>
                                <div class="facts-row"><dt>Country of residence</dt><dd data-detail="country">@(more.Country ?? "—")</dd></div>
                                <div class="facts-row"><dt>Emirate</dt><dd data-detail="emirate">@(more.Emirate ?? "—")</dd></div>
                                <div class="facts-row"><dt>Location</dt><dd data-detail="location">@(more.Location ?? "—")</dd></div>
                                <div class="facts-row"><dt>Preferred language</dt><dd data-detail="language">@(more.PreferredLanguage ?? "—")</dd></div>
                            </dl>
                        </div>
                    }
                </div>

                @* ---- Units ---- *@
                <div class="tab-panel" id="panel-units">
                    @if (liveUnits is not null)
                    {
                        <p class="panel-intro">Eligible units on the customer's CRM Buyer record.</p>
                        @if (liveUnits.Count == 0)
                        {
                            <div class="empty-state"><p>No eligible units found on the CRM record.</p></div>
                        }
                        else
                        {
                            <div class="table-scroll">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>Project</th>
                                            <th>Unit Number</th>
                                            <th>Lead Status</th>
                                            <th>Unit Type</th>
                                            <th>Floor</th>
                                            <th class="col-num">Tickets</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var unit in liveUnits)
                                        {
                                            var ticketsForUnit = profile.Units.FirstOrDefault(u => u.CrmBuyerUnitId == unit.UnitId
                                                || string.Equals(u.UnitNumber, unit.UnitNumber, StringComparison.OrdinalIgnoreCase))?.TicketCount ?? 0;
                                            <tr>
                                                <td>@(unit.ProjectName ?? "—")</td>
                                                <td class="cell-primary">@(unit.UnitNumber ?? "—") <span class="badge badge-source-crm" data-unit-status="verified" title="On the customer's Tiger CRM record">Verified · CRM</span></td>
                                                <td>@(unit.LeadStatusName ?? unit.LeadStatus.ToString())</td>
                                                <td><span class="id-fallback">Type #@unit.UnitType</span></td>
                                                <td>@(unit.FloorNumber?.ToString() ?? "—")</td>
                                                <td class="col-num"><span class="count-pill">@ticketsForUnit</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else if (profile.Units.Count == 0)
                    {
                        <div class="empty-state"><p>No unit or property has been recorded on this customer's tickets.</p></div>
                    }
                    else
                    {
                        <p class="panel-intro">Units and properties this customer's tickets were raised for@(profile.IdentityKind == "Crm" ? " (live CRM unit data is unavailable right now)" : "").</p>
                        <div class="table-scroll">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Project</th>
                                        <th>Unit Number</th>
                                        <th>Source</th>
                                        <th class="col-num">Tickets</th>
                                        <th>Last Ticket</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var unit in profile.Units)
                                    {
                                        <tr>
                                            <td>@(unit.ProjectName ?? "—")</td>
                                            <td class="cell-primary">@(unit.UnitNumber ?? "—")
                                                @if (unit.Source is "Manual" or "Edited")
                                                {
                                                    <span class="badge badge-neutral" data-unit-status="manual" title="Entered by hand, not verified">@(unit.Source == "Edited" ? "Edited" : "Manual entry")</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-source-@CustomerProfileModel.SourceCssKey(unit.Source)" data-unit-status="verified" title="Confirmed by @TicketDisplay.LookupSourceLabel(unit.Source)">Verified · @TicketDisplay.LookupSourceLabel(unit.Source)</span>
                                                }
                                            </td>
                                            <td>@(unit.Source == "Manual" ? "Manual entry" : $"{TicketDisplay.LookupSourceLabel(unit.Source)}{(unit.ExternalUnitId is null ? "" : $" · {unit.ExternalUnitId}")}")</td>
                                            <td class="col-num"><span class="count-pill">@unit.TicketCount</span></td>
                                            <td class="text-secondary text-mono">@unit.LastTicketAtUtc.ToUae().ToString("MMM d, yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @* ---- Properties added by hand: never verified ownership ---- *@
                    <section class="manual-properties" id="manual-properties" data-manual-properties>
                        <div class="facts-section__title">Properties added manually <span class="badge badge-neutral">Manually added</span></div>
                        <p class="field-hint">Added in Tiger Ticketing by an employee. These are <strong>not verified ownership</strong>: nothing is written to Tiger CRM, PACT or Tasleeh, and the verified units above are unaffected. @(profile.Units.Any(u => u.Source is not ("Manual" or "Edited")) ? "Units shown above as CRM or PACT / Tasleeh are verified." : "")</p>
                        @{ var manual = profile.ManualProperties ?? []; }
                        @if (manual.Count == 0)
                        {
                            <div class="empty-state empty-state--compact"><p>No properties have been added manually.</p></div>
                        }
                        else
                        {
                            <div class="table-scroll">
                                <table class="data-table" data-manual-properties-table>
                                    <thead>
                                        <tr><th>Project</th><th>Unit</th><th>Relationship</th><th>Status</th>@if (Model.CanEditCustomer) { <th></th> }</tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var property in manual)
                                        {
                                            <tr data-property-id="@property.AssociationId">
                                                <td>@property.ProjectName</td>
                                                <td class="cell-primary">@property.UnitNumber</td>
                                                <td>@property.Relationship</td>
                                                <td><span class="badge badge-neutral" data-property-status="manual">Manually added</span></td>
                                                @if (Model.CanEditCustomer)
                                                {
                                                    <td class="col-actions">
                                                        <details class="inline-edit">
                                                            <summary class="btn btn-sm">Edit</summary>
                                                            <form method="post" asp-page-handler="UpdateProperty" asp-route-customerKey="@Model.CustomerKey">
                                                                <input type="hidden" name="associationId" value="@property.AssociationId" />
                                                                <input type="hidden" name="operationId" value="@Guid.NewGuid()" />
                                                                <input type="hidden" name="relatedTicketId" value="@Model.RelatedTicketId" />
                                                                <input class="field-input" name="projectName" value="@property.ProjectName" list="property-projects" aria-label="Project" required />
                                                                <input class="field-input" name="unitNumber" value="@property.UnitNumber" aria-label="Unit" required />
                                                                <select class="field-input" name="relationship" aria-label="Relationship">
                                                                    @foreach (var relationship in new[] { "Owner", "Tenant", "Representative" })
                                                                    {
                                                                        <option value="@relationship" selected="@(property.Relationship == relationship ? "selected" : null)">@relationship</option>
                                                                    }
                                                                </select>
                                                                <button type="submit" class="btn btn-gold btn-sm">Save</button>
                                                            </form>
                                                        </details>
                                                        <details class="inline-edit">
                                                            <summary class="btn btn-sm">Remove</summary>
                                                            <form method="post" asp-page-handler="RemoveProperty" asp-route-customerKey="@Model.CustomerKey">
                                                                <input type="hidden" name="associationId" value="@property.AssociationId" />
                                                                <input type="hidden" name="operationId" value="@Guid.NewGuid()" />
                                                                <input type="hidden" name="relatedTicketId" value="@Model.RelatedTicketId" />
                                                                <span class="field-hint">Removes this manual association only.</span>
                                                                <button type="submit" class="btn btn-sm">Confirm remove</button>
                                                            </form>
                                                        </details>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (Model.CanEditCustomer)
                        {
                            <form method="post" asp-page-handler="AddProperty" asp-route-customerKey="@Model.CustomerKey" class="property-add" data-add-property>
                                <input type="hidden" name="operationId" value="@Model.NewOperationId" />
                                <input type="hidden" name="relatedTicketId" value="@Model.RelatedTicketId" />
                                <div class="facts-section__title">Add a property</div>
                                <div class="field-group">
                                    <label class="field-label" for="property-project">Project</label>
                                    <input class="field-input" id="property-project" name="projectName" list="property-projects" autocomplete="off" required />
                                    <datalist id="property-projects">
                                        @foreach (var project in Model.ProjectOptions) { <option value="@project"></option> }
                                    </datalist>
                                </div>
                                <div class="field-group">
                                    <label class="field-label" for="property-unit">Unit</label>
                                    <input class="field-input" id="property-unit" name="unitNumber" autocomplete="off" required />
                                    <span class="field-hint">Type the unit number. A unit the project already knows is matched to it; a new one is accepted as entered.</span>
                                </div>
                                <div class="field-group">
                                    <label class="field-label" for="property-relationship">Relationship</label>
                                    <select class="field-input" id="property-relationship" name="relationship" required>
                                        <option value="">Choose…</option>
                                        <option value="Owner">Owner</option>
                                        <option value="Tenant">Tenant</option>
                                        <option value="Representative">Representative</option>
                                    </select>
                                </div>
                                <div class="field-group">
                                    <label class="field-label" for="property-reason">Reason <span class="text-secondary">(optional)</span></label>
                                    <input class="field-input" id="property-reason" name="reason" maxlength="500" autocomplete="off" />
                                </div>
                                <button type="submit" class="btn btn-gold btn-sm">Add property</button>
                            </form>
                        }
                    </section>
                </div>

                @* ---- Tickets ---- *@
                <div class="tab-panel" id="panel-history">
                    @if (profile.IdentityKind == "Phone")
                    {
                        <p class="badge badge-verification-unverified">Unverified — tickets grouped by the caller's phone number</p>
                    }
                    @if (profile.Tickets.Count == 0)
                    {
                        <div class="empty-state"><p>No tickets found for this customer.</p></div>
                    }
                    else
                    {
                        <div class="table-scroll">
                            <table class="data-table data-table--clickable">
                                <thead>
                                    <tr>
                                        <th>Ticket</th>
                                        <th class="col-subject">Summary</th>
                                        <th>Status</th>
                                        <th>Priority</th>
                                        <th>Department</th>
                                        <th>Created</th>
                                        <th>Unit</th>
                                        <th>Last activity</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in profile.Tickets)
                                    {
                                        var isFinished = !CustomerProfileModel.IsActive(row.TicketStatus);
                                        <tr class="is-link" data-href="/Tickets/@row.TicketId">
                                            <td><a class="ticket-id-link" href="/Tickets/@row.TicketId">@row.TicketNumber</a></td>
                                            <td class="col-subject"><span class="cell-truncate">@row.RequestSummary</span></td>
                                            <td><span class="badge badge-status-@TicketDisplay.TicketStatusCssKey(row.TicketStatus)"><span class="badge-dot"></span>@TicketDisplay.TicketStatusLabel(row.TicketStatus)</span></td>
                                            <td><span class="badge badge-priority-@TicketDisplay.PriorityCssKey(row.PriorityId)">@TicketDisplay.PriorityLabel(row.PriorityId)</span></td>
                                            <td>@TicketDisplay.AssignedDepartmentLabel(row.CurrentDepartmentId, Model.NameResolver.TryGetDepartmentName(row.CurrentDepartmentId))</td>
                                            <td class="text-secondary text-mono">@row.CreatedAtUtc.ToUae().ToString("MMM d, yyyy")</td>
                                            <td>@(row.UnitNumber ?? "—")@(row.ProjectName is null ? "" : $" · {row.ProjectName}")</td>
                                            <td class="text-secondary" title="@row.LastActivityAtUtc.ToUae().ToString("MMM d, yyyy HH:mm")">@TicketDisplay.AgoLabel(row.LastActivityAtUtc, nowUtc)</td>
                                            <td class="col-actions"><a class="btn btn-sm" href="/Tickets/@row.TicketId">@(isFinished ? "View" : "Open")</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                @* ---- Interactions ---- *@
                <div class="tab-panel" id="panel-interactions">
                    @if (profile.Interactions.Count == 0)
                    {
                        <div class="empty-state"><p>No calls or chats are recorded for this customer.</p></div>
                    }
                    else
                    {
                        <div class="table-scroll">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>When</th>
                                        <th>Channel</th>
                                        <th>Direction</th>
                                        <th>Ticket</th>
                                        <th>Agent</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var interaction in profile.Interactions)
                                    {
                                        <tr>
                                            <td class="text-mono">@interaction.StartedAtUtc.ToUae().ToString("MMM d, yyyy HH:mm")</td>
                                            <td>@(interaction.ChannelName ?? "Unknown channel")@if (interaction.IsOriginatingInteraction) { <span class="badge badge-neutral">Originating</span> }</td>
                                            <td>@(interaction.Direction ?? "—")</td>
                                            <td><a class="ticket-id-link" href="/Tickets/@interaction.TicketId">@interaction.TicketNumber</a></td>
                                            <td>@(interaction.AgentName ?? "—")</td>
                                            <td>@(interaction.Status == "Ended" ? "Ended" : "Active")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                @* ---- Payment ---- *@
                @* Rendered here only for ?tab=payment (no-JS path, account selector,
                   return from Send Reminder); otherwise a loading placeholder that
                   site.js replaces with ?handler=PaymentPanel when the tab opens. *@
                <div class="tab-panel" id="panel-payment" data-payment-src="/Customers/@Uri.EscapeDataString(Model.CustomerKey)?handler=PaymentPanel">
                    <span id="payment" class="anchor-target"></span>
                    <partial name="_CustomerPaymentTab" model="Model.PaymentPanel" />
                </div>

                @* ---- Documents ---- *@
                @* Same pattern as Payment: a loading placeholder that site.js replaces with ?handler=DocumentsPanel when the tab
                   opens (and again, with the previous documents cleared first, when the unit changes), or the panel rendered here
                   for ?tab=documents (no-JS path, unit selector, return from Send to customer). *@
                <div class="tab-panel" id="panel-documents" data-documents-src="/Customers/@Uri.EscapeDataString(Model.CustomerKey)?handler=DocumentsPanel">
                    <span id="documents" class="anchor-target"></span>
                    <partial name="_CustomerDocumentsTab" model="Model.DocumentsPanel" />
                </div>

                @* ---- Change History: who changed which detail, from what to what. Personal data: only for Customers.ViewHistory. ---- *@
                @if (Model.CanViewHistory)
                {
                    <div class="tab-panel" id="panel-changes" data-change-history>
                        <p class="panel-intro">Every change to this customer's details, newest first. <span class="timeline-zone">All times in @TicketDisplay.ActivityTimeZoneLabel</span></p>
                        @if (Model.History is null)
                        {
                            <p class="field-hint" data-history-unavailable>The change history is unavailable right now. Reload the page to retry.</p>
                        }
                        else if (Model.History.Items.Count == 0)
                        {
                            <div class="empty-state"><p>No changes have been recorded for this customer.</p></div>
                        }
                        else
                        {
                            <ol class="timeline" data-change-timeline>
                                @foreach (var operation in Model.History.Items.GroupBy(i => i.CorrelationId))
                                {
                                    var first = operation.First();
                                    <li class="timeline-item" data-change-operation>
                                        <span class="timeline-icon icon-info"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" fill="currentColor" /></svg></span>
                                        <div class="timeline-row">
                                            <span class="timeline-text">
                                                <strong data-modified-by>@first.ModifiedByName</strong>
                                                <small class="timeline-actor-type">(@first.Source)</small>
                                                @if (first.RelatedTicketId is { } relatedTicket)
                                                {
                                                    <text> &mdash; from ticket <a class="ticket-id-link" href="/Tickets/@relatedTicket">#@relatedTicket</a></text>
                                                }
                                            </span>
                                            <span class="timeline-time">@TicketDisplay.UaeDateTime(first.ModifiedAtUtc)</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(first.Reason))
                                        {
                                            <div class="timeline-detail">Reason: @first.Reason</div>
                                        }
                                        <div class="table-scroll">
                                            <table class="data-table data-table--compact">
                                                <thead><tr><th>Changed field</th><th>Old value</th><th>New value</th></tr></thead>
                                                <tbody>
                                                    @foreach (var change in operation)
                                                    {
                                                        <tr data-change-field="@change.Field">
                                                            <td class="cell-primary">@change.FieldLabel</td>
                                                            <td data-old-value>@(change.OldValue ?? "—")</td>
                                                            <td data-new-value>@(change.NewValue ?? "—")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </li>
                                }
                            </ol>
                            @if (Model.History.TotalCount > Model.History.PageSize)
                            {
                                var pages = (int)Math.Ceiling(Model.History.TotalCount / (double)Model.History.PageSize);
                                <nav class="pager" aria-label="Change history pages">
                                    @if (Model.History.Page > 1) { <a class="btn btn-sm" href="/Customers/@Uri.EscapeDataString(Model.CustomerKey)?tab=history&historyPage=@(Model.History.Page - 1)">Newer</a> }
                                    <span class="field-hint">Page @Model.History.Page of @pages</span>
                                    @if (Model.History.Page < pages) { <a class="btn btn-sm" href="/Customers/@Uri.EscapeDataString(Model.CustomerKey)?tab=history&historyPage=@(Model.History.Page + 1)">Older</a> }
                                </nav>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>
