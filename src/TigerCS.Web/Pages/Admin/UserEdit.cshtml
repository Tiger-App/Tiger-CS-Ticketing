@page "/Admin/Users/{id?}"
@model TigerCS.Web.Pages.Admin.UserEditModel
@{
    ViewData["Title"] = Model.IsNew ? "Add User" : "Manage User";
    ViewData["ActiveNav"] = "admin";
    ViewData["AdminSection"] = "users";
    Layout = "_Layout";
    var module = AdminModules.Users;
    var u = Model.UserRecord;
}

<div class="page admin-page @module.Tone">
    @await Html.PartialAsync("_AdminCrumbs", (module.Key, Model.IsNew ? "Add User" : u?.DisplayName ?? "User"))

    @if (Model.IsNew)
    {
        <header class="admin-head">
            <div class="admin-head__main">
                @await Html.PartialAsync("_AdminEyebrow", module.Key)
                <h1 class="page-title">Add User</h1>
                <p class="page-subtitle">Creates the sign-in account and the employee profile in one step. The initial password must satisfy the system's password policy.</p>
            </div>
            <div class="admin-head__actions">
                <a class="btn" href="/Admin/Users">Cancel</a>
            </div>
        </header>

        <div class="admin-grid admin-grid--list-form">
            <section class="panel panel--tone admin-form-panel" aria-labelledby="new-user-title">
                <div class="panel__header"><h2 class="panel__title" id="new-user-title">New account</h2></div>
                <form method="post" asp-page-handler="Create" class="admin-form" data-password-form>
                    @await Html.PartialAsync("_AdminMessages", Model)

                    <fieldset class="form-section">
                        <legend class="form-section__title">Identity</legend>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" asp-for="Create.DisplayName">Display name *</label>
                                <input class="form-control" asp-for="Create.DisplayName" required aria-required="true" autocomplete="off" />
                                <span class="field-hint">Shown on tickets, assignments and the audit trail.</span>
                            </div>
                            <div class="form-group">
                                <label class="form-label" asp-for="Create.UserName">User name *</label>
                                <input class="form-control" asp-for="Create.UserName" required aria-required="true" autocomplete="off" />
                                <span class="field-hint">Used to sign in. Cannot be changed later.</span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" asp-for="Create.Email">E-mail</label>
                                <input class="form-control" asp-for="Create.Email" type="email" autocomplete="off" />
                            </div>
                            <div class="form-group">
                                <label class="form-label" asp-for="Create.PrimaryDepartmentId">Primary department</label>
                                <select class="form-control" asp-for="Create.PrimaryDepartmentId">
                                    <option value="">No department yet</option>
                                    @foreach (var d in Model.ActiveDepartments)
                                    {
                                        <option value="@d.DepartmentId">@d.Name</option>
                                    }
                                </select>
                                <span class="field-hint">More departments can be added after the account exists.</span>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="form-section">
                        <legend class="form-section__title">Initial password</legend>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label" asp-for="Create.InitialPassword">Initial password *</label>
                                <input class="form-control" asp-for="Create.InitialPassword" type="password" required aria-required="true" autocomplete="new-password" data-password-new aria-describedby="create-password-rules" />
                                @if (Model.PasswordPolicy is { } createPolicy)
                                {
                                    @await Html.PartialAsync("_PasswordRules", (createPolicy, "create-password-rules"))
                                }
                                else
                                {
                                    <span class="field-hint">@UserEditModel.PasswordPolicyText</span>
                                }
                            </div>
                            <div class="form-group">
                                <label class="form-label" asp-for="Create.ConfirmPassword">Confirm password *</label>
                                <input class="form-control" asp-for="Create.ConfirmPassword" type="password" required aria-required="true" autocomplete="new-password" data-password-confirm aria-describedby="create-password-match" />
                                <span class="field-hint" id="create-password-match" data-password-match aria-live="polite">Both entries must match.</span>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="form-section">
                        <legend class="form-section__title">Access</legend>
                        <fieldset class="form-group">
                            <legend class="form-label">Roles</legend>
                            <div class="checkbox-grid">
                                @foreach (var role in Model.Roles)
                                {
                                    <label class="checkbox-field" title="@role.Description">
                                        <input type="checkbox" name="Create.Roles" value="@role.RoleName" />
                                        @role.RoleName
                                    </label>
                                }
                            </div>
                            <span class="field-hint">Roles are the fixed TigerCS role set. A user without a role can sign in but see nothing.</span>
                        </fieldset>
                        <label class="checkbox-field">
                            <input type="checkbox" asp-for="Create.IsGeynessStaff" />
                            Geyness staff
                        </label>
                    </fieldset>

                    <div class="form-actions form-actions--sticky">
                        <a class="btn" href="/Admin/Users">Cancel</a>
                        <button type="submit" class="btn btn-gold">Create User</button>
                    </div>
                </form>
            </section>

            <aside class="admin-side">
                <section class="panel panel--muted">
                    <div class="panel__header"><h2 class="panel__title">Good to know</h2></div>
                    <div class="panel__note panel__note--top">
                        <p>Users are never deleted. Once an account appears in ticket history it can only be deactivated, so its name stays valid on past tickets.</p>
                        <p>Department membership and the primary department can be changed at any time from the user's page.</p>
                    </div>
                </section>
            </aside>
        </div>
    }
    else if (u is null)
    {
        <div class="panel">
            <div class="error-state">
                @await Html.PartialAsync("_AdminIcon", "warning")
                <p>@(Model.LoadError ?? "The user could not be loaded.")</p>
            </div>
        </div>
    }
    else
    {
        <header class="admin-head">
            <div class="admin-head__main">
                @await Html.PartialAsync("_AdminEyebrow", module.Key)
                <div class="admin-head__identity">
                    <span class="identity__avatar identity__avatar--lg @(u.IsActive ? "" : "identity__avatar--muted")" aria-hidden="true">@AdminDisplay.Initials(u.DisplayName)</span>
                    <div>
                        <h1 class="page-title">@u.DisplayName</h1>
                        <div class="page-title__meta">
                            <span><strong>@u.UserName</strong></span>
                            @if (!string.IsNullOrEmpty(u.Email))
                            {
                                <span>@u.Email</span>
                            }
                            @await Html.PartialAsync("_StatusBadge", u.IsActive)
                            @if (!u.IsActive && u.DeactivatedAtUtc is { } deactivated)
                            {
                                <span>since @deactivated.ToLocalTime().ToString("MMM d, yyyy")</span>
                            }
                            @if (u.IsLockedOut)
                            {
                                <span class="status-note" title="Sign-in is blocked until the lock-out expires or is cleared">
                                    @await Html.PartialAsync("_AdminIcon", "lock") Sign-in locked
                                </span>
                            }
                            @if (u.IsGeynessStaff)
                            {
                                <span class="badge badge-neutral">Geyness staff</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="admin-head__actions">
                <a class="btn" href="/Admin/Users/@u.EmployeeId/Permissions">@await Html.PartialAsync("_AdminIcon", "shield") Manage Permissions</a>
                <a class="btn" href="/Admin/Users">Back to Users</a>
            </div>
        </header>

        @await Html.PartialAsync("_AdminMessages", Model)

        <div class="admin-grid">
            <section class="panel panel--tone admin-form-panel" aria-labelledby="profile-title">
                <div class="panel__header"><h2 class="panel__title" id="profile-title">Profile</h2></div>
                <form method="post" asp-page-handler="Profile" asp-route-id="@u.EmployeeId" class="admin-form">
                    <fieldset class="form-section">
                        <legend class="form-section__title">Identity</legend>
                        <div class="form-group">
                            <label class="form-label" asp-for="Profile.DisplayName">Display name *</label>
                            <input class="form-control" asp-for="Profile.DisplayName" required aria-required="true" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="Profile.Email">E-mail</label>
                            <input class="form-control" asp-for="Profile.Email" type="email" />
                        </div>
                        <label class="checkbox-field">
                            <input type="checkbox" asp-for="Profile.IsGeynessStaff" />
                            Geyness staff
                        </label>
                    </fieldset>
                    <div class="form-actions"><button type="submit" class="btn btn-gold btn-sm">Save Profile</button></div>
                </form>
            </section>

            <section class="panel panel--tone admin-form-panel" aria-labelledby="roles-title">
                <div class="panel__header">
                    <h2 class="panel__title" id="roles-title">Roles <span class="panel__count">@u.Roles.Count</span></h2>
                    <span class="panel__hint">What this account may see and do</span>
                </div>
                <form method="post" asp-page-handler="Roles" asp-route-id="@u.EmployeeId" class="admin-form">
                    <div class="checkbox-grid">
                        @foreach (var role in Model.Roles)
                        {
                            <label class="checkbox-field" title="@role.Description">
                                <input type="checkbox" name="RolesForm.Roles" value="@role.RoleName" checked="@(u.Roles.Contains(role.RoleName) ? "checked" : null)" />
                                @role.RoleName
                            </label>
                        }
                    </div>
                    <p class="field-hint">Roles are the fixed TigerCS role set. The last active System Administrator cannot lose the role.</p>
                    <div class="form-actions"><button type="submit" class="btn btn-gold btn-sm">Save Roles</button></div>
                </form>
            </section>

            <section class="panel admin-form-panel admin-grid__wide" aria-labelledby="departments-title">
                <div class="panel__header">
                    <h2 class="panel__title" id="departments-title">Departments <span class="panel__count">@u.Departments.Count</span></h2>
                    <span class="panel__hint">Where this user belongs and can view tickets, and receives assignments</span>
                </div>
                @if (u.Departments.Count == 0)
                {
                    <div class="empty-state">
                        @await Html.PartialAsync("_AdminIcon", "departments")
                        <p class="empty-state__title">Not a member of any department</p>
                        <p>Add a department below so this user can receive assignments.</p>
                    </div>
                }
                else
                {
                    <div class="table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Department</th>
                                    <th>Membership</th>
                                    <th class="col-actions"><span class="visually-hidden">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in u.Departments.OrderByDescending(d => d.IsPrimary))
                                {
                                    <tr>
                                        <td class="cell-primary"><a href="/Admin/Departments/@d.DepartmentId">@d.Name</a></td>
                                        <td>@if (d.IsPrimary) { <span class="badge badge-version-published"><span class="badge-dot"></span>Primary</span> } else { <span class="badge badge-neutral">Additional</span> }</td>
                                        <td class="col-actions">
                                            <form method="post" asp-page-handler="RemoveDepartment" asp-route-id="@u.EmployeeId" asp-route-departmentId="@d.DepartmentId" data-confirm="Remove @u.DisplayName from @d.Name?">
                                                <button type="submit" class="btn btn-sm btn-critical">Remove</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <form method="post" asp-page-handler="AddDepartment" asp-route-id="@u.EmployeeId" class="admin-form admin-form--inline">
                    <div class="form-group">
                        <label class="form-label" asp-for="Membership.DepartmentId">Add to department</label>
                        <select class="form-control" asp-for="Membership.DepartmentId">
                            @foreach (var d in Model.ActiveDepartments.Where(d => u.Departments.All(m => m.DepartmentId != d.DepartmentId)))
                            {
                                <option value="@d.DepartmentId">@d.Name</option>
                            }
                        </select>
                    </div>
                    <label class="checkbox-field">
                        <input type="checkbox" asp-for="Membership.IsPrimary" />
                        Make primary
                    </label>
                    <button type="submit" class="btn btn-sm" disabled="@(u.IsActive ? null : "disabled")">Add</button>
                </form>
                @if (!u.IsActive)
                {
                    <p class="panel__note">Reactivate the user before changing department membership.</p>
                }
                @* Accessible Departments: the whole set at once. These are the user's department memberships, the same rows that decide which
                   departments' tickets they can see and filter by, so nothing is stored twice. The primary department is fixed here: it is
                   listed but locked, and the Api keeps it whatever is posted. *@
                @{
                    var primaryDepartment = u.Departments.FirstOrDefault(d => d.IsPrimary);
                    var held = u.Departments.Select(d => d.DepartmentId).ToHashSet();
                    var choosable = Model.ActiveDepartments.Where(d => primaryDepartment is null || d.DepartmentId != primaryDepartment.DepartmentId).OrderBy(d => d.Name, StringComparer.OrdinalIgnoreCase).ToList();
                }
                <form method="post" asp-page-handler="AccessibleDepartments" asp-route-id="@u.EmployeeId" class="admin-form" data-accessible-departments>
                    <div class="form-group">
                        <label class="form-label" for="accessible-search">Accessible Departments</label>
                        <input type="search" id="accessible-search" class="form-control" placeholder="Search departments" autocomplete="off" data-ad-search />
                        <div class="ad-list" role="group" aria-label="Accessible Departments" data-ad-list>
                            @if (primaryDepartment is not null)
                            {
                                <label class="ad-option ad-option--primary"><input type="checkbox" checked disabled /> <span>@primaryDepartment.Name</span> <span class="badge badge-version-published"><span class="badge-dot"></span>Primary</span></label>
                            }
                            @foreach (var d in choosable)
                            {
                                <label class="ad-option"><input type="checkbox" name="AccessibleDepartments.DepartmentIds" value="@d.DepartmentId" checked="@held.Contains(d.DepartmentId)" disabled="@(!u.IsActive && !held.Contains(d.DepartmentId))" /> <span>@d.Name</span></label>
                            }
                            <p class="ad-empty" data-ad-empty hidden>No department matches your search.</p>
                        </div>
                        <span class="field-hint">Tick every department this user may access besides their primary one. Access follows membership: the user sees and filters tickets of these departments, and can be assigned work there.</span>
                    </div>
                    <button type="submit" class="btn btn-sm" disabled="@(u.IsActive ? null : "disabled")">Save accessible departments</button>
                </form>
                <script src="~/js/admin-accessible-departments.js" asp-append-version="true"></script>
            </section>

            <section class="panel admin-form-panel admin-grid__wide" aria-labelledby="transfer-departments-title">
                <div class="panel__header">
                    <h2 class="panel__title" id="transfer-departments-title">Transfer destinations <span class="panel__count">@Model.TransferDepartmentIds.Count</span></h2>
                    <span class="panel__hint">Departments this user may transfer tickets to</span>
                </div>
                <div class="panel__note panel__note--top">
                    <p>This list is separate from the departments above: belonging to or viewing a department never lets the user transfer tickets to it, and a destination here does not add them to that department. Whether the user may reassign tickets is a permission of its own (<a href="/Admin/Users/@u.EmployeeId/Permissions">Manage Permissions → Assign tickets</a>).</p>
                    <p>With no destination ticked, this user's transfers follow their role exactly as before. With one or more ticked, they can transfer only to those.</p>
                </div>
                <form method="post" asp-page-handler="TransferDepartments" asp-route-id="@u.EmployeeId" class="admin-form">
                    <div class="form-group">
                        @foreach (var d in Model.ActiveDepartments.OrderBy(d => d.Name, StringComparer.OrdinalIgnoreCase))
                        {
                            <label class="checkbox-field">
                                <input type="checkbox" name="TransferDepartments.DepartmentIds" value="@d.DepartmentId" checked="@(Model.TransferDepartmentIds.Contains(d.DepartmentId) ? "checked" : null)" />
                                @d.Name
                            </label>
                        }
                    </div>
                    <div class="form-actions"><button type="submit" class="btn btn-gold btn-sm">Save transfer destinations</button></div>
                </form>
            </section>

            <section class="panel panel--tone admin-form-panel admin-grid__wide" aria-labelledby="reset-password-title">
                <div class="panel__header">
                    <h2 class="panel__title" id="reset-password-title">Reset password</h2>
                    <span class="panel__hint">For a user who has forgotten theirs or is locked out</span>
                </div>
                <div class="panel__note panel__note--top">
                    <p>Replaces the password without knowing the old one. The user is signed out everywhere and any sign-in lock is lifted, so they can sign in with the new password straight away. The password is never recorded; the reason is.</p>
                </div>
                <form method="post" asp-page-handler="ResetPassword" asp-route-id="@u.EmployeeId" class="admin-form" autocomplete="off" data-password-form>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" asp-for="ResetPassword.NewPassword">New password *</label>
                            <input class="form-control" asp-for="ResetPassword.NewPassword" type="password" required aria-required="true" autocomplete="new-password" data-password-new aria-describedby="reset-password-rules" />
                            @if (Model.PasswordPolicy is { } policy)
                            {
                                @await Html.PartialAsync("_PasswordRules", (policy, "reset-password-rules"))
                            }
                            else
                            {
                                <span class="field-hint">@UserEditModel.PasswordPolicyText</span>
                            }
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="ResetPassword.ConfirmPassword">Confirm new password *</label>
                            <input class="form-control" asp-for="ResetPassword.ConfirmPassword" type="password" required aria-required="true" autocomplete="new-password" data-password-confirm aria-describedby="reset-password-match" />
                            <span class="field-hint" id="reset-password-match" data-password-match aria-live="polite">Both entries must match.</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" asp-for="ResetPassword.Reason">Reason</label>
                        <input class="form-control" asp-for="ResetPassword.Reason" placeholder="Optional — recorded in the audit trail" />
                    </div>
                    <div class="form-actions"><button type="submit" class="btn btn-gold btn-sm">Reset Password</button></div>
                </form>
            </section>

            <section class="panel admin-form-panel @(u.IsActive ? "panel--danger" : "") admin-grid__wide" aria-labelledby="status-title">
                <div class="panel__header"><h2 class="panel__title" id="status-title">@(u.IsActive ? "Deactivate user" : "Reactivate user")</h2></div>
                <div class="panel__note panel__note--top">
                    @if (u.IsActive)
                    {
                        <p>A deactivated user can no longer sign in or receive new assignments. Their ticket history is kept as-is.</p>
                    }
                    else
                    {
                        <p>Reactivating restores sign-in and makes the user available for assignments again.</p>
                    }
                    @if (u.HasHistory)
                    {
                        <p>This user appears in ticket history (assignments, approvals or audit), so the account can be deactivated but never deleted.</p>
                    }
                </div>
                <form method="post" asp-page-handler="Activation" asp-route-id="@u.EmployeeId" class="admin-form"
                      data-confirm="@(u.IsActive ? $"Deactivate {u.DisplayName}? They will no longer be able to sign in or receive new assignments." : null)">
                    <input type="hidden" asp-for="Activation.IsActive" value="@(u.IsActive ? "false" : "true")" />
                    @if (u.IsActive)
                    {
                        <div class="form-group">
                            <label class="form-label" asp-for="Activation.Reason">Reason</label>
                            <input class="form-control" asp-for="Activation.Reason" placeholder="Optional — recorded in the audit trail" />
                        </div>
                        <div class="form-actions"><button type="submit" class="btn btn-critical btn-sm">Deactivate User</button></div>
                    }
                    else
                    {
                        <div class="form-actions"><button type="submit" class="btn btn-gold btn-sm">Reactivate User</button></div>
                    }
                </form>
            </section>
        </div>
    }
</div>
